@code {
	[Inject] private UrlSigningService urlSigningService { get; set; } = null!;

	private ItemKullaniciTip kullaniciTip = new ItemKullaniciTip();
	private List<ItemGorev> kullaniciGorevler = new();
	private List<ItemGorev> kritikGorevler = new();
	private List<ItemGorev> GorevListt = new();
	private List<ItemGorev> adminGorevleri = new();
	private List<User> kullaniciListesi = new();
	private bool IsLoading = true;
	private int? currentUserId = null;
	ItemGorev? SeciliGorev;
	int? gorevId;

	private IEnumerable<ItemGorev> TumGorevler => GorevListt.Where(g => g.DelUser == 0).GroupBy(g => new { g.BaslangicTarihi, g.Baslik }).Select(x => x.First());
	private IEnumerable<ItemGorev> aktifGorevler => GorevListt.Where(g => g.Aktif && !g.Tamamlandi && (!g.BitisTarihi.HasValue || g.BitisTarihi.Value >= DateTime.Today));
	private IEnumerable<ItemGorev> yaklasanGorevler => aktifGorevler.Where(g => g.BitisTarihi.HasValue && (g.BitisTarihi.Value - DateTime.Now).TotalDays > 0 && (g.BitisTarihi.Value - DateTime.Now).TotalDays <= 7).GroupBy(g => new { g.BaslangicTarihi, g.Baslik }).Select(x => x.First());
	private IEnumerable<ItemGorev> tamamlananGorevler => GorevListt.Where(g => g.Tamamlandi).GroupBy(g => new { g.BaslangicTarihi, g.Baslik }).Select(x => x.First());
	private IEnumerable<ItemGorev> gecmisGorevler => GorevListt.Where(g => g.BitisTarihi.HasValue && g.BitisTarihi.Value < DateTime.Now && !g.Tamamlandi);
	private IEnumerable<ItemGorev> pasifGorevler => GorevListt.Where(g => !g.Aktif && !g.Tamamlandi && (!g.BitisTarihi.HasValue || g.BitisTarihi.Value >= DateTime.Today)).GroupBy(g => new { g.BaslangicTarihi, g.Baslik }).Select(x => x.First());
	private IEnumerable<ItemGorev> yuksekOnemliGorevler => aktifGorevler.Where(g => g.OnemDerecesi?.ToLower() == "yüksek").OrderBy(g => g.BitisTarihi).GroupBy(g => new { g.BaslangicTarihi, g.Baslik }).Select(x => x.First());

	private IEnumerable<ItemGorev> BugunkuGorevler => GorevListt.Where(g => g.Aktif && !g.Tamamlandi && g.CreDate.Date == DateTime.Today).GroupBy(g => new { g.BaslangicTarihi, g.Baslik }).Select(x => x.First());
	private IEnumerable<ItemGorev> SAktifGorevler => GorevListt.Where(g => (g.Kullanici_ID == currentUserId || !g.Kilitli) && g.Aktif && !g.Tamamlandi && (!g.BitisTarihi.HasValue || g.BitisTarihi.Value >= DateTime.Today)).GroupBy(g => new { g.BaslangicTarihi, g.Baslik }).Select(x => x.First());
	private IEnumerable<ItemGorev> SYaklasanGorevler => GorevListt.Where(g => g.BitisTarihi.HasValue && !g.Kilitli && g.Aktif && (g.BitisTarihi.Value - DateTime.Now).TotalDays > 0 && g.DelUser == 0 && (g.BitisTarihi.Value - DateTime.Now).TotalDays <= 7).GroupBy(g => new { g.BaslangicTarihi, g.Baslik }).Select(x => x.First());
	private IEnumerable<ItemGorev> STamamlananGorevler =>GorevListt.Where(g => g.Tamamlandi && g.DelUser == 0 && (!g.Kilitli || g.Kullanici_ID == currentUserId));
	private IEnumerable<ItemGorev> SGecmisGorevler => GorevListt.Where(g => g.BitisTarihi.HasValue && g.BitisTarihi.Value < DateTime.Now && !g.Tamamlandi);
	private IEnumerable<ItemGorev> SPasifGorevler => GorevListt.Where(g => !g.Aktif && !g.Tamamlandi && (!g.BitisTarihi.HasValue || g.BitisTarihi.Value >= DateTime.Today)).GroupBy(g => new { g.BaslangicTarihi, g.Baslik }).Select(x => x.First());
	private IEnumerable<ItemGorev> SizeOzelGorevler => GorevListt.Where(g => g.Kullanici_ID == currentUserId && g.Kilitli && !g.Tamamlandi && g.Aktif).GroupBy(g => new { g.BaslangicTarihi, g.Baslik }).Select(x => x.First());
	private IEnumerable<ItemGorev> STumGorevler => GorevListt.Where(g => (g.Kullanici_ID == currentUserId || !g.Kilitli) && g.DelUser == 0).GroupBy(g => new { g.BaslangicTarihi, g.Baslik }).Select(x => x.First());

	class GorevDurum
	{
		public string Category { get; set; } = string.Empty;
		public double Value { get; set; }
	}
	private List<GorevDurum> GorevDurumData = new();
	private bool _isInitialized = false;
	private bool showYeniGorevBildirimi = false;
	private int yeniGorevSayisi = 0;
	private int yeniGenelGorevSayisi = 0;
	private int yeniOzelGorevSayisi = 0;
	private int gosterilecekOzelGorevSayisi = 0;
	private int gosterilecekGenelGorevSayisi = 0;
	private bool ozelGorevBildirimiGoruldu = false;
	private bool genelGorevBildirimiGoruldu = false;
	private DateTime selectedMonth = DateTime.Now;

	//sayfa ilk kez ekrana çizildikten sonra dashboard verilerini yüklemek için kullanılır.
	protected override async Task OnAfterRenderAsync(bool firstRender)
	{
		if (firstRender && !_isInitialized)
		{
			_isInitialized = true;
			await LoadDashboardAsync();
		}
	}

	//Dashboard açılırken gereken tüm veriyi yükleyen ve ekranı hazırlayan ana yükleme sürecidir.
	private async Task LoadDashboardAsync()
	{
		IsLoading = true;
		showYeniGorevBildirimi = false;
		StateHasChanged();
		kullaniciListesi = await _kullaniciRepo.GetAllAsync();
		var uri = NavigationManager.ToAbsoluteUri(NavigationManager.Uri);
		var queryParams = Microsoft.AspNetCore.WebUtilities.QueryHelpers.ParseQuery(uri.Query);

		Dictionary<string, string> urlParameters = new();
		if (queryParams.ContainsKey("token"))
		{
			var isValid = urlSigningService.VerifyUrl(NavigationManager.Uri);
			if (!isValid)
			{
				notificationService.Notify(NotificationSeverity.Error, "Hata", "Geçersiz veya değiştirilmiş link!");
				NavigationManager.NavigateTo("/dashboard", forceLoad: true);
				return;
			}

			urlParameters = urlSigningService.ParseSignedUrl(NavigationManager.Uri, out bool valid);
			if (!valid)
			{
				notificationService.Notify(NotificationSeverity.Error, "Hata", "Geçersiz link!");
				NavigationManager.NavigateTo("/dashboard", forceLoad: true);
				return;
			}
		}

		var hedefUserIdParam = urlParameters.ContainsKey("userId") ? urlParameters["userId"] : null;

		await YukleKullaniciId();

		if (!string.IsNullOrEmpty(hedefUserIdParam) && int.TryParse(hedefUserIdParam, out int hedefUserId))
		{
			if (!currentUserId.HasValue || currentUserId.Value != hedefUserId)
			{
				if (currentUserId.HasValue)
				{
					await girisSaglayici.CikisYapAsync();
					await PermissionService.RefreshAsync();
				}

				var returnUrl = NavigationManager.Uri;
				NavigationManager.NavigateTo($"/GirisYap?returnUrl={Uri.EscapeDataString(returnUrl)}", forceLoad: true);
				return;
			}
		}

		if (!currentUserId.HasValue)
		{
			NavigationManager.NavigateTo("/GirisYap", forceLoad: false);
			return;
		}

		kullaniciTip = await _kullaniciTipRepository.GetKullaniciTipByKullaniciIDAsync(currentUserId.Value);
		if (kullaniciTip == null)
		{
			notificationService.Notify(NotificationSeverity.Warning, "Uyarı", "Kullanıcı tipi bulunamadı.");
			IsLoading = false;
			StateHasChanged();
			return;
		}

		// Görevler sayfası ortak sayfa olduğu için (admin hariç tüm tipler görebilir)
		// dashboard'da da görev verileri gösterilir. Yetki kontrolü yapılmaz.
		await YukleGorevler();

		if (kullaniciTip.Adi == "Standart")
		{
			kullaniciGorevler = GorevListt
				.Where(x => (x.Kullanici_ID == currentUserId || !x.Kilitli) && x.Aktif)
				.GroupBy(g => new { g.BaslangicTarihi, g.Baslik }).Select(x => x.First())
				.ToList();
		}
		else
		{
			kullaniciGorevler = GorevListt.GroupBy(g => new { g.BaslangicTarihi, g.Baslik }).Select(x => x.First()).ToList();
		}

		HazirlaDashboardVerileri();

		if (kullaniciTip?.Adi == "Admin")
		{
			kritikGorevler = GorevListt
				.Where(g => g.OnemDerecesi?.ToLower() == "yüksek"
							&& g.Aktif
							&& !g.Tamamlandi).GroupBy(g => new { g.BaslangicTarihi, g.Baslik }).Select(x => x.First())
				.ToList();
		}
		else if (kullaniciTip?.Adi == "Standart")
		{
			kritikGorevler = GorevListt
				.Where(g => g.OnemDerecesi?.ToLower() == "yüksek"
							&& g.Aktif
							&& !g.Tamamlandi
							&& (!g.Kilitli || g.Kullanici_ID == currentUserId)).GroupBy(g => new { g.BaslangicTarihi, g.Baslik }).Select(x => x.First())
				.ToList();
		}
		else
		{
			kritikGorevler = new List<ItemGorev>();
		}

		IsLoading = false;
		await InvokeAsync(StateHasChanged);

		await KontrolEtYeniGorevler();
		await InvokeAsync(StateHasChanged); 
	}

	//kullanıcı için yeni görev bildirimi gösterilip gösterilmeyeceğini kontrol eden metottur.
	private async Task KontrolEtYeniGorevler()
	{
		try
		{
			if (!currentUserId.HasValue)
			{
				return;
			}

			var ozelBildirimGoruldu = await Js.InvokeAsync<string>("localStorage.getItem", $"yeniGorevBildirimiGoruldu_Ozel_{currentUserId.Value}");
			var genelBildirimGoruldu = await Js.InvokeAsync<string>("localStorage.getItem", $"yeniGorevBildirimiGoruldu_Genel_{currentUserId.Value}");

			ozelGorevBildirimiGoruldu = ozelBildirimGoruldu == "true";
			genelGorevBildirimiGoruldu = genelBildirimGoruldu == "true";

			var sonGirisTarihi = await DataService.GetSonGirisAsync(currentUserId.Value);

			yeniGenelGorevSayisi = await DataService.GetYeniGorevDetaylariGenel(currentUserId.Value, sonGirisTarihi);
			yeniOzelGorevSayisi = await DataService.GetYeniGorevDetaylariOzel(currentUserId.Value, sonGirisTarihi);
			yeniGorevSayisi = yeniGenelGorevSayisi + yeniOzelGorevSayisi;

			gosterilecekOzelGorevSayisi = ozelGorevBildirimiGoruldu ? 0 : yeniOzelGorevSayisi;
			gosterilecekGenelGorevSayisi = genelGorevBildirimiGoruldu ? 0 : yeniGenelGorevSayisi;

			if (gosterilecekOzelGorevSayisi > 0 || gosterilecekGenelGorevSayisi > 0)
			{
				showYeniGorevBildirimi = true;
			}
			else
			{
				showYeniGorevBildirimi = false;
			}
		}
		catch (Exception ex)
		{
			
		}
	}

