	//Takvim Günlerini oluşturan metot.
	private List<DateTime> GetCalendarDays()
	{
		var days = new List<DateTime>();
		var firstDayOfMonth = new DateTime(selectedMonth.Year, selectedMonth.Month, 1);
		var lastDayOfMonth = firstDayOfMonth.AddMonths(1).AddDays(-1);

		var startDayOfWeek = (int)firstDayOfMonth.DayOfWeek;
		startDayOfWeek = startDayOfWeek == 0 ? 6 : startDayOfWeek - 1;

		for (int i = 0; i < startDayOfWeek; i++)
		{
			days.Add(firstDayOfMonth.AddDays(-(startDayOfWeek - i)));
		}

		for (var day = firstDayOfMonth; day <= lastDayOfMonth; day = day.AddDays(1))
		{
			days.Add(day);
		}

		var remainingDays = 42 - days.Count;
		for (int i = 1; i <= remainingDays; i++)
		{
			days.Add(lastDayOfMonth.AddDays(i));
		}

		return days;
	}

	//Takvimde her tarih için gösterilen görevler metodu.
	private IEnumerable<ItemGorev> GetGorevlerForDate(DateTime date)
	{
		if (GorevListt == null || !GorevListt.Any())
			return Enumerable.Empty<ItemGorev>();

		var tarihFiltreli = GorevListt
		.Where(g => g.Aktif) 
		.Where(g =>
			(g.BitisTarihi.HasValue && g.BitisTarihi.Value.Date == date.Date) ||
			(g.BaslangicTarihi.HasValue && g.BaslangicTarihi.Value.Date == date.Date));
		var tekil = tarihFiltreli
			.GroupBy(g => new
			{
				Gun = (g.BitisTarihi ?? g.BaslangicTarihi)?.Date,
				g.Baslik,
				g.Kullanici_ID
			})
			.Select(x => x.First());

		if (!currentUserId.HasValue)
			return Enumerable.Empty<ItemGorev>();

		if (kullaniciTip?.Adi == "Standart")
		{
			return tekil.Where(g =>
				!g.Kilitli ||
				g.Kullanici_ID == currentUserId.Value
			);
		}

		if (kullaniciTip?.Adi == "Admin")
		{
			return tekil.Where(g =>
				!g.Kilitli ||
				g.Kullanici_ID == currentUserId.Value
			);
		}
		return Enumerable.Empty<ItemGorev>();
	}

	//Takvim tarihinde her bir görevin önemine yada süresine göre renk verilen metot.
	private string GetGorevRengi(ItemGorev gorev)
	{
		if (gorev.BitisTarihi.HasValue &&
			gorev.BitisTarihi.Value < DateTime.Now &&
			!gorev.Tamamlandi)
			return "#f1b0b7";

		var onem = gorev.OnemDerecesi?.Trim().ToLower();

		if (onem == "yüksek")
			return "#e74c3c";

		if (onem == "orta")
			return "#f39c12";

		if (onem == "düşük")
			return "#4caf50";
		if (currentUserId.HasValue &&
			gorev.Kullanici_ID == currentUserId.Value)
			return "#8e44ad";

		return "#3498db";
	}

