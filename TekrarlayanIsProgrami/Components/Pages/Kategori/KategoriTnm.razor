@layout MainLayout
@attribute [Authorize]
@if (IsEdit)
{
	<RadzenCard Style="padding:20px;">
		<RadzenTemplateForm TItem="ItemKategori" Data="@ItemData" Submit="@OnSubmit">
			<ChildContent>
				<DataAnnotationsValidator></DataAnnotationsValidator>
				<h3 style="text-align:center;">Kategori Düzenle </h3>
				<RadzenFormField Text="Kategori Adı" Style="width:100%; margin-top:15px;">
					<RadzenTextBox @bind-Value="ItemData.Adi" Name="Adi" Change =" ()=> degisiklikYapildiMi = true" ></RadzenTextBox>
				</RadzenFormField>
				<ValidationMessage For="@(()=>ItemData.Adi)"></ValidationMessage>

				<div class="btn-group">
					<RadzenButton Text="Kaydet" Icon="save" Style="width:30%; margin:auto;"class="radzen-buttonKaydet" ButtonType="ButtonType.Submit"></RadzenButton>
					<RadzenButton Text="İptal" Icon="cancel" Click="@Iptal" Style="width:30%;margin:auto;" class="radzen-buttonIptal" ButtonType="ButtonType.Button"></RadzenButton>
				</div>
			</ChildContent>
		</RadzenTemplateForm>
	</RadzenCard>
}
else
{
	<RadzenCard Style="padding:20px;">
		<RadzenTemplateForm TItem="ItemKategori" Data="@ItemData" Submit="@OnSubmit">
			<ChildContent>
				<DataAnnotationsValidator></DataAnnotationsValidator>
				<h3 style="text-align:center;">Kategori Ekle </h3>
				<RadzenFormField Text="Kategori Adı" Style="width:100%; margin-top:15px;">
					<RadzenTextBox @bind-Value="ItemData.Adi"></RadzenTextBox>
				</RadzenFormField>
				<ValidationMessage For="@(() => ItemData.Adi)"></ValidationMessage>

				<div class="btn-group">
					<RadzenButton Text="Kaydet" Icon="save" Style="width:30%; margin:auto;" class="radzen-buttonKaydet" ButtonType="ButtonType.Submit"></RadzenButton>
					<RadzenButton Text="İptal" Icon="cancel" Click="@Iptal" Style="width:30%;margin:auto;" class="radzen-buttonIptal" ButtonType="ButtonType.Button"></RadzenButton>
				</div>
			</ChildContent>
		</RadzenTemplateForm>
	</RadzenCard>
}

@code {
	[Parameter] public ItemKategori ItemData { get; set; } = new();

	private string ErrorMessage = string.Empty;
	private bool IsEdit;
	private bool isProcessing = false;
	private bool degisiklikYapildiMi = false;
	private ItemKategori Kategoriler = new();
	private string originalKategori;

	protected override void OnInitialized()
	{
		// IsEdit durumu form ilk açıldığında sabitleniyor (sonradan değişmez)
		IsEdit = ItemData.ID != 0;
		originalKategori = ItemData.Adi;
	}

	private async Task OnSubmit(ItemKategori item)
	{
		if (isProcessing)
			return; // ikinci tıklamayı engelle

		isProcessing = true;
		ErrorMessage = string.Empty;

		try
		{
			// Kullanıcı bilgileri (örnek olarak statik)
			item.DelUser = 0;
			item.CreUser = IsEdit ? 0 : 1;
			item.UpdUser = IsEdit ? 1 : 0;

			// Veritabanı işlemi
			var wsCvp = await Task.Run(() => DataService.SetKategori(item));
			Console.WriteLine($"SonucKodu: {wsCvp.SonucKodu}, Data: {wsCvp.Data}");

			if (wsCvp.SonucKodu == 0 && wsCvp.Data > 0)
			{
				if (!IsEdit)
					item.ID = wsCvp.Data; // yeni eklenen kaydın ID'si

				notificationService.Notify(
					NotificationSeverity.Success,
					"Başarılı",
					IsEdit ? "Kategori güncellendi!" : "Kategori eklendi!"
				);

				await Task.Delay(100);
				DialogService.Close(item);
				StateHasChanged();			
			}
			else
			{
				await DialogService.Alert(
					$"Hata Oluştu. SonucKodu: {wsCvp.SonucKodu}, Data: {wsCvp.Data}"
				);
			}
		}
		catch (Exception ex)
		{
			ErrorMessage = $"Hata Oluştu: {ex.Message}";
			notificationService.Notify(NotificationSeverity.Error, "Hata", ErrorMessage);
		}
		finally
		{
			isProcessing = true; // her durumda form yeniden aktif olur
		}
	}

	private async Task Iptal()
	{
		if (IsEdit)
		{
			if (degisiklikYapildiMi)
			{
				bool? onay = await DialogService.Confirm(
					"Yaptığınız değişiklikler kaybolacak. Devam etmek istiyor musunuz?",
					"İptal Onayı",
					new ConfirmOptions
						{
							OkButtonText = "Evet",
							CancelButtonText = "Hayır"
						});

				if (onay != true)
					return;
				notificationService.Notify(NotificationSeverity.Info, "Bilgi", "Düzenleme İşleminiz İptal Edildi.");
				// Değişiklikleri geri al
				ItemData.Adi = originalKategori;
			}
			else
			{
				notificationService.Notify(NotificationSeverity.Info, "Bilgi", "Düzenleme İşleminiz İptal Edildi.");
				NavigationManager.NavigateTo("/kategori");
			}
		}
		else
		{
			notificationService.Notify(NotificationSeverity.Info, "Bilgi", "Düzenleme İşleminiz İptal Edildi.");
			NavigationManager.NavigateTo("/kategori");

		}
		DialogService.Close();
	}

}
