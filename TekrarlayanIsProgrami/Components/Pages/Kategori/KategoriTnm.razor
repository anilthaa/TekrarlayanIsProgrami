@layout MainLayout
@attribute [Authorize]

	<RadzenCard Style="padding:20px;">
		<RadzenTemplateForm TItem="ItemKategori" Data="@ItemData" Submit="@OnSubmit">
			<ChildContent>
				<DataAnnotationsValidator></DataAnnotationsValidator>
				<h3 style="text-align:center;">@(IsEdit? "Kategori Düzenle" : "Kategori Ekle") </h3>
				<RadzenFormField Text="Kategori Adı" Style="width:100%; margin-top:15px;">
					<RadzenTextBox @bind-Value="ItemData.Adi" Name="Adi" Change =" ()=> degisiklikYapildiMi = true" ></RadzenTextBox>
				</RadzenFormField>
				<ValidationMessage For="@(()=>ItemData.Adi)"></ValidationMessage>

				<div class="btn-group">
					<RadzenButton Text="@(IsEdit? "Güncelle" : "Kaydet")" Icon="save" Style="width:30%; margin:auto;"class="radzen-buttonKaydet" ButtonType="ButtonType.Submit"></RadzenButton>
					<RadzenButton Text="İptal" Icon="cancel" Click="@Iptal" Style="width:30%;margin:auto;" class="radzen-buttonIptal" ButtonType="ButtonType.Button"></RadzenButton>
				</div>
			</ChildContent>
		</RadzenTemplateForm>
	</RadzenCard>
@code {
	[Parameter] public ItemKategori ItemData { get; set; } = new();
	private string ErrorMessage = string.Empty;
	bool IsEdit =>ItemData.ID >0;
	private bool isProcessing = false;
	private bool degisiklikYapildiMi = false;
	private string originalKategori;

	//kod, bileşen başlatıldığında çalışır ve şunları yapar:
	protected override void OnInitialized()
	{
		originalKategori = ItemData.Adi;
	}

	//kategori formunun submit  işlemini yapar:
	private async Task OnSubmit(ItemKategori item)
	{
		if (IsEdit==true)
		{
			if (isProcessing) return;

			isProcessing = true;
			ErrorMessage = string.Empty;

			try
			{
				item.DelUser = 0;
				item.CreUser = 0;
				item.UpdUser = 1; // güncelleyen kullanıcı ID

				var wsCvp = await Task.Run(() => DataService.SetKategori(item));

				if (wsCvp.SonucKodu == 0)
				{
					notificationService.Notify(NotificationSeverity.Success, "Başarılı", "Kategori güncellendi!");
					await Task.Delay(100);
					DialogService.Close(item);
					StateHasChanged();
				}
				else
				{
					await DialogService.Alert($"Hata Oluştu. SonucKodu: {wsCvp.SonucKodu}, Data: {wsCvp.Data}");
				}
			}
			catch (Exception ex)
			{
				ErrorMessage = $"Hata Oluştu: {ex.Message}";
				notificationService.Notify(NotificationSeverity.Error, "Hata", ErrorMessage);
			}
			finally
			{
				isProcessing = false;
			}
		}
		else
		{
			if (isProcessing) return;

			isProcessing = true;
			ErrorMessage = string.Empty;

			try
			{
				item.DelUser = 0;
				item.CreUser = 1; // yeni ekleyen kullanıcı ID
				item.UpdUser = 0;

				var wsCvp = await Task.Run(() => DataService.SetKategori(item));

				if (wsCvp.SonucKodu == 0 && wsCvp.Data > 0)
				{
					item.ID = wsCvp.Data; // eklenen kategori ID'sini ata

					notificationService.Notify(NotificationSeverity.Success, "Başarılı", "Kategori eklendi!");
					await Task.Delay(100);
					DialogService.Close(item);
					StateHasChanged();
				}
				else
				{
					await DialogService.Alert($"Hata Oluştu. SonucKodu: {wsCvp.SonucKodu}, Data: {wsCvp.Data}");
				}
			}
			catch (Exception ex)
			{
				ErrorMessage = $"Hata Oluştu: {ex.Message}";
				notificationService.Notify(NotificationSeverity.Error, "Hata", ErrorMessage);
			}
			finally
			{
				isProcessing = false;
			}
		}
	}

	//kategori formunda iptal işlemini yönetir:
	private async Task Iptal()
	{
		if (IsEdit)
		{
			if (degisiklikYapildiMi)
			{
				bool? onay = await DialogService.Confirm(
					"Yaptığınız değişiklikler kaybolacak. Devam etmek istiyor musunuz?",
					"İptal Onayı",
					new ConfirmOptions
					{
						OkButtonText = "Evet",
						CancelButtonText = "Hayır"
					});

				if (onay != true)
					return;
			}

			notificationService.Notify(
				NotificationSeverity.Info,
				"Bilgi",
				"Düzenleme işleminiz iptal edildi."
			);
		}
		else
		{
			notificationService.Notify(
				NotificationSeverity.Info,
				"Bilgi",
				"Ekleme işleminiz iptal edildi."
			);
		}

		DialogService.Close();
		NavigationManager.NavigateTo("/kategori");
	}
}
