@page "/GirisYap"
@inject KimlikDogrulama AuthProvider
@inject NavigationManager Navigation
@inject NotificationService NotificationService
@using TekrarlayanIsProgrami.Services



<RadzenCard Style="max-width:400px; margin:auto; margin-top:80px; padding:25px;">
	<h3 style="text-align:center; margin-bottom:20px;">🔑 Giriş Yap</h3>
	

	<RadzenTemplateForm TItem="LoginModel" Data="@GirisModeli" Submit="@OnLogin">
		<ChildContent>
			<RadzenLabel Text="E-posta" Component="Email" Style="font-weight:bold;"></RadzenLabel>
			<RadzenTextBox @bind-Value="GirisModeli.E_Posta" Name="E_Posta" Placeholder="E-posta adresinizi giriniz" Style="width:100%; margin-bottom:20px;"></RadzenTextBox>
			<RadzenLabel Text="Şifre" Component="Password" Style="font-weight:bold;"></RadzenLabel>
			<RadzenPassword @bind-Value="GirisModeli.Sifre" Name="Sifre" Placeholder="Şifrenizi Giriniz" Style="width:100%; margin-bottom:20px;"></RadzenPassword>
			
			
			<div style="text-align:center; margin-bottom:20px;">
				<a href="/SifreUnuttum" style="color:#e74c3c; text-decoration:none; font-size:0.9em;">Şifremi Unuttum</a>
			</div>

			<RadzenButton Text="Giriş Yap" ButtonType="ButtonType.Submit" Icon="login" Style="width:100%; background:#3498db; color:white;border:none; border-radius:8px; padding:10px;"></RadzenButton>

			<div style="text-align:center; margin-top:15px;">
				<a href="/KayitOl" style="color:#3498db; text-decoration:none; font-size:0.9em;">Hesabınız yok mu? Kayıt ol</a>
			</div>
		</ChildContent>
	</RadzenTemplateForm>
</RadzenCard>
@code {
	private LoginModel GirisModeli = new LoginModel();

	// RadzenLogin girisYap;

	async Task OnLogin(LoginModel model)
	{

		var result = await AuthProvider.GirisYapAsync(model.E_Posta, model.Sifre);

		if (result.Basarili)
		{
			NotificationService.Notify(NotificationSeverity.Success, "Hoşgeldiniz", result.Mesaj);
			Navigation.NavigateTo("/");
		}
		else
		{
			NotificationService.Notify(NotificationSeverity.Error, "Giriş Hatası", result.Mesaj);
		}


	}

	public class LoginModel
	{
		public string? E_Posta { get; set; }
		public string? Sifre { get; set; }
	}

}
