@page "/gorevler"
@layout MainLayout
@attribute [Authorize]



@if(kullaniciTip.Adi=="Admin")
{
<RadzenCard Style="margin:20px;">
	<h3 style="text-align:center;">Görev Listesi</h3>

	<RadzenButton Text="Yeni Görev" Icon="add" Style=" background:mediumpurple; color:white" Click="@YeniGorev"></RadzenButton>

	@if (GorevListt == null || !GorevListt.Any())
	{
		<p>Veri yükleniyor... veya görev bulunamadı.</p>
	}
	else
		{

			<div class="my-tabs" style="margin-top:15px;">
				<div class="my-tab @(SelectedTabIndex == 0 ? "active" : "")"
					 @onclick="() => SelectedTabIndex = 0">
					Tüm Aktif Görevler
				</div>
				<div class="my-tab @(SelectedTabIndex == 1 ? "active" : "")"
					 @onclick="() => SelectedTabIndex = 1">
					Yaklaşan Görevler
				</div>
				<div class="my-tab @(SelectedTabIndex == 2 ? "active" : "")"
					 @onclick="() => SelectedTabIndex = 2">
					Tamamlanmış Görevler
				</div>
				<div class="my-tab @(SelectedTabIndex == 3 ? "active" : "")"
					 @onclick="() => SelectedTabIndex = 3">
					Süresi Dolanlar
				</div>
				<div class="my-tab @(SelectedTabIndex == 4 ? "active" : "")"
					 @onclick="() => SelectedTabIndex = 4">
					Pasif Görevler
				</div>
			</div>

		@if (!AktifListe.Any())
		{
			<div style="text-align:center; padding:50px;">
				<p style="color:#7f8c8d; font-style:italic;">Kayıt bulunamadı.</p>
			</div>
		}
		else
		{
			<RadzenDataGrid TItem="ItemGorev" Data="@AktifListe" @ref="GrdGorev" AllowPaging="true" AllowSorting="true" AllowFiltering="true" RowDoubleClick="@OnRowDoubleClick" Style="width:100%; white-space:nowrap; overflow-x:auto;" ColumnWidth="150px">
				<Columns>
					<RadzenDataGridColumn TItem="ItemGorev" Property="ID" Title="ID" Width="150px"></RadzenDataGridColumn>
					<RadzenDataGridColumn TItem="ItemGorev" Property="Baslik" Title="Başlık" Frozen="true"></RadzenDataGridColumn>
					<RadzenDataGridColumn TItem="ItemGorev" Title="Atanan Kişi">
						<Template Context="g">
							@GetAtananKullaniciAdi(g.Kullanici_ID, g.Kilitli)
						</Template>
					</RadzenDataGridColumn>
					<RadzenDataGridColumn TItem="ItemGorev" Property="Kategori_ID" Title="Kategori"></RadzenDataGridColumn>
					<RadzenDataGridColumn TItem="ItemGorev" Property="OnemDerecesi" Title="Önem">
						<Template Context="g">
							@(string.IsNullOrWhiteSpace(g.OnemDerecesi) ? "Yok" : g.OnemDerecesi)
						</Template>
						<Template Context="onem">
                            <span style="font-size:12px; padding:3px 8px; border-radius:6px; color:white; background-color:@GetOnemRengi(onem.OnemDerecesi ?? string.Empty)">
								@onem.OnemDerecesi
							</span>
						</Template>
					</RadzenDataGridColumn>
					<RadzenDataGridColumn TItem="ItemGorev" Property="TekrarlamaTipi" Title="Tekrarlama">
						<Template Context="g">
							@(string.IsNullOrWhiteSpace(g.TekrarlamaTipi) ? "Yok" : g.TekrarlamaTipi)
						</Template>
					</RadzenDataGridColumn>
					<RadzenDataGridColumn TItem="ItemGorev" Property="TekrarAraligi" Title="Tekrar Aralığı" Width="200px">
						<Template Context="g">
							@(g.TekrarAraligi.HasValue? g.TekrarAraligi.ToString() : "Yok")
						</Template>
					</RadzenDataGridColumn>
					<RadzenDataGridColumn TItem="ItemGorev" Property="HaftaninGunu" Title="Haftanın Günü" width="200px">
						<Template Context="g">
							@(string.IsNullOrWhiteSpace(g.HaftaninGunu) ? "Yok" : g.HaftaninGunu)
						</Template>
					</RadzenDataGridColumn>
					<RadzenDataGridColumn TItem="ItemGorev" Property="AyinGunu" Title="Ayın Günü">
						<Template Context="g">
							@(g.AyinGunu.HasValue? g.AyinGunu.ToString() : "Yok")
						</Template>
					</RadzenDataGridColumn>
					<RadzenDataGridColumn TItem="ItemGorev" Property="BaslangicTarihi" Title="Başlangıç" FormatString="{0:dd.MM.yyyy HH:mm}">
					</RadzenDataGridColumn>
					<RadzenDataGridColumn TItem="ItemGorev" Property="BitisTarihi" Title="Bitiş" FormatString="{0:dd.MM.yyyy HH:mm}"></RadzenDataGridColumn>
					<RadzenDataGridColumn TItem="ItemGorev" Property="SonrakiCalismaTarihi" Title="Sonraki Çalışma Tarihi" FormatString="{0:dd.MM.yyyy HH:mm}" Width="220px"></RadzenDataGridColumn>
					<RadzenDataGridColumn TItem="ItemGorev" Property="Kilitli" Title="Kilitli Mi?">
						<Template Context="g">
							@(g.Kilitli ? "Evet" : "Hayır")
						</Template>
					</RadzenDataGridColumn>
					<RadzenDataGridColumn TItem="ItemGorev" Property="Tamamlandi" Title="Tamamlandı" Width="150px" Filterable="false" Sortable="true" TextAlign="TextAlign.Center">
						<Template Context="gorev">
							@* Admin sadece görüntüleyebilir, değiştiremez *@
							<RadzenCheckBox Value="gorev.Tamamlandi" TValue="bool" Disabled="true"></RadzenCheckBox>
						</Template>
					</RadzenDataGridColumn>
					<RadzenDataGridColumn TItem="ItemGorev" Property="Aktif" Title="Durum">
						<Template Context="gorev">

							<span @onclick="() => ToggleDurum(gorev)"
								  style="@($"cursor:pointer; font-size:12px; padding:3px 8px; border-radius:6px; background-color:{(gorev.Aktif ? "#4caf50" : "#e53935")}; color:white; display:inline-block;")">
								@(gorev.Aktif ? "Aktif" : "Pasif")
							</span>

						</Template>
					</RadzenDataGridColumn>
					<RadzenDataGridColumn TItem="ItemGorev" Title="İşlemler" Width="150px">
						<Template Context="gorev">
							<RadzenButton Icon="edit" Size="ButtonSize.Small" Click="@(() => Duzenle(gorev))" Style="margin-right:5px;"></RadzenButton>
							<RadzenButton Icon="delete" Size="ButtonSize.Small" ButtonStyle="ButtonStyle.Danger" Click="@(() => Sil(gorev))"></RadzenButton>
						</Template>
					</RadzenDataGridColumn>
				</Columns>
			</RadzenDataGrid>
		}
	}
	</RadzenCard>
}
else if(kullaniciTip.Adi=="Standart")
{

	<RadzenCard Style="margin:20px;">
		<h3 style="text-align:center;">Görev Listesi</h3>

		@* Standart kullanıcı yeni görev ekleyemez, buton kaldırıldı *@

		@if (GorevListt == null || !GorevListt.Any())
		{
			<p>Veri yükleniyor... veya görev bulunamadı.</p>
		}
		else
		{
			<div class="my-tabs" style="margin-top:15px;">
				<div class="my-tab @(SelectedTabIndex2 == 0 ? "active" : "")"
					 @onclick="() => SelectedTabIndex2 = 0">
					Tüm Aktif Görevler
				</div>
				<div class="my-tab @(SelectedTabIndex2 == 1 ? "active" : "")"
					 @onclick="() => SelectedTabIndex2 = 1">
					Yaklaşan Görevler
				</div>
				<div class="my-tab @(SelectedTabIndex2 == 2 ? "active" : "")"
					 @onclick="() => SelectedTabIndex2= 2">
					Tamamlanmış Görevler
				</div>
				<div class="my-tab @(SelectedTabIndex2 == 3 ? "active" : "")"
					 @onclick="() => SelectedTabIndex2 = 3">
					Süresi Dolanlar
				</div>
				<div class="my-tab @(SelectedTabIndex2 == 4 ? "active" : "")"
					 @onclick="() => SelectedTabIndex2 = 4">
					Pasif Görevler
				</div>
				<div class="my-tab @(SelectedTabIndex2 == 5 ? "active" : "")"
					 @onclick="() => SelectedTabIndex2 = 5">
					Size Özel Görevler
				</div>
			</div>

			@if (!AktifListee.Any())
			{
				<div style="text-align:center; padding:50px;">
					<p style="color:#7f8c8d; font-style:italic;">Kayıt bulunamadı.</p>
				</div>
			}
			else
			{
				<RadzenDataGrid TItem="ItemGorev" Data="@AktifListee" @ref="GrdGorev" AllowPaging="true" AllowSorting="true" AllowFiltering="true" Style="width:100%; white-space:nowrap; overflow-x:auto;" ColumnWidth="150px">
					<Columns>
						<RadzenDataGridColumn TItem="ItemGorev" Property="ID" Title="ID" Width="70px"></RadzenDataGridColumn>
						<RadzenDataGridColumn TItem="ItemGorev" Property="Baslik" Title="Başlık" Frozen="true"></RadzenDataGridColumn>
						<RadzenDataGridColumn TItem="ItemGorev" Title="Atayan Kişi">
							<Template Context="g">
								@GetAtayanKullaniciAdi(g.CreUser)
							</Template>

						</RadzenDataGridColumn>
						<RadzenDataGridColumn TItem="ItemGorev" Property="Kategori_ID" Title="Kategori"></RadzenDataGridColumn>
						<RadzenDataGridColumn TItem="ItemGorev" Property="OnemDerecesi" Title="Önem">
							<Template Context="g">@(!string.IsNullOrWhiteSpace(g.OnemDerecesi) ? g.OnemDerecesi : "Yok")</Template>
							<Template Context="onem">
								<span style="font-size:12px; padding:3px 8px; border-radius:6px; color:white; background-color:@GetOnemRengi(onem.OnemDerecesi ?? string.Empty)">
									@onem.OnemDerecesi
								</span>
							</Template>
						</RadzenDataGridColumn>
						<RadzenDataGridColumn TItem="ItemGorev" Property="TekrarlamaTipi" Title="Tekrarlama">
							<Template Context="g">@(!string.IsNullOrWhiteSpace(g.TekrarlamaTipi) ? g.TekrarlamaTipi : "Yok")</Template>
						</RadzenDataGridColumn>
						<RadzenDataGridColumn TItem="ItemGorev" Property="TekrarAraligi" Title="Tekrar Aralığı" Width="200px">
							<Template Context="g">@((g.TekrarAraligi.HasValue) ? g.TekrarAraligi.ToString() : "Yok")</Template>
						</RadzenDataGridColumn>
						<RadzenDataGridColumn TItem="ItemGorev" Property="BaslangicTarihi" Title="Başlangıç" FormatString="{0:dd.MM.yyyy HH:mm}"></RadzenDataGridColumn>
						<RadzenDataGridColumn TItem="ItemGorev" Property="BitisTarihi" Title="Bitiş" FormatString="{0:dd.MM.yyyy HH:mm}"></RadzenDataGridColumn>
						<RadzenDataGridColumn TItem="ItemGorev" Property="Tamamlandi" Title="Tamamlandı" Width="150px" Filterable="false" Sortable="true" TextAlign="TextAlign.Center">
							<Template Context="gorev">
								@* Kullanıcı görevi tamamlayabilir - otomatik tekrarlama tetiklenir *@
								<RadzenCheckBox @bind-Value="gorev.Tamamlandi" TValue="bool" Change="@(async (args) => await ToggleTamamlandi(gorev))" Disabled="@(gorev.Aktif == false)"></RadzenCheckBox>
							</Template>
						</RadzenDataGridColumn>
						<RadzenDataGridColumn TItem="ItemGorev" Property="Aktif" Title="Durum">
							<Template Context="gorev">
								<span style="@($"font-size:12px; padding:3px 8px; border-radius:6px; background-color:{(gorev.Aktif ? "#4caf50" : "#e53935")}; color:white; display:inline-block;")">
									@(gorev.Aktif ? "Aktif" : "Pasif")
								</span>
							</Template>
						</RadzenDataGridColumn>
						@* İşlem sütunu kaldırıldı, standart kullanıcı düzenleyemez/silemez *@
					</Columns>
				</RadzenDataGrid>
			}
		}
	</RadzenCard>

}

@code {
	private string[] TabNames = new string[]
   {
		"Tüm Aktif Görevler",
		"Yaklaşan Görevler",
		"Tamamlanmış Görevler",
		"Süresi Dolanlar",
		"Pasif Görevler"
   };
	private ItemKullaniciTip kullaniciTip = new ItemKullaniciTip();
	private bool IsLoading = true;
	private List<ItemGorev> GorevListt = new();
	private RadzenDataGrid<ItemGorev>? GrdGorev;
	private int SelectedTabIndex { get; set; } = 0;
	private int SelectedTabIndex2 { get; set; } = 0;
	private ItemGorev gorevler = new ItemGorev();
	private List<User> TumKullanicilar = new();
	private int? currentUserId = null;

	[SupplyParameterFromQuery(Name = "tab")]
	public int QueryTabIndex { get; set; } = 0;

	protected override void OnParametersSet()
	{
		if (SelectedTabIndex !=QueryTabIndex)
		{
			SelectedTabIndex = QueryTabIndex;
		}
	}

	private IEnumerable<ItemGorev> AktifListe
	{
		get
		{
			return SelectedTabIndex switch
			{
				0 => aktifGorevler.OrderBy(g=>g.BaslangicTarihi).ThenBy(g=>g.Baslik),
				1 => yaklasanGorevler,
				2 => tamamlananGorevler,
				3 => gecmisGorevler,
				4 => pasifGorevler,
				_ => aktifGorevler,
			};
		}
	}

	private IEnumerable<ItemGorev> aktifGorevler => GorevListt.Where(g => g.Aktif && !g.Tamamlandi && (!g.BitisTarihi.HasValue || g.BitisTarihi.Value >= DateTime.Today));
	private IEnumerable<ItemGorev> yaklasanGorevler => aktifGorevler.Where(g => g.BitisTarihi.HasValue && (g.BitisTarihi.Value - DateTime.Now).TotalDays > 0 && (g.BitisTarihi.Value - DateTime.Now).TotalDays <= 7).OrderBy(g => g.BitisTarihi);
	private IEnumerable<ItemGorev> tamamlananGorevler => GorevListt.Where(g => g.Tamamlandi);
	private IEnumerable<ItemGorev> gecmisGorevler => GorevListt.Where(g => g.BitisTarihi.HasValue && g.BitisTarihi.Value < DateTime.Now && !g.Tamamlandi);
	private IEnumerable<ItemGorev> pasifGorevler => GorevListt.Where(g => !g.Aktif && !g.Tamamlandi && (!g.BitisTarihi.HasValue || g.BitisTarihi.Value>=DateTime.Today));

	private IEnumerable<ItemGorev> SAktifGorevler => GorevListt.Where(g => (g.Kullanici_ID == currentUserId || !g.Kilitli) && g.Aktif && !g.Tamamlandi && (!g.BitisTarihi.HasValue || g.BitisTarihi.Value >= DateTime.Today));
	private IEnumerable<ItemGorev> SYaklasanGorevler => GorevListt.Where(g => g.BitisTarihi.HasValue && !g.Kilitli &&g.Aktif &&(g.BitisTarihi.Value - DateTime.Now).TotalDays > 0 &&g.DelUser==0 &&(g.BitisTarihi.Value - DateTime.Now).TotalDays <= 7);
private IEnumerable<ItemGorev> STamamlananGorevler =>
    GorevListt.Where(g =>
        g.Tamamlandi &&
        g.DelUser == 0 &&
        (!g.Kilitli || g.Kullanici_ID == currentUserId) // kilitli değil veya kullanıcıya ait
    );	private IEnumerable<ItemGorev> SGecmisGorevler => GorevListt.Where(g => g.BitisTarihi.HasValue && g.BitisTarihi.Value < DateTime.Now && !g.Tamamlandi);
	private IEnumerable<ItemGorev> SPasifGorevler => GorevListt.Where(g => !g.Aktif && !g.Tamamlandi && (!g.BitisTarihi.HasValue || g.BitisTarihi.Value >= DateTime.Today));
	private IEnumerable<ItemGorev> SizeOzelGorevler => GorevListt.Where(g => (g.Kullanici_ID == currentUserId) && !g.Tamamlandi && g.DelUser == 0 && (!g.BitisTarihi.HasValue || g.BitisTarihi.Value >= DateTime.Today));

	protected override async Task OnInitializedAsync()
	
	{
		var user = await girisSaglayici.GetCurrentUserAsync();
		currentUserId = user?.ID;
		TumKullanicilar = await _kullaniciRepo.GetAllAsync(); // Tüm kullanıcıları al
		await YukleGorevler();
		await YukleKullaniciId();
		kullaniciTip = await _kullaniciTipRepository.GetKullaniciTipByKullaniciIDAsync(currentUserId.Value);
		if (kullaniciTip == null)
		{
			notificationService.Notify(NotificationSeverity.Warning, "Uyarı", "Kullanıcı tipi bulunamadı.");
			IsLoading = false;
			return;
		}
		await YukleKullanicilar();

	}
	private async Task YukleKullaniciId()
	{
		try
		{
			var currentUser = await girisSaglayici.GetCurrentUserAsync();
			if (currentUser != null)
			{
				currentUserId = currentUser.ID;
			}
		}
		catch (Exception ex)
		{
			notificationService.Notify(NotificationSeverity.Warning, "Uyarı", "Kullanıcı bilgisi yüklenirken bir hata oluştu: " + ex.Message);
		}
	}

	private async Task YukleKullanicilar()
	{
		TumKullanicilar = await _kullaniciRepo.GetAllAsync();
	}

	private async Task YukleGorevler()
	{
		try
		{
			GorevListt = (await DataService.GetGorevler()).ToList();

		}
		catch (Exception ex)
		{
			notificationService.Notify(NotificationSeverity.Error, "Hata", ex.Message);
		}
	}

	private async Task YeniGorev()
	{
		if (currentUserId == null)
		{
			notificationService.Notify(NotificationSeverity.Error, "Hata", "Kullanıcı bilgisi alınamadı.");
			return;
		}

		// Yeni görev nesnesi oluşturuluyor
		var yeniGorev = new ItemGorev
		{
			CreUser = currentUserId ?? 0, // mutlaka giriş yapan kullanıcı ID'si
			Kullanici_ID = currentUserId ?? 0, // görev kullanıcıya atanacaksa
			Aktif = true
		};

		// Dialog'u açıyoruz
		var result = await DialogService.OpenAsync<GorevTnm>(
			"Görev Ekle",
			new Dictionary<string, object> { { "Gorev", yeniGorev } },
			new DialogOptions { Width = "600px", Height = "auto" }
		);

		// Dialog'dan dönen sonucu kontrol ediyoruz
		if (result is ItemGorev g && g.ID > 0)
		{
			g.CreUser = currentUserId.Value; // Atayan kişi burada kesin setleniyor
			GorevListt.Insert(0, g);
			await GrdGorev.Reload();
			notificationService.Notify(NotificationSeverity.Success, "Başarılı", "Görev başarıyla eklendi!");
		}
		// Eğer result null veya ID 0 ise, kullanıcı iptal etmiş demektir, mesaj göstermiyoruz
	}

	private MarkupString GetAtananKullaniciAdi(int kullaniciId, bool kilitli)
	{
		if (!kilitli)
		{
			return (MarkupString)"—";
		}

		var kullanici = TumKullanicilar.FirstOrDefault(x => x.ID == kullaniciId);
		if (kullanici == null)
		{
			return (MarkupString)"—";
		}

		var adSoyad = $"{kullanici.Adi} {kullanici.Soyadi}".Trim();
		return (MarkupString)adSoyad;
	}


	private async Task Duzenle(ItemGorev gorev)
	{
		if (currentUserId.HasValue)
		{
			gorev.UpdUser = currentUserId.Value;
		}
		var result = await DialogService.OpenAsync<GorevTnm>(" ",
			new Dictionary<string, object> { { "Gorev", gorev } },
			new DialogOptions { Width = "600px", Height ="auto" });

		if (result is ItemGorev guncellendi)
	{
			if (guncellendi.ID == 0)
			{
				 // notificationService.Notify(NotificationSeverity.Success, "Başarılı", "Görev eklendi!");
			}
			else
			{
				 notificationService.Notify(NotificationSeverity.Success, "Başarılı", "Görev güncellendi!");
			}
		}
	}

	private async Task Sil(ItemGorev gorev)
	{
		bool? onay = await DialogService.Confirm("Görevi silmek istiyor musunuz?", "Onay",
			new ConfirmOptions { OkButtonText = "Evet", CancelButtonText = "Hayır" });

		if (onay == true)
		{
			if (currentUserId.HasValue)
			{
				gorev.DelUser = currentUserId.Value;
			}
			var wsCvp = await DataService.SetGorev(gorev);

			if (wsCvp.SonucKodu == 0)
			{
				GorevListt.Remove(gorev);
				await GrdGorev!.Reload();
				notificationService.Notify(NotificationSeverity.Success, "Silindi", "Görev silindi!");
			}
			else
			{
				notificationService.Notify(NotificationSeverity.Error, "Hata", "Silme başarısız.");
			}
		}
	}
	private async Task OnRowDoubleClick(DataGridRowMouseEventArgs<ItemGorev> args)
	{
		await Duzenle(args.Data);
	}
    private async Task ToggleDurum(ItemGorev item)
	{
		try
		{
			if (item.Tamamlandi)
			{
				notificationService.Notify(NotificationSeverity.Warning, "Uyarı", "Görev zaten tamamlandı. Aktiflik durumunu değiştirmek için önce Tamamlandı işaretini kaldırın.");
				return;
			}
			item.Aktif = !item.Aktif;
			if (currentUserId.HasValue)
			{
				item.UpdUser = currentUserId.Value;
			}

			var sonuc = await DataService.SetGorev(item);

			if (sonuc.SonucKodu == 0)
			{
				notificationService.Notify(NotificationSeverity.Success, "Durum Güncellendi", item.Aktif ? "Görev aktif hale getirildi." : "Görev pasif hale getirildi.");

                GorevListt = (await DataService.GetGorevler()).ToList();
                if (GrdGorev != null)
                {
                    await GrdGorev.Reload();
                }
			}
			else
			{
				notificationService.Notify(NotificationSeverity.Error, "Hata", sonuc.SonucAciklama);
				item.Aktif = !item.Aktif;
			}
		}
		catch (Exception ex)
		{
			notificationService.Notify(NotificationSeverity.Error, "Hata", ex.Message);
		}
	}

	private async Task ToggleTamamlandi(ItemGorev item)
	{
		try
		{
			if (!item.Tamamlandi)
			{
				item.Aktif = true;
			}

			if (currentUserId.HasValue)
			{
				item.UpdUser = currentUserId.Value;
			}

			var sonuc = await DataService.SetGorev(item);

			if (sonuc.SonucKodu == 0)
			{
				// Görev tamamlandı ve tekrarlama tipi varsa yeni görev oluştur
				if (item.Tamamlandi && !string.IsNullOrEmpty(item.TekrarlamaTipi) && item.TekrarlamaTipi != "Yok")
				{
					await OlusturTekrarlayanGorev(item);
				}
				
				notificationService.Notify(NotificationSeverity.Success, "Durum Güncellendi", item.Tamamlandi ? "Görev tamamlandı olarak işaretlendi." : "Görev tamamlanmadı olarak işaretlendi.");

				GorevListt = (await DataService.GetGorevler()).ToList();

				if (item.Tamamlandi)
				{
					SelectedTabIndex = 2;
				}
				else
				{
					SelectedTabIndex = 0;
				}

				if (GrdGorev!=null)
				{
					await GrdGorev.Reload();
				}
			}
			else
			{
				notificationService.Notify(NotificationSeverity.Error, "Hata", sonuc.SonucAciklama);

				item.Tamamlandi = !item.Tamamlandi;

				item.Aktif = !item.Aktif;

			}
		}
		catch (Exception ex)
		{
			notificationService.Notify(NotificationSeverity.Error, "Hata", ex.Message);

			item.Tamamlandi = !item.Tamamlandi;
			item.Aktif = !item.Aktif;
		}

	}

	// Tekrarlayan görev oluşturma metodu
	private async Task OlusturTekrarlayanGorev(ItemGorev eskiGorev)
	{
		try
		{
			// Yeni görev oluştur (eski görevin kopyası)
			var yeniGorev = new ItemGorev
			{
				Kullanici_ID = eskiGorev.Kullanici_ID,
				Baslik = eskiGorev.Baslik,
				Kategori_ID = eskiGorev.Kategori_ID,
				OnemDerecesi = eskiGorev.OnemDerecesi,
				TekrarlamaTipi = eskiGorev.TekrarlamaTipi,
				TekrarAraligi = eskiGorev.TekrarAraligi,
				HaftaninGunu = eskiGorev.HaftaninGunu,
				AyinGunu = eskiGorev.AyinGunu,
				Kilitli = eskiGorev.Kilitli,
				Aktif = true,
				Tamamlandi = false,
				CreUser = currentUserId ?? 0,
				
				// Yeni başlangıç tarihi = eski görevin SonrakiCalismaTarihi
				BaslangicTarihi = eskiGorev.SonrakiCalismaTarihi ?? DateTime.Now
			};

			// Bitiş tarihini hesapla (eski görevdeki süre farkı kadar)
			if (eskiGorev.BaslangicTarihi.HasValue && eskiGorev.BitisTarihi.HasValue)
			{
				var sureFarki = eskiGorev.BitisTarihi.Value - eskiGorev.BaslangicTarihi.Value;
				yeniGorev.BitisTarihi = yeniGorev.BaslangicTarihi.Value.Add(sureFarki);
			}

			// Yeni SonrakiCalismaTarihi hesapla
			HesaplaSonrakiCalismaTarihi(yeniGorev);

			// Veritabanına kaydet
			var sonuc = await DataService.SetGorev(yeniGorev);
			
			if (sonuc.SonucKodu == 0)
			{
				notificationService.Notify(NotificationSeverity.Info, "Tekrarlayan Görev", 
					$"Yeni görev oluşturuldu: {yeniGorev.BaslangicTarihi:dd.MM.yyyy}");
			}
		}
		catch (Exception ex)
		{
			notificationService.Notify(NotificationSeverity.Warning, "Uyarı", 
				$"Tekrarlayan görev oluşturulamadı: {ex.Message}");
		}
	}

	// SonrakiCalismaTarihi hesaplama (GorevTnm.razor'dan kopyalandı)
	private void HesaplaSonrakiCalismaTarihi(ItemGorev gorev)
	{
		if (gorev.BaslangicTarihi == null) return;

		var baslangic = gorev.BaslangicTarihi.Value;
		var aralik = gorev.TekrarAraligi ?? 1;

		switch (gorev.TekrarlamaTipi)
		{
			case "Günlük":
				gorev.SonrakiCalismaTarihi = baslangic.AddDays(aralik);
				break;

			case "Haftalık":
				if (!string.IsNullOrEmpty(gorev.HaftaninGunu))
				{
					var hedefGun = MapHaftaninGunu(gorev.HaftaninGunu);
					var tarih = baslangic;
					while (tarih.DayOfWeek != hedefGun)
					{
						tarih = tarih.AddDays(1);
					}
					gorev.SonrakiCalismaTarihi = tarih.AddDays(7 * (aralik - 1));
				}
				else
				{
					gorev.SonrakiCalismaTarihi = baslangic.AddDays(7 * aralik);
				}
				break;

			case "Aylık":
				if (gorev.AyinGunu.HasValue)
				{
					var maxGun = DateTime.DaysInMonth(baslangic.Year, baslangic.Month);
					var ayinGunu = Math.Min(gorev.AyinGunu.Value, maxGun);

					var tarih = new DateTime(baslangic.Year, baslangic.Month, ayinGunu);
					if (tarih <= baslangic)
						tarih = tarih.AddMonths(aralik);

					gorev.SonrakiCalismaTarihi = tarih;
				}
				else
				{
					gorev.SonrakiCalismaTarihi = baslangic.AddMonths(aralik);
				}
				break;

			default:
				gorev.SonrakiCalismaTarihi = gorev.BitisTarihi;
				break;
		}
	}

	private DayOfWeek MapHaftaninGunu(string gun)
	{
		return gun?.ToLower() switch
		{
			"pazartesi" => DayOfWeek.Monday,
			"salı" => DayOfWeek.Tuesday,
			"çarşamba" => DayOfWeek.Wednesday,
			"perşembe" => DayOfWeek.Thursday,
			"cuma" => DayOfWeek.Friday,
			"cumartesi" => DayOfWeek.Saturday,
			"pazar" => DayOfWeek.Sunday,
			_ => DayOfWeek.Monday
		};
	}
    private string GetOnemRengi(string onem)
	{
        return onem?.ToLower() switch
        {
            "yüksek" => "#e74c3c",
            "orta" => "#f1c40f",
            "düşük" => "#2ecc71",
            _ => "#95a5a6" // varsayılan gri ton
        };
	}
