@page "/dashboard"
@layout MainLayout

@if (showYeniGorevBildirimi && !IsLoading)
{
	<RadzenCard Style="margin:20px; background:linear-gradient(135deg, #667eea 0%, #764ba2 100%); color:white; border:none; box-shadow:0 4px 6px rgba(0,0,0,0.1); z-index:1000;">
		<div style="display:flex; justify-content:space-between; align-items:center; padding:15px;">
			<div style="display:flex; align-items:center; gap:15px; flex:1;">
				<RadzenIcon Icon="notifications" Style="font-size:28px; color:white;"></RadzenIcon>
				<div>
					<h4 style="margin:0; color:white; font-weight:600;">Yeni Görevleriniz Var!</h4>
					<p style="margin:5px 0 0 0; color:rgba(255,255,255,0.9); font-size:14px;">
						@if (gosterilecekOzelGorevSayisi > 0 && gosterilecekGenelGorevSayisi > 0)
						{
							<span>@(gosterilecekOzelGorevSayisi + gosterilecekGenelGorevSayisi) yeni göreviniz var! (<a href="#" @onclick="@(async () => await NavigateToOzelGorevler())" @onclick:preventDefault="true" style="color:white; text-decoration:underline; cursor:pointer;">@gosterilecekOzelGorevSayisi size özel</a>, <a href="#" @onclick="@(async () => await NavigateToGenelGorevler())" @onclick:preventDefault="true" style="color:white; text-decoration:underline; cursor:pointer;">@gosterilecekGenelGorevSayisi herkese açık</a>) Dashboard'ınızı kontrol ediniz.</span>
						}
						else if (gosterilecekOzelGorevSayisi > 0)
						{
							<span><a href="#" @onclick="@(async () => await NavigateToOzelGorevler())" @onclick:preventDefault="true" style="color:white; text-decoration:underline; cursor:pointer;">@gosterilecekOzelGorevSayisi size özel</a> yeni göreviniz var! Dashboard'ınızı kontrol ediniz.</span>
						}
						else if (gosterilecekGenelGorevSayisi > 0)
						{
							<span><a href="#" @onclick="@(async () => await NavigateToGenelGorevler())" @onclick:preventDefault="true" style="color:white; text-decoration:underline; cursor:pointer;">@gosterilecekGenelGorevSayisi yeni göreviniz</a> var! Dashboard'ınızı kontrol ediniz.</span>
						}
					</p>
				</div>
			</div>
			<RadzenButton Icon="close" ButtonStyle="ButtonStyle.Light" Size="ButtonSize.Small"
						  Style="background:rgba(255,255,255,0.2); color:white; border:none; min-width:auto;"
						  Click="@(async () => { await BildirimiKapat(); })"></RadzenButton>
		</div>
	</RadzenCard>
}

@if (kullaniciTip != null && kullaniciTip.Adi == "Admin")
{
	<RadzenStack Orientation="Orientation.Vertical" Gap="20px" class="rz-p-md">
		<h2 style="font-family:serif;font-weight: bold; "> Admin Kontrol Paneli</h2>
		@if (IsLoading)
		{
			<p style="text-align:center;">Veriler yükleniyor...</p>
			<RadzenProgressBar Value="100" ShowValue="false" Indeterminate="true" Style="width:300px;"></RadzenProgressBar>

			<div class="row mt-4">
				<div class="col-md-6">
					<div class="shimmer-wrapper" style="height:	300px; border-radius:6px;"></div>
				</div>
				<div class="col-md-6">
					<div class="shimmer-wrapper" style="height:	320px; border-radius:6px;"></div>
				</div>
			</div>
		}
		else
		{
			<RadzenStack Orientation="Orientation.Horizontal" JustifyContent="JustifyContent.Start" Gap="1.5rem">
				<RadzenCard class="radzen-hover-effect" Style="width:230px; border-left: 5px solid #3498db; cursor:pointer;" @onclick="@(() => NavigateToGorevler(5))">
					<div style="display:flex; justify-content:space-between; align-items:center;">
						<div>
							<RadzenText TextStyle="TextStyle.Subtitle2">Tüm  Görevler</RadzenText>
							<RadzenText TextStyle="TextStyle.H4">@(TumGorevler.Count())</RadzenText>
						</div>
						<RadzenIcon Icon="list" Style=" font-size:32px; color:#3498db; opacity:0.6;"></RadzenIcon>
					</div>
				</RadzenCard>

				<RadzenCard class="radzen-hover-effect" Style="width:230px; border-left: 5px solid #f1c40f; cursor:pointer;" @onclick="@(() => NavigateToGorevler(0))">
					<div style="display:flex; justify-content:space-between; align-items:center;">
						<div>
							<RadzenText TextStyle="TextStyle.Subtitle2">Aktif Görevler</RadzenText>
							<RadzenText TextStyle="TextStyle.H4" >@(aktifGorevler.Count())</RadzenText>
						</div>
						<RadzenIcon Icon="schedule" Style=" font-size:32px; opacity:0.6; color:#f1c40f; "></RadzenIcon>
					</div>
				</RadzenCard>


				<RadzenCard class="radzen-hover-effect" Style="width:230px; border-left: 5px solid #e74c3c; cursor:pointer;" @onclick="@(() => NavigateToGorevler(1))">
					<div style="display:flex; justify-content:space-between; align-items:center;">
						<div>
							<RadzenText TextStyle="TextStyle.Subtitle2">Bugünkü Görevler</RadzenText>
							<RadzenText TextStyle="TextStyle.H4">@(BugunkuGorevler.Count())</RadzenText>
						</div>
						<RadzenIcon Icon="schedule" Style="font-size:32px; opacity:0.6; color:#e74c3c;"></RadzenIcon>
					</div>
				</RadzenCard>

				<RadzenCard class="radzen-hover-effect" Style="width:230px; border-left: 5px solid #9b59b6; cursor:pointer;" @onclick="@(() => NavigateToGorevler(2))">
					<div style="display:flex; justify-content:space-between; align-items:center;">
						<div>
							<RadzenText TextStyle="TextStyle.Subtitle2">Tamamlanan Görevler</RadzenText>
							<RadzenText TextStyle="TextStyle.H4">@(tamamlananGorevler.Count())</RadzenText>
						</div>
						<RadzenIcon Icon="done_all" Style="font-size:32px; opacity:0.6; color:#9b59b6;"></RadzenIcon>
					</div>
				</RadzenCard>

				<RadzenCard class="radzen-hover-effect" Style="width:230px; border-left: 5px solid #f39c12; cursor:pointer;" @onclick="@(() => NavigateToGorevler(6))">
					<div style="display:flex; justify-content:space-between; align-items:center;">
						<div>
							<RadzenText TextStyle="TextStyle.Subtitle2">Size Özel Görevler</RadzenText>
							<RadzenText TextStyle="TextStyle.H4">@(SizeOzelGorevler.Count())</RadzenText>
						</div>
						<RadzenIcon Icon="lock" Style="font-size:32px; opacity:0.6; color:#f39c12;"></RadzenIcon>
					</div>
				</RadzenCard>
			</RadzenStack>

			<div class="row">
				<div class="col-md-6">
					<RadzenChart Style="height:300px; transition: all 0.4s ease-in-out;"
								 Palette="@(new[] { "#3498db", "#9b59b6", "#e74c3c", "#f39c12" })">

						<RadzenPieSeries Data="@GorevDurumData"
										 ValueProperty="Value"
										 CategoryProperty="Category"
										 Title="Görev Durum Dağılımı">
							<TooltipTemplate Context="data">
								<div style="padding:4px 8px; font-size:13px;">
									<strong>@data.Category:</strong> @data.Value görev
								</div>
							</TooltipTemplate>

						</RadzenPieSeries>
						<RadzenLegend Position="LegendPosition.Right"></RadzenLegend>
					</RadzenChart>
				</div>

				<div class="col-md-6">
					<RadzenChart Style="height:320px; transition:all 0.4s ease-in-out;" Palette="@(new[] { "#3498db", "#9b59b6", "#e74c3c", "#f39c12" })">
						<RadzenColumnSeries Data="@GorevDurumData" CategoryProperty="Category" ValueProperty="Value" Title="Görev Sayısı">
							<TooltipTemplate Context="data">
								<div style="padding:4px 8px; font-size:13px;">
									<strong>@data.Category:</strong> @data.Value görev
								</div>
							</TooltipTemplate>

						</RadzenColumnSeries>

						<RadzenCategoryAxis Padding="20"></RadzenCategoryAxis>
						<RadzenValueAxis></RadzenValueAxis>
						<RadzenLegend Position="LegendPosition.Right"></RadzenLegend>
					</RadzenChart>
				</div>
			</div>

			<RadzenCard Style="box-shadow:0 4px 10px rgba(0, 0, 0, 0.1); border-left:5px solid #3498db; margin-top:20px;">
				<h5 style="color:#3498db; font-weight:600; margin-bottom:15px;">Görev Takvimi</h5>
				<p style="color:#555; font-size:14px; margin-bottom:15px;">
					Tüm görevleri tarihlerine göre görüntüleyin
				</p>
				<div class="calendar-container" style="display:grid; grid-template-columns:repeat(7, 1fr); gap:8px; margin-top:20px;">
					<div style="text-align:center; font-weight:600; padding:10px; background:#f8f9fa; border-radius:4px; color:#555;">Pzt</div>
					<div style="text-align:center; font-weight:600; padding:10px; background:#f8f9fa; border-radius:4px; color:#555;">Sal</div>
					<div style="text-align:center; font-weight:600; padding:10px; background:#f8f9fa; border-radius:4px; color:#555;">Çar</div>
					<div style="text-align:center; font-weight:600; padding:10px; background:#f8f9fa; border-radius:4px; color:#555;">Per</div>
					<div style="text-align:center; font-weight:600; padding:10px; background:#f8f9fa; border-radius:4px; color:#555;">Cum</div>
					<div style="text-align:center; font-weight:600; padding:10px; background:#f8f9fa; border-radius:4px; color:#555;">Cmt</div>
					<div style="text-align:center; font-weight:600; padding:10px; background:#f8f9fa; border-radius:4px; color:#555;">Paz</div>

					@foreach (var day in GetCalendarDays())
					{
						var dayGorevler = GetGorevlerForDate(day);
						var isToday = day.Date == DateTime.Today;
						var isCurrentMonth = day.Month == selectedMonth.Month && day.Year == selectedMonth.Year;

						<div style="min-height:100px; padding:8px; border:1px solid #e0e0e0; border-radius:4px;
															background:@(isToday ? "#e3f2fd" : isCurrentMonth ? "white" : "#f5f5f5");
															cursor:pointer; position:relative;"
							 @onclick="@(() => ShowDayDetails(day, dayGorevler))">
							<div style="font-weight:@(isToday ? "bold" : "normal");
																color:@(isToday ? "#1976d2" : isCurrentMonth ? "#333" : "#999");
																margin-bottom:5px;">
								@day.Day
							</div>
							@if (dayGorevler.Any())
							{
								<div style="display:flex; flex-direction:column; gap:2px;">
									@foreach (var gorev in dayGorevler.Take(3))
									{
										var renk = GetGorevRengi(gorev);
										<div style="font-size:10px; padding:2px 4px; background:@renk; color:white;
																							border-radius:3px; white-space:nowrap; overflow:hidden; text-overflow:ellipsis;"
											 title="@gorev.Baslik">
											@gorev.Baslik
										</div>
									}
									@if (dayGorevler.Count() > 3)
									{
										<div style="font-size:10px; color:#666; text-align:center; margin-top:2px;">
											+@(dayGorevler.Count() - 3) daha
										</div>
									}
								</div>
							}
						</div>
					}
				</div>

				<div style="display:flex; justify-content:space-between; align-items:center; margin-top:20px; padding:10px; background:#f8f9fa; border-radius:4px;">
					<RadzenButton Icon="chevron_left" ButtonStyle="ButtonStyle.Light" Size="ButtonSize.Small"
								  Click="@(() => { selectedMonth = selectedMonth.AddMonths(-1); StateHasChanged(); })" />
					<h6 style="margin:0; font-weight:600;">@selectedMonth.ToString("MMMM yyyy", new System.Globalization.CultureInfo("tr-TR"))</h6>
					<RadzenButton Icon="chevron_right" ButtonStyle="ButtonStyle.Light" Size="ButtonSize.Small"
								  Click="@(() => { selectedMonth = selectedMonth.AddMonths(1); StateHasChanged(); })" />
				</div>
			</RadzenCard>

			<div class="row mt-4">
				<div class="col-md-12">
					<RadzenCard Style="box-shadow:0 4px 10px rgba(0, 0, 0,0.1); border-left:5px solid #e74c3c;">
						<h5 style="color:#e74c3c; font-weight:600; margin-bottom:10px;">Kritik Aktif Görevler </h5>
						<p style="color:#555; font-size:14px; margin-bottom:10px;">
							Yüksek öneme sahip aktif görevlerin listesi
						</p>

						@if (kritikGorevler != null && kritikGorevler.Any())
						{
							<RadzenDataGrid Data="@kritikGorevler" TItem="ItemGorev" RowSelect="GorevSecildi" Style="max-height:250px; overflow-y:auto;">
								<Columns>
									<RadzenDataGridColumn TItem="ItemGorev" Width="55px">
										<Template Context="g">
											@if (g.BitisTarihi.HasValue &&
																			g.BitisTarihi.Value < DateTime.Now &&
																			!g.Tamamlandi)
											{
												<RadzenIcon Icon="warning"
															Style="color:#e74c3c;"
															Title="Süresi dolmuş görev" />
											}
										</Template>
									</RadzenDataGridColumn>
									<RadzenDataGridColumn TItem="ItemGorev" Property="Baslik" Title="Başlık"></RadzenDataGridColumn>
									<RadzenDataGridColumn TItem="ItemGorev" Property="BitisTarihi" Title="Bitiş Tarihi" FormatString="{0:dd.MM.yyyy HH:mm}"></RadzenDataGridColumn>
									<RadzenDataGridColumn TItem="ItemGorev" Title="Önem">
										<Template Context="onem">
											<span style="display:inline-block; width:60px; text-align:center; font-size:12px; padding:3px 8px; border-radius:4px; color:white; background-color:@GetOnemRengi(onem.OnemDerecesi)">
												@(string.IsNullOrWhiteSpace(onem.OnemDerecesi) ? "Yok" : onem.OnemDerecesi)
											</span>
										</Template>
									</RadzenDataGridColumn>
									<RadzenDataGridColumn TItem="ItemGorev" Property="Aktif" Title="Durum">
										<Template Context="durum">
											<span style="display:inline-block; width:60px; text-align:center; font-size:12px; padding:3px 8px; border-radius:6px; background-color:@(durum.Aktif ? "#4caf50" : "#e53935"); color:white;">
												@(durum.Aktif ? "Aktif" : "Pasif")
											</span>
										</Template>
									</RadzenDataGridColumn>
								</Columns>
							</RadzenDataGrid>
						}
						else
						{
							<div style="padding:10px; color:#888;">Kritik aktif görev bulunmuyor.</div>
						}

					</RadzenCard>
				</div>

			</div>

			<RadzenCard Style="box-shadow:0 4px 10px rgba(0, 0, 0, 0.1); border-left:5px solid #16a085; margin-top:20px;">
				<h5 style="color:#16a085; font-weight:600; margin-bottom:10px;">Bana Atanan Görevler</h5>
				<p style="color:#555; font-size:14px; margin-bottom:10px;">
					Size Özel Görevlerin listesi
				</p>
				@if (adminGorevleri != null && adminGorevleri.Any())
				{
					<RadzenDataGrid Data="@adminGorevleri" TItem="ItemGorev" RowSelect="GorevSecildi" AllowPaging="true" PageSize="5" AllowSorting="true" class="radzen-grid">
						<Columns>
							<RadzenDataGridColumn TItem="ItemGorev" Width="55px">
								<Template Context="g">
									@if (g.BitisTarihi.HasValue &&
															g.BitisTarihi.Value < DateTime.Now &&
															!g.Tamamlandi)
									{
										<RadzenIcon Icon="warning"
													Style="color:#e74c3c;"
													Title="Süresi dolmuş görev" />
									}
								</Template>
							</RadzenDataGridColumn>
							<RadzenDataGridColumn Title="No" Width="100px">
								<Template Context="g">
									@(adminGorevleri.ToList().IndexOf(g) + 1)
								</Template>
							</RadzenDataGridColumn>
 							<RadzenDataGridColumn TItem="ItemGorev" Property="Baslik" Title="Başlık" Width="250px"></RadzenDataGridColumn>
							<RadzenDataGridColumn TItem="ItemGorev" Title="Atayan Kişi" Width="150px;">
								<Template Context="g">
									@GetAtayanKullaniciAdi(g.CreUser)
								</Template>
							</RadzenDataGridColumn>
							<RadzenDataGridColumn TItem="ItemGorev" Property="BitisTarihi" Title="Bitiş Tarihi" FormatString="{0:dd.MM.yyyy HH:mm}" Width="150px"></RadzenDataGridColumn>
							<RadzenDataGridColumn TItem="ItemGorev" Property="OnemDerecesi" Title="Önem" Width="100px">
								<Template Context="onem">
									<span style="display:inline-block; width:60px; text-align:center; font-size:12px; padding:3px 8px; border-radius:4px; color:white; background-color:@GetOnemRengi(onem.OnemDerecesi)">
										@(string.IsNullOrWhiteSpace(onem.OnemDerecesi) ? "Yok" : onem.OnemDerecesi)
									</span>
								</Template>
							</RadzenDataGridColumn>
							<RadzenDataGridColumn TItem="ItemGorev" Property="Aktif" Title="Aktif" Width="80px">
								<Template Context="durum">
									<span style="display:inline-block; width:60px; text-align:center; font-size:12px; padding:3px 8px; border-radius:6px; background-color:@(durum.Aktif ? "#4caf50" : "#e53935"); color:white;">
										@(durum.Aktif ? "Aktif" : "Pasif")
									</span>
								</Template>
							</RadzenDataGridColumn>
							<RadzenDataGridColumn TItem="ItemGorev" Property="Tamamlandi" Title="Tamamlandı" Width="100px">
								<Template Context="durum">
									<span style="display:inline-block; width:60px; text-align:center; font-size:12px; padding:3px 8px; border-radius:6px; background-color:@(durum.Tamamlandi ? "#4caf50" : "#e53935"); color:white;">
										@(durum.Tamamlandi ? "Evet" : "Hayır")
									</span>
								</Template>
							</RadzenDataGridColumn>
						</Columns>
					</RadzenDataGrid>
				}
				else
				{
					<div style="padding:20px; text-align:center; color:#888;">
						<p>Size atanan görev bulunmuyor.</p>
						<p style="font-size:12px; margin-top:10px;">
							@if (!currentUserId.HasValue)
							{
								<span>Kullanıcı ID yüklenemedi. Lütfen giriş yaptığınızdan emin olun.</span>
							}
							else
							{
								<span>Kilitli görevler ve size atanan görevler burada görünecektir.</span>
							}
						</p>
					</div>
				}
			</RadzenCard>

			<RadzenCard Style="box-shadow:0 4px 10px rgba(0, 0, 0, 0.1); border-left:5px solid #3498db; margin-top:20px;">
				<h5 style="color:#3498db; font-weight:600; margin-bottom:10px;">Tüm Görevlerin Özeti</h5>
				<p style="color:#555; font-size:14px; margin-bottom:10px;">
					Sistemdeki tüm görevlerin genel durumu
				</p>
				<RadzenDataGrid Data="@kullaniciGorevler" TItem="ItemGorev" RowSelect="GorevSecildi" AllowPaging="true" PageSize="5" AllowSorting="true" class="radzen-grid">
					<Columns>
						<RadzenDataGridColumn TItem="ItemGorev" Property="ID" Title="ID" Width="0px"></RadzenDataGridColumn>
						<RadzenDataGridColumn Title="No" Width="100px">
							<Template Context="g">
								@(kullaniciGorevler.ToList().IndexOf(g) + 1)
							</Template>
						</RadzenDataGridColumn>
						<RadzenDataGridColumn TItem="ItemGorev" Property="Baslik" Title="Başlık" Width="350px"></RadzenDataGridColumn>
						<RadzenDataGridColumn TItem="ItemGorev" Title="Atanan Kişi">
							<Template Context="g">
								@if (!g.Kilitli)
								{
									<span>—</span>
								}
								else if (GetAtananKisiSayisi(g) > 1)
								{
									var list = GetAtananKisiListesi(g);

									<div style="display:flex; flex-direction:column; gap:4px;">
										<div style="display:flex; flex-wrap:wrap; gap:6px;">
											@foreach (var ad in list)
											{
												<span style="background:#f0f0f0; padding:2px 6px;
				                                      border-radius:4px; font-size:11px; color:#333;">
													@ad
												</span>
											}
										</div>
									</div>
								}
								else
								{
									<span>@GetTekKisiAdi(g)</span>
								}
							</Template>
						</RadzenDataGridColumn>
						<RadzenDataGridColumn TItem="ItemGorev" Property="OnemDerecesi" Title="Önem" Width="120px">
							<Template Context="onem">
								<span style="display:inline-block; width:60px; text-align:center; font-size:12px; padding:3px 8px; border-radius:4px; color:white; background-color:@GetOnemRengi(onem.OnemDerecesi)">
									@(string.IsNullOrWhiteSpace(onem.OnemDerecesi) ? "Yok" : onem.OnemDerecesi)
								</span>
							</Template>
						</RadzenDataGridColumn>

						<RadzenDataGridColumn TItem="ItemGorev" Property="Aktif" Title="Aktif" Width="120px">
							<Template Context="durum">
								<span style="display:inline-block; width:60px; text-align:center; font-size:12px; padding:3px 8px; border-radius:6px; background-color:@(durum.Aktif ? "#4caf50" : "#e53935"); color:white;">
									@(durum.Aktif ? "Aktif" : "Pasif")
								</span>
							</Template>
						</RadzenDataGridColumn>

						<RadzenDataGridColumn TItem="ItemGorev" Property="Tamamlandi" Title="Tamamlandı" Width="120px">
							<Template Context="durum">
								<span style="display:inline-block; width:60px; text-align:center; font-size:12px; padding:3px 8px; border-radius:6px; background-color:@(durum.Tamamlandi ? "#4caf50" : "#e53935"); color:white;">
									@(durum.Tamamlandi ? "Evet" : "Hayır")
								</span>
							</Template>
						</RadzenDataGridColumn>

					</Columns>
				</RadzenDataGrid>
			</RadzenCard>
		}
	</RadzenStack>

}
else if (kullaniciTip != null || kullaniciTip.Adi == "Standart")
{
	<RadzenStack Orientation="Orientation.Vertical" Gap="20px" class="rz-p-md">

		<h2 style="font-family:serif;font-weight: bold; ">Gösterge Paneli</h2>
		<RadzenStack Orientation="Orientation.Horizontal" Gap="20px">

			<RadzenCard class="radzen-hover-effect" Style="width:230px;cursor:pointer; border-left:5px solid #3498db;" @onclick="@(() => NavigateToGorevler2(6))">
				<div style="display:flex; justify-content:space-between; align-items:center;">
					<div>
						<RadzenText TextStyle="TextStyle.Subtitle2">Toplam Görev</RadzenText>
						<RadzenText TextStyle="TextStyle.H4">@(STumGorevler.Count())</RadzenText>
					</div>
					<RadzenIcon Icon="list" Style="font-size:32px; color:#3498db; opacity:0.6;" />
