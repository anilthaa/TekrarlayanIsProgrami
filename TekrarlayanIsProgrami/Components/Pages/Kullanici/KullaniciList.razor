@page "/kullanicilar"
@layout MainLayout
@attribute [Authorize]

<RadzenCard class="container mt-4" Style="z-index:2000 !important;">
    <h3 class="text-center mb-4" style="font-family:Calibri;font-weight:bold;">
        Kullanıcılar Listesi
    </h3>
    @if (_yetki != YetkiTipi.Gizli)
    {
        <div class="d-flex gap-2 mb-3">
            <RadzenButton Text="Yeni Kullanıcı Ekle"
                          Icon="add"
                          Style="background:#ba76d3; color:white;border-radius:10px;"
                          Disabled="@(_yetki == YetkiTipi.Okuma)"
                          Click="@OpenRegisterDialog" />
        </div>
    }
    <RadzenDataGrid @ref="kullaniciGrid"
                    Data="@kullanicilar"
                    TItem="User"
                    RowSelect="@OnRowSelect"
                    RowDoubleClick="@OnRowDoubleClick"
                    AllowPaging="true"
                    PageSize="10"
                    AllowSorting="true"
                    AllowFiltering="true"
                    FilterCaseSensitivity="FilterCaseSensitivity.CaseInsensitive"
                    class="align-middle mobile-card-grid">

        <Columns>

            <RadzenDataGridColumn TItem="User" Property="ID" Title="ID" Width="0px" />

            <RadzenDataGridColumn Title="No" Width="100px">
                <Template Context="g">
                    @(kullanicilar.ToList().IndexOf(g) + 1)
                </Template>
            </RadzenDataGridColumn>

            <RadzenDataGridColumn TItem="User" Property="Adi" Title="Ad" />
            <RadzenDataGridColumn TItem="User" Property="Soyadi" Title="Soyad" Width="150px" />
            <RadzenDataGridColumn TItem="User" Property="EPosta" Title="E-posta" Width="250px" />

            <RadzenDataGridColumn TItem="User" Title="Rol" Width="180px">
                <Template Context="k">
                    @GetKullaniciTipAdi(k.KullaniciTip_ID)
                </Template>
            </RadzenDataGridColumn>

            <RadzenDataGridColumn TItem="User" Title="Durum" Width="150px">
                <Template Context="k">

                    @if (_yetki != YetkiTipi.Gizli)
                    {
                        <span style="cursor:@(_yetki == YetkiTipi.Yazma ? "pointer" : "not-allowed");"
                              @onclick="async () =>
                              {
                                  if (_yetki == YetkiTipi.Yazma)
                                      await ToggleDurum(k);
                              }">

                        <RadzenBadge Text="@(k.Aktif ? "Aktif" : "Pasif")"
                                     Style="@(k.Aktif
                                                                                 ? "background-color:#3498db;color:white;padding:5px 10px;border-radius:10px;"
                                                                                 : "background-color:red;color:white;padding:5px 10px;border-radius:10px;")" />
                    </span>
                    }

                </Template>
            </RadzenDataGridColumn>

            @if (_yetki != YetkiTipi.Gizli)
            {
                <RadzenDataGridColumn TItem="User" Title="İşlemler" Width="240px">
                    <Template Context="user">

                        <RadzenButton Icon="mail"
                                      Style="margin-right:5px;"
                                      Size="ButtonSize.Small"
                                      ButtonStyle="ButtonStyle.Primary"
                                      Disabled="@(_yetki == YetkiTipi.Okuma || user.Aktif)"
                                      Click="@(() => IzinMailiGonder(user.ID))" />

                        <RadzenButton ButtonStyle="ButtonStyle.Success"
                                      Icon="edit"
                                      Size="ButtonSize.Small"
                                      Style="margin-right:5px;"
                                      Disabled="@(_yetki == YetkiTipi.Okuma)"
                                      Click="@(() => OpenEditDialog(user.ID))"
                                      @onclick:stopPropagation="true" />

                        <RadzenButton ButtonStyle="ButtonStyle.Info"
                                      Icon="lock"
                                      Size="ButtonSize.Small"
                                      Style="margin-right:5px;"
                                      Disabled="@(_yetki == YetkiTipi.Okuma)"
                                      Click="@(() => NavigateToYetki(user.ID))" />

                        <RadzenButton ButtonStyle="ButtonStyle.Danger"
                                      Icon="delete"
                                      Size="ButtonSize.Small"
                                      Disabled="@(_yetki == YetkiTipi.Okuma)"
                                      Click="@(async () => await ConfirmDelete(user))" />

                    </Template>
                </RadzenDataGridColumn>
            }

        </Columns>

    </RadzenDataGrid>
</RadzenCard>
@code {
    private List<User>? kullanicilar = new();
    private List<ItemKullaniciTip> kullaniciTipleri = new();
    private RadzenDataGrid<User> kullaniciGrid;
    private User user = new User();
    [Parameter]
    public int KullaniciId { get; set; }
    private YetkiTipi _yetki;

    //sayfa ilk açıldığında kullanıcı yönetimi ekranını hazırlayan başlangıç işlemlerini yapar.
    protected override async Task OnInitializedAsync()
    {
        _yetki = await PermissionService.GetCurrentUserYetkiAsync(6);
        if (_yetki == YetkiTipi.Gizli)
        {
            NavigationManager.NavigateTo("/yetkisiz");
            notificationService.Notify(NotificationSeverity.Warning,"Uyarı","Bu Sayfaya ERişme Yetkiniz Yok");
            return;
        }

        kullanicilar = (await _kullaniciRepo.GetAllAsync()).OrderBy(k => k.ID).ToList();
        kullaniciTipleri = (await DataService.GetKullaniciTipleri()).ToList();
    }

    //Kayıt olma popupunu açmak için kullanılır.
    private async Task OpenRegisterDialog()
    {
        if (_yetki != YetkiTipi.Yazma)
            return;
        var result = await DialogService.OpenAsync<KullaniciTnm>(" ", null, new DialogOptions { Width = "550px", Height = "auto" });

        if (result == true) 
        {
            kullanicilar = await _kullaniciRepo.GetAllAsync(); 
            StateHasChanged(); 
        }
    }

    //Düzenleme işleminin popupu açılması için kullanılır.
    private async Task OpenEditDialog(int id)
    {
        if (_yetki != YetkiTipi.Yazma)
            return;
        var result = await DialogService.OpenAsync<KullaniciTnm>(
             " ",
             new Dictionary<string, object>() { { "KullaniciId", id } },
             new DialogOptions() {Width = "550px", Height = "auto" }
         );

        if (result is User updatedUser)
        {
            var index = kullanicilar.FindIndex(k => k.ID == updatedUser.ID);
            if (index >= 0)
            {
                kullanicilar[index] = updatedUser;
            }
            else
            {
                kullanicilar.Add(updatedUser);
            }

            await kullaniciGrid.Reload();
            StateHasChanged();
        }
    }

    //Satır seçidiğinde yapılmasını istediğimiz şey yapılır.
    void OnRowSelect(User selectedKullanici)
    {
        Console.WriteLine($"Seçilen kullanıcı: {selectedKullanici.Adi} {selectedKullanici.Soyadi}");
    }

    //Silme işleminin onayı için kulanılır.
    private async Task ConfirmDelete(User user)
    {
        bool? result = await DialogService.Confirm(
            $"Kullanıcı {user.Adi} silinsin mi?",
            "Onay",
            new ConfirmOptions { OkButtonText = "Evet", CancelButtonText = "Hayır" }
        );

        if (result == true)
        {
            await Sil(user.ID);
        }
        else
        {
            notificationService.Notify(NotificationSeverity.Info, "Bilgi", "Silme İşleminiz İptal Edildi.");
        }
    }

    //Silme işlemi için kullanılr.
    private async Task Sil(int id)
    {
        if (_yetki != YetkiTipi.Yazma)
            return;
        var kullanici = kullanicilar.FirstOrDefault(k => k.ID == id);
        if (kullanici == null) return;

        var tumGorevler = await DataService.GetGorevler();
        var kullaniciyaAitAktifGorevler = tumGorevler
            .Where(g => g.Kullanici_ID == id && g.Aktif && g.DelUser == 0)
            .ToList();

        if (kullaniciyaAitAktifGorevler.Any())
        {
            var gorevSayisi = kullaniciyaAitAktifGorevler.Count;
            var mesaj = gorevSayisi == 1 
                ? "Bu kullanıcıya atanmış 1 aktif görev bulunmaktadır. Lütfen önce bu görevi silin veya pasif hale getirin."
                : $"Bu kullanıcıya atanmış {gorevSayisi} aktif görev bulunmaktadır. Lütfen önce bu görevleri silin veya pasif hale getirin.";
            
            notificationService.Notify(NotificationSeverity.Warning, "Uyarı", mesaj);
            return;
        }

        int currentUserId = await GetCurrentUserId(); 
        await _kullaniciRepo.DeleteAsync(kullanici.ID, currentUserId);

        kullanicilar = await _kullaniciRepo.GetAllAsync(); 
        await kullaniciGrid.Reload();

        notificationService.Notify(NotificationSeverity.Success, "Başarılı", "Kullanıcı silindi.");
    }

    //oturum açmış olan kullanıcının ID sini kimlik doğrulama bilgileri üzerinden almak için kullanılır.
    private async Task<int> GetCurrentUserId()
    {
        var authState = await girisSaglayici.GetAuthenticationStateAsync();
        var user = authState.User;

        if (user.Identity?.IsAuthenticated == true)
        {
            return int.Parse(user.FindFirst("UserId")?.Value ?? "0");
        }
        return 0; 
    }

    //bir kullanıcının aktif / pasif durumunu tek tıklamayla değiştirmek için kullanılır.
    private async Task ToggleDurum(User user)
    {
        if (_yetki != YetkiTipi.Yazma)
            return;
        user.Aktif = !user.Aktif;

        var sonuc = await _kullaniciRepo.UpdateAsync(user);
        if (sonuc)
        {
            var updatedUser = await _kullaniciRepo.GetByIDAsync(user.ID);

            var index = kullanicilar.FindIndex(k => k.ID == user.ID);
            if (index >= 0)
            {
                kullanicilar[index] = updatedUser;
            }
            notificationService.Notify(NotificationSeverity.Success, "Başarılı", "Durum Başarıyla Güncellendi.");
            StateHasChanged();
        }
        else
        {
            notificationService.Notify(NotificationSeverity.Error, "Hata", "Durum güncellenemedi.");
        }
    }

    //kullanıcının tip ID yi okunabilir bir kullanıcı tipi adına çevirmek için kullanılır.
    private string GetKullaniciTipAdi(int tipId)
    {
        if (tipId == 0 || kullaniciTipleri == null || !kullaniciTipleri.Any())
        {
            return "—";
        }

        var tip = kullaniciTipleri.FirstOrDefault(t => t.ID == tipId);
        return tip?.Adi ?? "—";
    }

    //Yetkiler popup unu açmak için kullanılır.
    private async Task  NavigateToYetki(int Id)
    {
       await DialogService.OpenAsync<KullaniciYetkileri>(
         "Kullanıcı Sayfa Yetkileri",
             new Dictionary<string, object>() { { "KullaniciId", Id } },
             new DialogOptions() { Width = "800px", Height = "auto" }
        );
    }

    //Mesaj gönderme buttonu için izin maili göndermek için kullanılır.
    private async Task IzinMailiGonder(int userId)
    {
        if (_yetki != YetkiTipi.Yazma)
            return;
        var u = kullanicilar.FirstOrDefault(x => x.ID == userId);
        if (u == null) return;

        var linkEvet = $"https://localhost:7014/onay?uid={userId}&ok=1";
        var linkHayir = $"https://localhost:7014/onay?uid={userId}&ok=0";

        await EpostaService.SendInviteMailAsync(u.EPosta, linkEvet, linkHayir);
    }

    //Göreve çift tıklanıldığında düzenleme popup unu açar.
    private async Task OnRowDoubleClick(DataGridRowMouseEventArgs<User> args)
    {
        await OpenEditDialog(args.Data.ID);
    }
}