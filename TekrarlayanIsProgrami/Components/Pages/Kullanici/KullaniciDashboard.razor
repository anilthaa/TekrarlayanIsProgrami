	//Aynı görevin kaç kişiye atandığını saymak için kullanılır.
	private int GetAtananKisiSayisi(ItemGorev gorev)
	{
		if (!gorev.Kilitli)
			return 0;

		return GorevListt.Where(g =>
			g.Kilitli &&
			g.Baslik == gorev.Baslik &&
			g.Kategori_ID == gorev.Kategori_ID &&
			g.BaslangicTarihi == gorev.BaslangicTarihi &&
			g.BitisTarihi == gorev.BitisTarihi &&
			g.DelUser == 0
		).Count();
	}

	//Dashboard görevlerim özet kartında atanan kişileri göstermek için kullanılan metot.
	private List<string> GetAtananKisiListesi(ItemGorev gorev)
	{
		var liste = GorevListt.Where(g =>
			g.Kilitli &&
			g.Baslik == gorev.Baslik &&
			g.Kategori_ID == gorev.Kategori_ID &&
			g.BaslangicTarihi == gorev.BaslangicTarihi &&
			g.BitisTarihi == gorev.BitisTarihi &&
			g.DelUser == 0
		)
		.Select(g => GetKullaniciAdi(g.Kullanici_ID))
		.ToList();

		return liste;
	}

	//Görev nesnesini alır.İçindeki Kullanici_ID’yi çıkarır.İsme çevirmek için alttaki metodu çağırır.
	private string GetTekKisiAdi(ItemGorev gorev)
	{
		return GetKullaniciAdi(gorev.Kullanici_ID);
	}

	//Kullanıcı listesinden ID’ye göre kullanıcıyı bulur.Bulamazsa "-" döner.Bulursa "Ad Soyad" döner.
	private string GetKullaniciAdi(int kullaniciId)
	{
		var user = kullaniciListesi.FirstOrDefault(x => x.ID == kullaniciId);

		if (user == null)
			return "-";

		return $"{user.Adi} {user.Soyadi}";
	}

	// standart tipindeki Kullanıcı dashboard undaki görevlerim özeti yerinde atayan kişinin beli olmasına yarayan bir metot.
	private MarkupString GetAtayanKullaniciAdi(int? creUserId)
	{
		Console.WriteLine($"CreUserId: {creUserId}");
		Console.WriteLine($"Kullanıcı sayısı: {kullaniciListesi.Count}");

		if (!creUserId.HasValue || creUserId.Value == 0)
			return (MarkupString)"—";

		var kullanici = kullaniciListesi.FirstOrDefault(x => x.ID == creUserId.Value);
		return kullanici != null
			? (MarkupString)($"{kullanici.Adi} {kullanici.Soyadi}")
			: (MarkupString)"-";

	}

	//Bir görevin üzerine tıklayınca görev listesinde olduğu tabin yerine götüren metot.
	int GorevinTabiniBul(ItemGorev g)
	{
		if (g.Kullanici_ID == currentUserId && g.Kilitli && !g.Tamamlandi && g.Aktif)
		{
			return 6;
		}

		if (g.BitisTarihi.HasValue && g.BitisTarihi.Value < DateTime.Now && !g.Tamamlandi)
		{
			return 3;
		}

		if (g.Tamamlandi)
		{
			return 2;
		}

		return 0;
	}

	//Dashboarddan üzerine tıklanan görevin belli olması için görev listesinde üstü boyalı gelmesine yarayan metot.
	void GorevSecildi(ItemGorev gorev)
	{
		var tab = GorevinTabiniBul(gorev);
		NavigationManager.NavigateTo($"/gorevler?tab={tab}&gorevId={gorev.ID}");
	}

