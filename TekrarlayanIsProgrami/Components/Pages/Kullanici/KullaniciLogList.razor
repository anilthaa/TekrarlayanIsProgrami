@page "/admin/kullanici-loglari"
@layout MainLayout
@attribute [Authorize]

<RadzenCard class="container mt-4" Style="z-index:2000 !important;">
    <h3 class="text-center mb-4" style="font-family:Calibri; font-weight:bold; ">Kullanıcı Hareketleri</h3>

    @if (isLoading)
    {
        <div class="text-center" style="display:flex; flex-direction:column; justify-content:center; align-items:center; padding:50px; text-align:center;">
            <RadzenProgressBar Value="100" ShowValue="false" Indeterminate="true" Style="width:220px;" />
            <p class="mt-2">Loglar yükleniyor...</p>
        </div>
    }
    else if (logList == null || !logList.Any())
    {
        <div class="text-center" style="padding:50px;">
            <p style="color:#7f8c8d; font-style:italic;">Henüz log kaydı bulunmamaktadır.</p>
        </div>
    }
    else
    {
        <RadzenDataGrid @ref="logGrid" Data="@logList" TItem="ItemKullaniciLog"
                        AllowPaging="true" PageSize="20" AllowSorting="true" AllowFiltering="true"
                        FilterCaseSensitivity="FilterCaseSensitivity.CaseInsensitive"
                        class="text-center align-middle compact-grid mobile-card-grid">
            <Columns>
                
                <RadzenDataGridColumn TItem="ItemKullaniciLog" Title="Kullanıcı" Width="200px" >
                    <Template Context="log">
                        @GetKullaniciAdi(log.Kullanici_ID)
                    </Template>
                </RadzenDataGridColumn>
                
                <RadzenDataGridColumn TItem="ItemKullaniciLog" Property="IslemTipi" Title="İşlem Tipi" Width="160px">
                    <Template Context="log">
                        @{
                            var islemTipi = log.IslemTipi?.Trim() ?? "";
                        }
                        @if (islemTipi.Equals("Giris", StringComparison.OrdinalIgnoreCase))
                        {
                            <RadzenBadge Text="Giriş" 
                                         Style="background-color:#2ecc71;color:white;padding:5px 10px;border-radius:10px;" />
                        }
                        else if (islemTipi.Equals("Cikis", StringComparison.OrdinalIgnoreCase))
                        {
                            <RadzenBadge Text="Çıkış" 
                                         Style="background-color:#e74c3c;color:white;padding:5px 10px;border-radius:10px;" />
                        }
                        else
                        {
                            <span>@log.IslemTipi</span>
                        }
                    </Template>
                </RadzenDataGridColumn>

                <RadzenDataGridColumn TItem="ItemKullaniciLog" Property="IslemTarihi" Title="İşlem Tarihi" Width="180px">
                    <Template Context="log">
                        @log.IslemTarihi.ToString("dd.MM.yyyy HH:mm:ss")
                    </Template>
                </RadzenDataGridColumn>

                <RadzenDataGridColumn TItem="ItemKullaniciLog" Property="Aciklama" Title="Açıklama" />
            </Columns>
        </RadzenDataGrid>
    }
</RadzenCard>

@code {
    private List<ItemKullaniciLog> logList = new();
    private RadzenDataGrid<ItemKullaniciLog>? logGrid;
    private bool isLoading = true;
    private Dictionary<int, string> kullaniciAdlari = new();
    private YetkiTipi _yetki;

    //sayfa ilk yüklendiğinde log (kayıt) verilerini getirmek için kullanılır.
    protected override async Task OnInitializedAsync()
    {
        _yetki = await PermissionService.GetCurrentUserYetkiAsync(10);
        if (_yetki == YetkiTipi.Gizli)
        {
            NavigationManager.NavigateTo("/yetkisiz");
            notificationService.Notify(NotificationSeverity.Warning, "Uyarı", "Bu Sayfaya ERişme Yetkiniz Yok");
            return;
        }
        await YukleLoglarAsync();
    }

    //kullanıcı loglarını yükleyip ekranda gösterilmeye hazır hale getirmek için kullanılır.
    private async Task YukleLoglarAsync()
    {
        try
        {
            isLoading = true;
            
            var loglar = await DataService.GetKullaniciLoglari();
            logList = loglar.ToList();
            
            
            var uniqueIslemTipleri = logList.Select(l => l.IslemTipi).Distinct().ToList();
            
            foreach (var log in logList.Take(5))
            {
                Console.WriteLine($"Log ID: {log.ID}, Kullanıcı ID: {log.Kullanici_ID}, IslemTipi: '{log.IslemTipi}', Tarih: {log.IslemTarihi}");
            }
            
            var kullanicilar = await _kullaniciRepo.GetAllAsync();
            kullaniciAdlari = kullanicilar.ToDictionary(k => k.ID, k => $"{k.Adi} {k.Soyadi}");
            
            isLoading = false;
            StateHasChanged();
        }
        catch (Exception ex)
        {
            notificationService.Notify(NotificationSeverity.Error, "Hata", $"Loglar yüklenirken bir hata oluştu: {ex.Message}");
            isLoading = false;
        }
    }

    //ullanıcı  ID yi ekranda gösterilecek okunabilir bir ada çevirmek için kullanılır.
    private string GetKullaniciAdi(int kullaniciId)
    {
        if (kullaniciAdlari.TryGetValue(kullaniciId, out var ad))
        {
            return ad;
        }
        return $"Kullanıcı ID: {kullaniciId}";
    }
    
}

