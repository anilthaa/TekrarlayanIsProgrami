@page "/kullanicilar"

@inject NavigationManager NavigationManager
<div class="container mt-4">
    <h2 class="text-center mb-4">Kullanıcılar Listesi</h2>

    <div class="text-end mb-3">
        <RadzenButton Text="Yeni Kullanıcı Ekle" style=" background-color:royalblue" Click='@YeniKullanici'></RadzenButton>
    </div>

    <table class="table table-striped table-bordered table-hover text-center align-middle">
        <thead class="table-dark">
            <tr>
                <th>Id</th>
                <th>Ad</th>
                <th>Soyad</th>
                <th>E-Posta</th>
                <th>Şifre</th>
                <th>Rol</th>
                <th>Durum</th>
                <th>İşlemler</th>
            </tr>
        </thead>
        <tbody>
            @if (kullanicilar != null && kullanicilar.Any())
            {
                @foreach (var k in kullanicilar)
                {
                    <tr>
                        <td>@k.ID</td>
                        <td>@k.Adi</td>
                        <td>@k.Soyadi</td>
                        <td>@k.EPosta</td>
                        <td>@k.Sifre</td>
                        <td>@k.KullaniciTip_ID</td>
                        <td>
                            @if (k.Aktif)
                            {
                                <span class="badge bg-success">Aktif</span>
                            }
                            else
                            {
                                <span class="badge bg-secondary">Pasif</span>
                            }
                        </td>
                        <td>
                            <RadzenButton Text="Düzenle" ButtonStyle="ButtonStyle.Success" Click="() =>Duzenle(k.ID)"></RadzenButton>
                            <RadzenButton Text="Sil" ButtonStyle="ButtonStyle.Warning" Click="() => Sil(k.ID)"></RadzenButton>
                        </td>
                    </tr>
                }
            }
            else
            {
                <tr>
                    <td colspan="8">Hiç kullanıcı bulunamadı.</td>
                </tr>
            }
        </tbody>
    </table>
</div>
@code {
    private List<User>? kullanicilar=new List<User>();

    protected override async Task OnInitializedAsync()
    {
        kullanicilar = await _kullaniciRepo.GetAllAsync();
    }

    private void Duzenle(int id)
    {
        // Düzenleme sayfasına yönlendirme
        NavigationManager.NavigateTo($"/kullanicilar/edit/{id}?geri=/kullanicilar");
    }

    private async void Sil(int id)
    {
        var kullanici = kullanicilar.FirstOrDefault(k => k.ID == id);
        if (kullanici == null) return;

        if (await Js.InvokeAsync<bool>("confirm", $"'{kullanici.Adi}' silinsin mi?"))
        {
            await _kullaniciRepo.DeleteAsync(kullanici.ID);
            kullanicilar = await _kullaniciRepo.GetAllAsync();
        }
    }

    private void YeniKullanici()
    {
        // Yeni kullanıcı ekleme sayfasına yönlendirme
        NavigationManager.NavigateTo("/GirisYap");
    }

}