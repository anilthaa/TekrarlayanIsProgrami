@code {
    private bool _handled;

    // İlk anda NotAuthorized tetiklense bile önce storage'dan auth hydrate denenir.
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender || _handled)
        {
            return;
        }

        _handled = true;

        try
        {
            await girisSaglayici.HydrateFromStorageAsync();
            var authState = await girisSaglayici.GetAuthenticationStateAsync();

            if (authState.User?.Identity?.IsAuthenticated == true)
            {
                NavigationManager.NavigateTo(NavigationManager.Uri, forceLoad: false);
                return;
            }
        }
        catch
        {
        }

        var returnUrl = Uri.EscapeDataString(NavigationManager.Uri);
        NavigationManager.NavigateTo($"/GirisYap?returnUrl={returnUrl}", forceLoad: false);
    }
}
