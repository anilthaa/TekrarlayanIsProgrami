@layout MainLayout
@if (kullanici == null)
{
	<RadzenCard class="text-center mt-5">
		<RadzenLoader Visible="true" Size="LoaderSize.Large" />
		<p class="mt-2">Kullanıcı bilgileri yükleniyor...</p>
	</RadzenCard>
}
else
{
	<RadzenCard class="max-width:600px; margin:auto; padding:20px;">
		
			<h3 class="card-title text-center mb-4">Kullanıcı Düzenle</h3>
			<RadzenTemplateForm Data="@kullanici" TItem="User" Submit="@Kaydet">
				<RadzenFieldset Text="Bilgiler" Style="margin-bottom:15px;">
					<DataAnnotationsValidator />
					<RadzenLabel class="form-label">Adı</RadzenLabel>
					<RadzenTextBox class="form-control" @bind-Value="kullanici.Adi" placeholder="Adı girin" />
					<RadzenLabel class="form-label">Soyadı</RadzenLabel>
					<RadzenTextBox class="form-control" @bind-Value="kullanici.Soyadi" placeholder="Soyadı girin" />
					<RadzenLabel class="form-label">E-Posta</RadzenLabel>
					<RadzenTextBox class="form-control" @bind-Value="kullanici.EPosta" placeholder="E-Posta girin" />
					<RadzenLabel class="form-label">Şifre</RadzenLabel>
					<RadzenTextBox type="password" class="form-control" @bind-Value="kullanici.Sifre" placeholder="Şifreyi girin" />
					<RadzenCard class="btn-group">
						<RadzenButton Text="Kaydet" Icon="save" Click="@Kaydet" Style="width:30%; margin:auto;" class="radzen-button" Type="submit"></RadzenButton>
						<RadzenButton Text="İptal" Icon="cancel" Click="@Iptal" Style="width:30%; margin:auto;" class="radzen-button"></RadzenButton>
					</RadzenCard>
				</RadzenFieldset>
			</RadzenTemplateForm>
		
	</RadzenCard>
}
@code {
	[Parameter]
	public int id { get; set; }

	// 1️⃣ Her zaman null olmayan bir nesne oluştur
	private User kullanici = new User();

	protected override async Task OnInitializedAsync()
	{
		kullanici = await _kullaniciRepo.GetByIDAsync(id) ?? new User();
		var uri = NavigationManager.ToAbsoluteUri(NavigationManager.Uri);
		if (QueryHelpers.ParseQuery(uri.Query).TryGetValue("geri", out var geri))
		{
			geriUrl = geri;
		}
	}

	private async Task Kaydet()
	{
		// ID kontrolü yap
		if (kullanici.ID == 0)
		{
			notificationService.Notify(NotificationSeverity.Error, "Hata", "Kullanıcı bulunamadı.");
			return;
		}

		// Console.WriteLine($"Güncellenen ID: {kullanici.ID}");
		bool sonuc = await _kullaniciRepo.UpdateAsync(kullanici);
		if (sonuc)
		{
			kullanici = await _kullaniciRepo.GetByIDAsync(id);
			notificationService.Notify(NotificationSeverity.Success, "Güncelleme Başarılı.");
			NavigationManager.NavigateTo("/kullanicilar");
		}
		else
		{
			notificationService.Notify(NotificationSeverity.Error, "Güncelleme Başarısız...");
		}
	}

	private void Iptal()
	{
		NavigationManager.NavigateTo(geriUrl);
	}
	private string geriUrl = "/kullanicilar";


}