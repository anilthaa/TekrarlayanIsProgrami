				</div>
			}
		</RadzenCard>

		<RadzenCard Style="box-shadow:0 4px 10px rgba(0, 0, 0, 0.1); border-left:5px solid #16a085; margin-top:20px;">
			<h5 style="font-weight:600; margin-bottom:10px; color:#16a085;">Görevlerim</h5>

			<RadzenDataGrid Data="@kullaniciGorevler"
							TItem="ItemGorev"
							AllowPaging="true"
							PageSize="5"
							RowSelect="GorevSecildi"
							AllowSorting="true"
							class="radzen-grid">
				<Columns>
					<RadzenDataGridColumn Title="No" Width="100px">
						<Template Context="g">
							@(kullaniciGorevler.ToList().IndexOf(g) + 1)
						</Template>
					</RadzenDataGridColumn>
					<RadzenDataGridColumn TItem="ItemGorev" Property="Baslik" Title="Görev" />
					<RadzenDataGridColumn TItem="ItemGorev" Property="BitisTarihi" Title="Bitiş"
										  FormatString="{0:dd.MM.yyyy HH:mm}" />

					<RadzenDataGridColumn TItem="ItemGorev" Property="Tamamlandi" Title="Durum">
						<Template Context="item">
							<span style="@($"font-size:12px; padding:3px 8px; display:inline-block; text-align:center; width:90px; border-radius:6px; background-color:{(item.Tamamlandi ? "#4caf50" : "#e53935")}; color:white;")">
								@(item.Tamamlandi ? "Tamamlandı" : "Devam Ediyor")
							</span>
