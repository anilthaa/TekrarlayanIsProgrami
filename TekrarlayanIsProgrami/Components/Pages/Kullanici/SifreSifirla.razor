@page "/sifre-sifirla"
@page "/sifre-sifirla/{token}"
@layout EmptyLayout
@attribute [AllowAnonymous]

<RadzenCard Class="mx-auto mt-5 p-4" Style="max-width:400px;">
    <h3 class="text-center mb-4">Yeni Şifre Belirle</h3>
    <EditForm Model="@model" OnValidSubmit="@OnSubmit">
        <div class="mb-3" style="position:relative;">
            <RadzenTextBox @bind-Value="model.YeniSifre" type="@InputType" Style="width:100%; padding-right:40px;" Placeholder="Yeni Şifre" />
            <button type="button"
                    @onclick="TogglePassword"
                    style="position:absolute; right:8px; top:50%; transform:translateY(-50%); border:none; background:transparent; cursor:pointer;">
                <RadzenIcon Icon="@Icon" Style="color:gray;" />
            </button>
        </div>

        <div class="mb-3" style="position:relative;">
            <RadzenTextBox @bind-Value="model.YeniSifreTekrar" type="@InputType2" Style="width:100%; padding-right:40px;" Placeholder="Yeni Şifre Tekrar" />
            <button type="button"
                    @onclick="TogglePasswordAgain"
                    style="position:absolute; right:8px; top:50%; transform:translateY(-50%); border:none; background:transparent; cursor:pointer;">
                <RadzenIcon Icon="@Icon2" Style="color:gray;" />
            </button>
        </div>

        <RadzenButton Text="Şifreyi Kaydet"  ButtonType="ButtonType.Submit" Class="girisButton" Style="width:100%;height:auto;" />
    </EditForm>
</RadzenCard>
@code {
    [Inject] private UrlSigningService urlSigningService { get; set; } = null!;
    [Parameter]
    [SupplyParameterFromQuery]
    public string token{ get; set; }
    private SifreSifirlaModel model = new();
    private string bilgiMesaji;
    public User kullanici = new User();
    private string InputType { get; set; } = "password";
    private string Icon { get; set; } = "visibility_off";
    private string InputType2 { get; set; } = "password";
    private string Icon2 { get; set; } = "visibility_off";
    public class SifreSifirlaModel
    {
        public string YeniSifre { get; set; }
        public string YeniSifreTekrar { get; set; }
    }

    //sayfa yüklendiğinde şifre sıfırlama token’ını doğrular ve hazırlar.
    protected override async Task OnInitializedAsync()
    {
        try
        {
            var urlParameters = urlSigningService.ParseSignedUrl(NavigationManager.Uri, out bool valid);
            if (!valid || !urlParameters.ContainsKey("token"))
            {
                notificationService.Notify(NotificationSeverity.Error, "Hata", "Geçersiz veya değiştirilmiş link!");
                token = null;
                return;
            }
            
            token = urlParameters["token"];
            
            if (string.IsNullOrEmpty(token))
            {
                notificationService.Notify(NotificationSeverity.Warning, "Token eksik veya geçersiz.");
                token = null;
                return;
            }
            
            var kullanicii = await _kullaniciRepo.GetByTokenAsync(token);
            if (kullanicii == null || kullanicii.ResetTokenExpiry <= DateTime.UtcNow)
            {
                notificationService.Notify(NotificationSeverity.Info, "Süreniz Dolmuştur!");
                token = null;
            }
        }
        catch
        {
            notificationService.Notify(NotificationSeverity.Error, "Hata", "Link doğrulanırken bir hata oluştu.");
            token = null;
        }
    }

    //şifre sıfırlama işlemini tamamlar.Yeni şifreyi kaydeder.
    private async Task OnSubmit()
    {
        if (string.IsNullOrEmpty(token))
        {
            notificationService.Notify(NotificationSeverity.Warning, "Token boş!");
            return;
        }

        if(kullanici.Sifre==model.YeniSifre)
        {
            return;
        }

        if (model.YeniSifre!=model.YeniSifreTekrar)
        {
            notificationService.Notify(NotificationSeverity.Error, "Hata", "Şifre ile Tekrar Şifre Aynı Olmak Zorunda!");
            return;
        }

        bool basarili = await _kullaniciRepo.SifreGuncelle(token, model.YeniSifre);
        if (basarili)
        {
            notificationService.Notify(NotificationSeverity.Success, "Başarılı", "Şifreniz Başarıyla Değiştirildi.");
            await Task.Delay(1000);
            NavigationManager.NavigateTo("/GirisYap");
        }
        else
        {
            notificationService.Notify(NotificationSeverity.Error, "Başarısız", "Token geçersiz veya şifre değiştirilemedi.");
        }
    }

    //Textbox ta şifrenin göz ikonu için kullanılır.
    void TogglePassword()
    {
        if (InputType == "password")
        {
            InputType = "text";
            Icon = "visibility"; 
        }
        else
        {
            InputType = "password";
            Icon = "visibility_off";
        }
    }

    //Textbox ta şifrenin göz ikonu için kullanılır.
    void TogglePasswordAgain()
    {
        if (InputType2 == "password")
        {
            InputType2 = "text";
            Icon2 = "visibility"; 
        }
        else
        {
            InputType2 = "password";
            Icon2 = "visibility_off";
        }
    }
}