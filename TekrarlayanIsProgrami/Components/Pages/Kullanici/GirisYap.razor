@page "/GirisYap"
@page "/"
@layout EmptyLayout

<div class="login-container @(isRegisterActive ? "slide-active" : "")">
	<div class="form login-form">
		<EditForm Model="@loginModel" OnValidSubmit="() => OnLogin(loginModel)">
			<h2 style="text-align:center; font-family:serif;">Giriş Yap</h2>
			<p style="color:rebeccapurple;">Lütfen bilgilerinizi girin</p>
			<RadzenFormField Text="E-posta" Style="width:100%;">
			<RadzenTextBox @bind-Value="loginModel.E_Posta" />
			</RadzenFormField>
			<RadzenFormField Text="Şifre" Style="width:100%; margin-top:9px;">
			<RadzenTextBox @bind-Value="loginModel.Sifre" type="@InputType2"/>
				<button type="button" @onclick="@TogglePasswordAgain" style=" position:absolute; right:2px; top:8px; transform:translate(-50%); border:none; background:transparent;">
				<RadzenIcon Icon="@Icon2" Style="color:gray;"></RadzenIcon>
			</button>
			</RadzenFormField>
			<a href="javascript:void(0);" @onclick="OpenSifremiUnuttumDialog" @onclick:preventDefault="true" class="link-sifreUnuttum">Şifremi Unuttum?</a>
			@if (!isSaving)
			{
				<RadzenButton ButtonType="ButtonType.Submit" Style="width:100%; margin-top:20px;" Text="Giriş Yap" class="girisButton" Icon="login"></RadzenButton>
			}
			else
			{
				<div style="width:100%; display:flex; justify-content:center; align-items:center; padding:15px 0;">
					<div class="spinner-border" role="status" style="width:1.8rem; height:1.8rem">
						<span class="visually-hidden">Yükleniyor...</span>
					</div>
				</div>
			}

		</EditForm>
	</div>

	<div class="form register-form">
		<EditForm Model="@newUser" OnValidSubmit="@OnSubmit">
			<DataAnnotationsValidator />
			<div class="row">
				<h2 style="text-align:center;font-family:serif">Hesap Oluştur</h2>
				<p style="color:rebeccapurple; margin-left:5px; margin-bottom:5px;">Lütfen bilgilerinizi girin</p>
				<div class="col-sm-12">
					<RadzenFormField Text="Ad" Style="width:85%; margin-left:27px;">
						<RadzenTextBox @bind-Value="newUser.Adi"  />
					</RadzenFormField>
					<ValidationMessage For="@(() => newUser.Adi)" />
				</div>
				<div class="col-sm-12">
					<RadzenFormField Text="Soyad" Style="width:85%; margin-left:27px; margin-top:4px;">
						<RadzenTextBox @bind-Value="newUser.Soyadi" />
					</RadzenFormField>
					<ValidationMessage For="@(() => newUser.Soyadi)" />
				</div>
				<div class="col-lg-12">
					<RadzenFormField Text="E-posta" Style="width:85%; margin-left:27px; margin-top:4px;">
						<RadzenTextBox @bind-Value="newUser.EPosta" />
					</RadzenFormField>
					<ValidationMessage For="@(() => newUser.EPosta)" />
				</div>
				<div class="col-sm-12">
					<RadzenFormField Text="Şifre" Style="width:85%; margin-left:27px; margin-top:4px;">
							<RadzenTextBox @bind-Value="newUser.Sifre" type="@InputType" />
						<button type="button" @onclick="@TogglePassword" style="position:absolute; right:2px; top:8px; transform:translate(-50%); border:none; background:transparent;">
								<RadzenIcon Icon="@Icon" Style="color:gray;"></RadzenIcon>
							</button>
					</RadzenFormField>
					<ValidationMessage For="@(() => newUser.Sifre)" />
				</div>
				<div class="col-sm-12">
					<RadzenFormField Text="Şifre Tekrar" Style="width:85%; margin-left:27px; margin-top:4px;">
						<RadzenPassword @bind-Value="newUser.SifreTekrar"Type="password"></RadzenPassword>
					</RadzenFormField>
					<ValidationMessage For="@(() => newUser.SifreTekrar)" />
				</div>
				<RadzenButton Style="width:100%; margin-top:20px;" class="girisButton" Text="Kayıt Ol" ButtonStyle="ButtonStyle.Info" ButtonType="ButtonType.Submit"></RadzenButton>
			</div>
		</EditForm>
	</div>
	<div class="slider-panel">
		<div class="slider-content">
			@if (!isRegisterActive)
			{
				<h3>Merhaba!</h3>
				<p>Tüm site özelliklerini kullanmak için kişisel bilgilerinizle kayıt olun.</p>
				<RadzenButton Click="@(() => isRegisterActive = true)" Text="KAYIT OL" Style="background-color: white;color:rebeccapurple; margin-top:10px;" />
			}
			else
			{
				<h3>Tekrar Hoş Geldiniz!</h3>
				<p>Zaten hesabınız var mı? Giriş yapın.</p>
				<RadzenButton Click="@(() => isRegisterActive = false)" Text="GİRİŞ YAP" Style="background-color: white; color:rebeccapurple; margin-top:10px;" />
			}
		</div>
	</div>
</div>
@code {
	[Inject] private UrlSigningService urlSigningService { get; set; } = null!;
	bool isRegisterActive = false;
	private LoginModel loginModel = new LoginModel();
	private bool isSaving = false;
	private string InputType { get; set; } = "password";
	private string Icon { get; set; } = "visibility_off";
	private string InputType2 { get; set; } = "password";
	private string Icon2 { get; set; } = "visibility_off";
	public class LoginModel
	{
		public string E_Posta { get; set; }
		public string Sifre { get; set; }
	}

	private User newUser = new User
	{
		CreDate = DateTime.Now,
		Aktif = true
	};
	//Giriş işlemini gerçekleştiren metot.
	async Task OnLogin(LoginModel model)
	{
		isSaving = true;
		StateHasChanged();
		var result = await girisSaglayici.GirisYapAsync(model.E_Posta, model.Sifre);
		if (result.Basarili) 
		{
			if (result.User != null)
			{
				await girisSaglayici.MarkUserAsAuthenticated(result.User);

				try
				{
					var log = new ItemKullaniciLog
					{
						Kullanici_ID = result.User.ID,
						IslemTipi = "Giris",
						IslemTarihi = DateTime.Now,
						Aciklama = "Kullanıcı giriş yaptı",
						CreUser = result.User.ID
					};


					var logResult = await DataService.SetKullaniciLog(log);

					if (logResult.Data > 0)
					{
						Console.WriteLine("Log başarıyla kaydedildi");
					}
					else
					{
						Console.WriteLine("UYARI: Log kaydı başarısız - ID 0 döndü");
					}
				}
				catch (Exception ex)
				{
					
				}
			}
			
			var storedToken = await Js.InvokeAsync<string>("localStorage.getItem", "jwtToken");
			if (string.IsNullOrEmpty(storedToken) && !string.IsNullOrEmpty(result.Token))
			{
				await Js.InvokeVoidAsync("localStorage.setItem", "jwtToken", result.Token);
			}

			await PermissionService.RefreshAsync();
			isSaving=false;
			StateHasChanged();
			notificationService.Notify(NotificationSeverity.Success, "Hoşgeldiniz", result.Mesaj);

			await Task.Delay(500);

			var uri = NavigationManager.ToAbsoluteUri(NavigationManager.Uri);
			var queryParams = Microsoft.AspNetCore.WebUtilities.QueryHelpers.ParseQuery(uri.Query);
			var returnUrl = queryParams.ContainsKey("returnUrl") ? queryParams["returnUrl"].ToString() : null;

			if (!string.IsNullOrEmpty(returnUrl))
			{
				try
				{
					var returnUri = new Uri(returnUrl);
					var returnQuery = Microsoft.AspNetCore.WebUtilities.QueryHelpers.ParseQuery(returnUri.Query);

					if (returnQuery.ContainsKey("token"))
					{
						var urlParams = urlSigningService.ParseSignedUrl(returnUrl, out bool valid);
						if (valid && urlParams.ContainsKey("userId") && int.TryParse(urlParams["userId"], out int hedefUserId))
						{
							if (result.User != null && result.User.ID != hedefUserId)
							{
								notificationService.Notify(NotificationSeverity.Warning, "Uyarı", "Bu link başka bir kullanıcıya aittir. Lütfen doğru hesap ile giriş yapın.");
								await girisSaglayici.CikisYapAsync();
								await PermissionService.RefreshAsync();
								NavigationManager.NavigateTo("/GirisYap", forceLoad: true);
								return;
							}
						}
					}
				}
				catch
				{
					
				}

				NavigationManager.NavigateTo(returnUrl, forceLoad: true);
			}
			else
			{
				NavigationManager.NavigateTo("/dashboard", forceLoad: true);
			}
		}
		else
		{
			notificationService.Notify(NotificationSeverity.Error, "Hata", result.Mesaj);
		}
		isSaving=false;
		StateHasChanged();
	}

	//Kayıt işlemini gerçekleştiren metot.
	private async Task OnSubmit()
	{
		if (!EpostaGecerliMi(newUser.EPosta))
		{
			notificationService.Notify(NotificationSeverity.Error,"Hata", "E-posta Yalnızca gmail.com veya hotmail.com Olmalıdır.");
			return;
		}

		if (newUser.Sifre != newUser.SifreTekrar)
		{
		    notificationService.Notify(NotificationSeverity.Error, "Hata", "Şifre ile Tekrar Şifre Aynı Olmak Zorunda!");
			return;   
		}
		var currentUser = await girisSaglayici.GetCurrentUserAsync();
        int creUserId = currentUser?.ID ?? 1; 
        newUser.CreUser = creUserId; 

		var result = await girisSaglayici.KayitOlAsync(newUser);
	    if (result.Basarili)
		{
			notificationService.Notify(NotificationSeverity.Success, "Başarılı" ,result.Mesaj);
			NavigationManager.NavigateTo("/GirisYap");
		}
		else
		{
			notificationService.Notify(NotificationSeverity.Error, "Hata",result.Mesaj);
		}
	}

	//Kayıt sırasında kullanıcı @ yazmayıp yada @ ten sonra random şeyler yazarsa hata verir.
	private bool EpostaGecerliMi(string eposta)
	{
		if (string.IsNullOrWhiteSpace(eposta))
			return false;

		var desen = @"^[\w\.-]+@(gmail\.com|hotmail\.com)$";
		return Regex.IsMatch(eposta, desen, RegexOptions.IgnoreCase);
	}

	//Şifremi unuttum kısmının açılması için kullanılıyor.
	private async Task OpenSifremiUnuttumDialog()
	{
		try
		{
			await DialogService.OpenAsync<SifremiUnuttum>("Şifremi Unuttum", 
				new Dictionary<string, object>(), 
				new DialogOptions { Width = "450px", Height = "auto" });
		}
		catch (Exception ex)
		{
			Console.WriteLine($"Dialog açılırken hata: {ex.Message}");
			notificationService.Notify(NotificationSeverity.Error, "Hata", "Dialog açılırken bir hata oluştu.");
		}
	}

	//TextBoxlarda göz ikonu için kullanılıyor.
	void TogglePassword()
	{
		if (InputType == "password")
		{
			InputType = "text";
			Icon = "visibility"; 
		}
		else
		{
			InputType = "password";
			Icon = "visibility_off";
		}
	}

	//TextBoxlarda göz ikonu için kullanılıyor.
	void TogglePasswordAgain()
	{
		if (InputType2 == "password")
		{
			InputType2 = "text";
			Icon2 = "visibility"; 
		}
		else
		{
			InputType2 = "password";
			Icon2 = "visibility_off";
		}
	}
}