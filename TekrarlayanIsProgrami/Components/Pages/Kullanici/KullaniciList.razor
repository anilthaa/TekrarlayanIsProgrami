@page "/kullanicilar"
@layout MainLayout
@* @attribute [Authorize] *@
@*[Authorize(Roles = "Admin")] belirli roller erişebildiğini bellitiyoruz.*@ 
<RadzenDialog></RadzenDialog>

<RadzenCard class="container mt-4 " Style="z-index:2000 !important;">
    <h2 class="text-center mb-4">Kullanıcılar Listesi</h2>

    <RadzenCard style="margin-left:950px; margin-bottom:3px;">
      
        <RadzenButton Text="Yeni Kullanıcı Ekle" Style="background-color:royalblue;" Click="@OpenRegisterDialog"> </RadzenButton>
    </RadzenCard>

    <RadzenDataGrid @ref="kullaniciGrid" Data="@kullanicilar" Property="Name"  TItem="User" RowSelect="@OnRowSelect"
                    AllowPaging="true" PageSize="10" AllowSorting="true" AllowFiltering="true"
                    FilterCaseSensitivity="FilterCaseSensitivity.CaseInsensitive"
                    class="text-center align-middle">

        <Columns>
            <RadzenDataGridColumn TItem="User" Property="ID" Title="Id" Width="50px" />
            <RadzenDataGridColumn TItem="User" Property="Adi" Title="Ad" />
            <RadzenDataGridColumn TItem="User" Property="Soyadi" Title="Soyad" />
            <RadzenDataGridColumn TItem="User" Property="EPosta" Title="E-Posta" />
            <RadzenDataGridColumn TItem="User" Property="Sifre" Title="Şifre" />
            <RadzenDataGridColumn TItem="User" Property="KullaniciTip_ID" Title="Rol" />

            <RadzenDataGridColumn TItem="User" Title="Durum">
                <Template Context="k">
                    <span style="cursor:pointer;" @onclick="() => ToggleDurum(k)">
                        <RadzenBadge Text="@(k.Aktif ? "Aktif" : "Pasif")"
                                     Style="@(k.Aktif
                                                 ? "background-color:#3498db;color:white;padding:5px 10px;border-radius:10px;"
                                                 : "background-color:red;color:white;padding:5px 10px;border-radius:10px;")" />
                    </span>
                </Template>
            </RadzenDataGridColumn>

            <RadzenDataGridColumn TItem="User" Title="İşlemler" Width="180px">
                <Template Context="user">
                    <RadzenButton ButtonStyle="ButtonStyle.Success" Icon="edit" Size="ButtonSize.Small" Click="@(()=>OpenEditDialog(user.ID))" Style="margin-right:5px;" />
                    <RadzenButton ButtonStyle="ButtonStyle.Danger" Icon="delete" Size="ButtonSize.Small" Click="@(async () => await ConfirmDelete(user))" />
                </Template>
            </RadzenDataGridColumn>
        </Columns>

    </RadzenDataGrid>
</RadzenCard>
@code {
    private List<User>? kullanicilar=new List<User>();
    private RadzenDataGrid<User> kullaniciGrid;
    protected override async Task OnInitializedAsync()
    {
        kullanicilar = await _kullaniciRepo.GetAllAsync();
    }
    //Popuplar.
    private async Task OpenRegisterDialog()
    {
        var result = await DialogService.OpenAsync<KayitOl>(" ", null, new DialogOptions { Width = "600px", Height = "auto" });

        if (result == true) 
        {
            kullanicilar = await _kullaniciRepo.GetAllAsync(); 
            StateHasChanged(); 
        }
    }
    [Parameter]
    public int KullaniciId { get; set; }
    bool isDialogOpen{ get; set; }

    private async Task OpenEditDialog(int id)
    {
         await DialogService.OpenAsync<KullaniciTnm>(
              " ",
              new Dictionary<string, object>() { { "KullaniciId", id } },
              new DialogOptions() {Width = "600px", Height = "auto" }
          );
    }
    //

    void OnRowSelect(User selectedKullanici)
    {
        Console.WriteLine($"Seçilen kullanıcı: {selectedKullanici.Adi} {selectedKullanici.Soyadi}");
    }
    //Silme İşlemi.
    private async Task ConfirmDelete(User user)
    {
        bool? result = await DialogService.Confirm(
            $"Kullanıcı {user.Adi} silinsin mi?",
            "Onay",
            new ConfirmOptions { OkButtonText = "Evet", CancelButtonText = "Hayır" }
        );

        if (result == true)
        {
            await Sil(user.ID);
        }
        else
        {
            notificationService.Notify(NotificationSeverity.Info, "Bilgi", "Silme İşleminiz İptal Edildi.");
        }
    }

    private async Task Sil(int id)
    {
        var kullanici = kullanicilar.FirstOrDefault(k => k.ID == id);
        if (kullanici == null) return;

        await _kullaniciRepo.DeleteAsync(kullanici.ID);
        kullanicilar = await _kullaniciRepo.GetAllAsync();
        StateHasChanged(); 
    }
    //
    //Aktif-Pasif
    private void ToggleDurum(User user)
    {
        user.Aktif = !user.Aktif;
         _kullaniciRepo.UpdateAsync(user);
        StateHasChanged();
    }
}