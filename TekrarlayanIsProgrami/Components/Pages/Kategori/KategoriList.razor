@page "/Kategori"
@layout MainLayout
@attribute [Authorize]
<RadzenCard Style="margin:20px;">
	<h3>Kategori Listesi</h3>

	<RadzenButton Text="Yeni Kategori" Icon="add_circle"
				  Style="margin-bottom:15px; background:#3498db; color:white"
				  Click="@Ekle" />

	
	@if (DataList == null || !DataList.Any())
	{
		<p>Veri yükleniyor... veya veri bulunamadı.</p>
	}
	else
	{
		<RadzenDataGrid TItem="ItemKategori" Data="@DataList" @ref="GrdData"
						RowDoubleClick="@OnRowDoubleClick"
						AllowPaging="true" PageSize="20"
						AllowSorting="true" AllowFiltering="true">
			<Columns>
				<RadzenDataGridColumn TItem="ItemKategori" Property="ID" Title="ID" Width="70px" />
				<RadzenDataGridColumn TItem="ItemKategori" Property="Adi" Title="Kategori Adı" />
				<RadzenDataGridColumn TItem="ItemKategori" Title="İşlemler" Width="150px">
					<Template Context="data">
						<RadzenButton Icon="edit" Size="ButtonSize.Small" Style="margin-right:5px"
									  Click="@(() => Duzenle(data))" ButtonStyle="ButtonStyle.Success" />
						<RadzenButton Icon="delete" Size="ButtonSize.Small" ButtonStyle="ButtonStyle.Danger"
									  Click="@(() => Sil(data))" />
					</Template>
				</RadzenDataGridColumn>
			</Columns>
		</RadzenDataGrid>
	}
</RadzenCard>

@code {
	private List<ItemKategori> DataList = new();
	private RadzenDataGrid<ItemKategori>? GrdData;

	protected override async Task OnInitializedAsync()
	{
		await YukleDataAsync();

	}

	private async Task YukleDataAsync()
	{
		try
		{
			DataList = (await DataService.GetKategori()).ToList();
			Console.WriteLine($"Veri yüklendi: {DataList.Count} kategori.");

			StateHasChanged();
		}
		catch (Exception ex)
		{
			Console.WriteLine($"Veri yükleme hatası: {ex.Message}");
			notificationService.Notify(NotificationSeverity.Error, "Hata", $"Veri yüklenemedi: {ex.Message}");
			DataList = new();
		}
	}

	private async Task Ekle()
	{
		try
		{
			if (DialogService==null)
			{
				throw new InvalidOperationException("DialogService inject edilemedi");
			}
			var newItem = new ItemKategori 
			{ 
				ID=0,
				CreUser = 1 ,
				UpdUser=0,
				DelUser=0
			};

			var dialogResult = await DialogService.OpenAsync<KategoriTnm>("Kategori Ekle",
				new Dictionary<string, object> { { "ItemData", newItem } }, new DialogOptions { Width = "500px", Height = "300px" });
			if (dialogResult is ItemKategori result && result != null)
			{
				DataList.Insert(0, result);
				if (GrdData!=null)
				{
					await GrdData.Reload();
				}

				StateHasChanged();
				notificationService.Notify(NotificationSeverity.Success, "Başarılı", "Kategori eklendi!");
			}

		}
		catch (Exception ex)
		{
			Console.WriteLine($"Ekleme hatası: {ex.Message}");
			notificationService.Notify(NotificationSeverity.Error, "Hata", $"Ekleme sırasında hata: {ex.Message}");
		}
	}

	private async Task Duzenle(ItemKategori item)
	{
		item.UpdUser = 1;
		ItemKategori result = await DialogService.OpenAsync<KategoriTnm>("Kategori Düzenle",
			new Dictionary<string, object> { { "ItemData", item } },
			new DialogOptions { Width = "500px", Height = "300px" });
		if (result != null)
		{
			var index = DataList.FindIndex(x => x.ID == result.ID);
			if (index >= 0)
			{
				DataList[index] = result;
			}
			await GrdData.Reload();
			StateHasChanged();

		}
	}

	private async Task Sil(ItemKategori item)
	{
		bool? onay = await DialogService.Confirm("Silmek istediğinize emin misiniz?",
			"Onay", new ConfirmOptions { OkButtonText = "Evet", CancelButtonText = "Hayır" });

		if (onay == true)
		{
			item.DelUser = 1;
			var wsCvp = await DataService.SetKategori(item);
			if (wsCvp.Data > 0)
			{
				DataList.Remove(item);
				await GrdData.Reload();
				StateHasChanged();
				notificationService.Notify(NotificationSeverity.Success, "Başarılı", "Kategori Başarıyla Silindi!");
			}
			else
			{
				notificationService.Notify(NotificationSeverity.Error, "Hata", "Ekleme İşleminiz Başarısız.");
			}
		}
		else
		{
			notificationService.Notify(NotificationSeverity.Info, "Bilgi", "Silme İşleminiz İptal Edildi.");
		}
	}

	private async Task OnRowDoubleClick(DataGridRowMouseEventArgs<ItemKategori> args)
	{
		await Duzenle(args.Data);
	}
}
