	private MarkupString GetAtayanKullaniciAdi(int? creUserId)
	{
		Console.WriteLine($"CreUserId: {creUserId}");
		Console.WriteLine($"Kullanıcı sayısı: {TumKullanicilar.Count}");

		if (!creUserId.HasValue || creUserId.Value == 0)
			return (MarkupString)"—";

		var kullanici = TumKullanicilar.FirstOrDefault(x => x.ID == creUserId.Value);
		return kullanici != null
			? (MarkupString)($"{kullanici.Adi} {kullanici.Soyadi}")
			: (MarkupString)"-";

	}
