<RadzenCard Style="padding:20px;">
	<RadzenTemplateForm TItem="ItemKategori" Data="@ItemData" Submit="@OnSubmit">
		<ChildContent>
			<RadzenLabel Text="Kategori Adı" Component="Adi"></RadzenLabel>
			<RadzenTextBox @bind-Value="ItemData.Adi" Name="Adi" Style="width:100%; margin-bottom:15px;"></RadzenTextBox>

			<div style="text-align:right;">
				<RadzenButton Text="Kaydet" ButtonType="ButtonType.Submit" Style="margin-right:10px; background:#27ae60; color:white"></RadzenButton>
				<RadzenButton Text="İptal" Click="Iptal" Style="background:#e74c3c; color:white"></RadzenButton>
			</div>
		</ChildContent>
	</RadzenTemplateForm>
</RadzenCard>

@code {
	[Parameter] public ItemKategori ItemData { get; set; }

	private async Task OnSubmit(ItemKategori item)
	{		
		var wsCvp = DataService.SetKategori(item);

		if (wsCvp.SonucKodu == 0)
			DialogService.Close(item);
		else
			DialogService.Alert("Hata Oluştu.");
	}

	private async Task Iptal()
	{
		DialogService.Close(false);
	}
}
