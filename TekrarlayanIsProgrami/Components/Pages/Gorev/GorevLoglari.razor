@page "/admin/gorev-loglari"
@layout MainLayout
@attribute [Authorize]

<RadzenCard class="container mt-4" Style="z-index:2000 !important;">
    <h3 class="text-center mb-4" style="font-family:Calibri; font-weight:bold;">Görev Hareketleri</h3>

    @if (isLoading)
    {
        <div class="text-center" style="display:flex; flex-direction:column; justify-content:center; align-items:center; padding:50px; text-align:center;">
            <RadzenProgressBar Value="100" ShowValue="false" Indeterminate="true" Style="width:220px;" />
            <p class="mt-2">Loglar yükleniyor...</p>
        </div>
    }
    else if (logList == null || !logList.Any())
    {
        <div class="text-center" style="padding:50px;">
            <p style="color:#7f8c8d; font-style:italic;">Henüz log kaydı bulunmamaktadır.</p>
        </div>
    }
    else
    {
        <RadzenDataGrid @ref="logGrid" Data="@logList" TItem="ItemGorevLoglari"
                        AllowPaging="true" PageSize="20" AllowSorting="true" AllowFiltering="true"
                        FilterCaseSensitivity="FilterCaseSensitivity.CaseInsensitive"
                        class="text-center align-middle compact-grid ">
            <Columns>

                <RadzenDataGridColumn TItem="ItemGorevLoglari" Title="Görev ID" Width="150px">
                    <Template Context="log">
                        <RadzenButton Text="@log.Gorev_ID.ToString()"
                                      ButtonStyle="ButtonStyle.Info"
                                      Size="ButtonSize.Small"
                                      Disabled="@(gorevSilindiDurumlari.ContainsKey(log.Gorev_ID) && gorevSilindiDurumlari[log.Gorev_ID])"
                                      Click="@(() => GorevSecildi(log.Gorev_ID))" />
                    </Template>
                </RadzenDataGridColumn>

                <RadzenDataGridColumn TItem="ItemGorevLoglari" Title="Görev Başlığı" Width="200px">
                    <Template Context="log">
                        @GetGorevBaslik(log.Gorev_ID)
                    </Template>
                </RadzenDataGridColumn>

                <RadzenDataGridColumn TItem="ItemGorevLoglari" Property="IslemTipi" Title="İşlem Tipi" Width="150px">
                    <Template Context="log">
                        @{
                            var islemTipi = log.IslemTipi?.Trim() ?? "";
                            var badgeStyle = "display:flex; justify-content:center; align-items:center; width:100px; height:30px; border-radius:6px; color:white; font-weight:normal;";
                        }

                        @if (islemTipi.Equals("Oluşturuldu", StringComparison.OrdinalIgnoreCase))
                        {
                            <RadzenBadge Text="Oluşturuldu"
                                         Style="@($"{badgeStyle} background-color:#2ecc71;")" />
                        }
                        else if (islemTipi.Equals("Güncellendi", StringComparison.OrdinalIgnoreCase))
                        {
                            <RadzenBadge Text="Güncellendi"
                                         Style="@($"{badgeStyle} background-color:#3498db;")" />
                        }
                        else if (islemTipi.Equals("Silindi", StringComparison.OrdinalIgnoreCase))
                        {
                            <RadzenBadge Text="Silindi"
                                         Style="@($"{badgeStyle} background-color:#e74c3c;")" />
                        }
                        else
                        {
                            <span style="display:flex; justify-content:center; align-items:center; width:100px; height:30px;">@log.IslemTipi</span>
                        }
                    </Template>
                </RadzenDataGridColumn>

                <RadzenDataGridColumn TItem="ItemGorevLoglari" Property="AlanAdi" Title="Alan Adı" Width="150px" />

                <RadzenDataGridColumn TItem="ItemGorevLoglari" Property="EskiDeger" Title="Eski Değer" Width="200px">
                    <Template Context="log">
                        @if (string.IsNullOrEmpty(log.EskiDeger))
                        {
                            <span style="color:#95a5a6; font-style:italic;">—</span>
                        }
                        else
                        {
                            <span>@log.EskiDeger</span>
                        }
                    </Template>
                </RadzenDataGridColumn>

                <RadzenDataGridColumn TItem="ItemGorevLoglari" Property="YeniDeger" Title="Yeni Değer" Width="200px">
                    <Template Context="log">
                        @if (string.IsNullOrEmpty(log.YeniDeger))
                        {
                            <span style="color:#95a5a6; font-style:italic;">—</span>
                        }
                        else
                        {
                            <span>@log.YeniDeger</span>
                        }
                    </Template>
                </RadzenDataGridColumn>

                <RadzenDataGridColumn TItem="ItemGorevLoglari" Title="İşlem Yapan" Width="180px">
                    <Template Context="log">
                        @GetKullaniciAdi(log.IslemKullanici_ID)
                    </Template>
                </RadzenDataGridColumn>

                <RadzenDataGridColumn TItem="ItemGorevLoglari" Property="IslemTarih" Title="İşlem Tarihi" Width="180px">
                    <Template Context="log">
                        @log.IslemTarih.ToString("dd.MM.yyyy HH:mm:ss")
                    </Template>
                </RadzenDataGridColumn>
            </Columns>
        </RadzenDataGrid>
    }
</RadzenCard>

@code {
    private List<ItemGorevLoglari> logList = new();
    private RadzenDataGrid<ItemGorevLoglari>? logGrid;
    private bool isLoading = true;
    private int? currentUserId = null;
    private bool isAdmin = false;
    private List<ItemGorev> gorevList = new();
    private Dictionary<int, string> kullaniciAdlari = new();
    private Dictionary<int, string> gorevBasliklari = new();
    private YetkiTipi _yetki;
    private Dictionary<int, bool> gorevSilindiDurumlari = new();


    //sayfa ilk yüklendiğinde log (kayıt) verilerini getirmek için kullanılır.
    protected override async Task OnInitializedAsync()
    {
        _yetki = await PermissionService.GetCurrentUserYetkiAsync("/admin/gorev-loglari");
        if (_yetki == YetkiTipi.Gizli)
        {
            NavigationManager.NavigateTo("/dashboard");
            notificationService.Notify(NotificationSeverity.Warning, "Uyarı", "Bu Sayfaya Erişme Yetkiniz Yok");
            return;
        }
        var currentUser = await girisSaglayici.GetCurrentUserAsync();

        if (currentUser != null)
        {
            var dbUser = await _kullaniciRepo.GetByIDAsync(currentUser.ID);

            currentUserId = dbUser.ID;
            isAdmin = await PermissionService.CanWriteAsync("/gorevler");
        }
        await YukleLoglarAsync();
    }

    //görev loglarını yükleyip ekranda gösterilmeye hazır hale getirmek için kullanılır.
    private async Task YukleLoglarAsync()
    {
        try
        {
            isLoading = true;

            var loglar = (await DataService.GetGorevLoglari()).ToList();
            var kullanicilar = await _kullaniciRepo.GetAllAsync();
            kullaniciAdlari = kullanicilar.ToDictionary(k => k.ID, k => $"{k.Adi} {k.Soyadi}");


            var gorevler = await DataService.GetGorevler();
            var gorevv = await DataService.Gorevler();
            gorevSilindiDurumlari = gorevv.ToDictionary(g => g.ID, g => g.DelUser!=0);
            gorevList = gorevler.ToList();

            // 2️⃣ Yetkiye göre filtre
            if (_yetki == YetkiTipi.Okuma)
            {
                loglar = loglar.Where(l =>
                {
                    var gorev = gorevList.FirstOrDefault(g => g.ID == l.Gorev_ID);
                    return gorev == null || gorev.Kullanici_ID == currentUserId || !gorev.Kilitli;
                }).ToList();
            }

            foreach (var log in loglar)
            {
                if (string.IsNullOrEmpty(log.Baslik))
                {
                    var gorev = gorevList.FirstOrDefault(g => g.ID == log.Gorev_ID);
                    if (gorev != null)
                        log.Baslik = gorev.Baslik;
                    else
                        log.Baslik = log.Baslik ?? "Silinmiş görev";  
                }
            }

            gorevBasliklari = gorevList.ToDictionary(g => g.ID, g => g.Baslik ?? "");

            logList = loglar.ToList();

            if (logGrid != null)
                await logGrid.Reload();

            isLoading = false;
            StateHasChanged();
        }
        catch (Exception ex)
        {
            notificationService.Notify(NotificationSeverity.Error, "Hata", $"Loglar yüklenirken bir hata oluştu: {ex.Message}");
            isLoading = false;
        }
    }

    //Kullanıcı ID'yi ekranda gösterilecek okunabilir bir ada çevirmek için kullanılır.
    private string GetKullaniciAdi(int kullaniciId)
    {
        if (kullaniciAdlari.TryGetValue(kullaniciId, out var ad))
        {
            return ad;
        }
        return $"Kullanıcı ID: {kullaniciId}";
    }

    //Görev ID'yi görev başlığına çevirmek için kullanılır.
    private string GetGorevBaslik(int gorevId)
    {
        // Eğer mevcut görevler sözlüğünde varsa başlığı al
        if (gorevBasliklari.TryGetValue(gorevId, out var baslik) && !string.IsNullOrEmpty(baslik))
        {
            return baslik;
        }

        // Sözlükte yoksa veya başlık boşsa, logList'teki saklanmış başlığı kullan
        var log = logList.FirstOrDefault(l => l.Gorev_ID == gorevId);
        if (log != null && !string.IsNullOrEmpty(log.Baslik))
        {
            return log.Baslik;
        }

        // Hiçbiri yoksa default
        return $"Silinmiş görev";
    }

    //log ekranında bir göreve tıklandığında ne olacağını belirler
    private void GorevSecildi(int gorevId)
    {
        var gorev = gorevList.FirstOrDefault(x => x.ID == gorevId);
        if (gorev == null)
            return;

        int tab = GoToGorev(gorev);

        if (tab == -1)
        {
            notificationService.Notify(
                NotificationSeverity.Warning,
                "Yetki Yok",
                "Bu görevi görüntüleme yetkiniz yok."
            );
            return;
        }

        NavigationManager.NavigateTo($"/gorevler?tab={tab}&gorevId={gorevId}");
    }

    //Görev detayına gitmek için kullanılır.
    int GoToGorev(ItemGorev g)
    { 
        if (!g.Aktif)
        {
            if (isAdmin)
                return 4;

            if (g.Kullanici_ID == currentUserId)
                return 4;

            return -1;   
        }

        if (isAdmin)
        {
            if (g.BitisTarihi < DateTime.Now && !g.Tamamlandi)
                return 3;

            if (g.Tamamlandi)
                return 2;

            if (g.Kilitli)
                return 5;

            return 0;
        }

        if (g.Kilitli && g.Kullanici_ID != currentUserId)
            return -1;

        if (g.BitisTarihi < DateTime.Now && !g.Tamamlandi)
            return 3;

        if (g.Tamamlandi)
            return 2;

        if (g.Kilitli && g.Kullanici_ID == currentUserId)
            return 5;

        return 0;
    }
}
