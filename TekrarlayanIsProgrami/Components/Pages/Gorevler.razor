@page "/Gorevler"
@using System.Threading.Tasks

<PageTitle>Görev Yönetimi</PageTitle>
<h3>Görev Yönetimi</h3>

<RadzenCard Style="margin:20px;">
	<h3>📊 Görev İstatistikleri</h3>



	<div class="row" style="margin-bottom:20px;">
		<div class="col-md-4">
			<RadzenCard Style="text-align:center; background:#4caf50; color:white; border-radius:10px;">
				<h4>Aktif Görevler</h4>
				<h2>@aktifSayisi</h2>
			</RadzenCard>
		</div>
		<div class="col-md-4">
			<RadzenCard Style="text-align:center; background:#2196F3; color:white; border-radius:10px;">
				<h4>Tamamlanan Görevler</h4>
				<h2>@tamamlananSayisi</h2>
			</RadzenCard>
		</div>
		<div class="col-md-4">
			<RadzenCard Style="text-align:center; background:#f44336; color:white; border-radius:10px;">
				<h4>Silinen Görevler</h4>
				<h2>@silinenSayisi</h2>
			</RadzenCard>
		</div>

	</div>

	<div class="row">
		<div class="col-md-6">
			<RadzenChart Style="height:300px" Palette="@(new [] {"#3498db","#2ecc71","#e74c3c"})">
				<RadzenPieSeries Data="@istatistikler" CategoryProperty="Durum" ValueProperty="Sayi" Title="Görevler"></RadzenPieSeries>
				<RadzenLegend Position="LegendPosition.Right"></RadzenLegend>
			</RadzenChart>
		</div>

		<div class="col-md-6">
			<RadzenChart Style="height:300px" Palette="@(new [] {"#3498db","#2ecc71","#e74c3c"})">
				<RadzenColumnSeries Data="@istatistikler" CategoryProperty="Durum" ValueProperty="Sayi" Title="Görevler"></RadzenColumnSeries>
				<RadzenCategoryAxis></RadzenCategoryAxis>
				<RadzenValueAxis></RadzenValueAxis>
			</RadzenChart>
		</div>
	</div>
</RadzenCard>
<RadzenTabs>
	<Tabs>
		<RadzenTabsItem Text="Yaklaşan Görevler">
			<RadzenDataGrid TItem="ItemGorev" Data="@yaklasanGorevler" ColumnWidth="200px">
				<Columns>
					<RadzenDataGridColumn TItem="ItemGorev" Property="Baslik" Title="Başlık"></RadzenDataGridColumn>
					<RadzenDataGridColumn TItem="ItemGorev" Property="Kullanici_ID" Title="Kullanıcı"></RadzenDataGridColumn>
					<RadzenDataGridColumn TItem="ItemGorev" Property="Kategori_ID" Title="Kategori"></RadzenDataGridColumn>
					<RadzenDataGridColumn TItem="ItemGorev" Property="SonrakiCalismaTarihi" Title="Sonraki Tarih"></RadzenDataGridColumn>
				</Columns>
			</RadzenDataGrid>
		</RadzenTabsItem>

		<RadzenTabsItem Text="Geçmiş Görevler">
			<RadzenDataGrid TItem="ItemGorev" Data="@gecmisGorevler" ColumnWidth="200px">
				<Columns>
					<RadzenDataGridColumn TItem="ItemGorev" Property="Baslik" Title="Başlık"></RadzenDataGridColumn>
					<RadzenDataGridColumn TItem="ItemGorev" Property="BitisTarihi" Title="Bitiş Tarihi"></RadzenDataGridColumn>
				</Columns>
			</RadzenDataGrid>
		</RadzenTabsItem>

		<RadzenTabsItem Text="Tüm Görevler">
			<RadzenDataGrid TItem="ItemGorev" Data="tumGorevler" ColumnWidth="200px" AllowFiltering="true" AllowPaging="true" AllowSorting="true">
				<Columns>
					<RadzenDataGridColumn TItem="ItemGorev" Property="ID" Title="ID"></RadzenDataGridColumn>
					<RadzenDataGridColumn TItem="ItemGorev" Property="Baslik" Title="Başlık"></RadzenDataGridColumn>
					<RadzenDataGridColumn TItem="ItemGorev" Property="Kullanici_ID" Title="Kullanıcı"></RadzenDataGridColumn>
					<RadzenDataGridColumn TItem="ItemGorev" Property="Kategori_ID" Title="Kategori"></RadzenDataGridColumn>
					<RadzenDataGridColumn TItem="ItemGorev" Property="OnemDerecesi" Title="Önem"></RadzenDataGridColumn>
					<RadzenDataGridColumn TItem="ItemGorev" Property="BaslangicTarihi" Title="Başlangıç"></RadzenDataGridColumn>
					<RadzenDataGridColumn TItem="ItemGorev" Property="BitisTarihi" Title="Bitiş"></RadzenDataGridColumn>

					<RadzenButton Text="➕ Yeni Görev" Style="margin-bottom:10px" Click="@Ekle"></RadzenButton>

					<RadzenDataGridColumn TItem="ItemGorev" Context="g">
						<Template Context="g">
							<RadzenButton Text="Düzenle" Style="margin-bottom:10px" Click="@(() => Duzenle(g))"></RadzenButton>
							<RadzenButton Text="Sil" Click="@(() => Sil(g.ID))" ButtonStyle="ButtonStyle.Danger"></RadzenButton>
						</Template>
					</RadzenDataGridColumn>
				</Columns>
			</RadzenDataGrid>
		</RadzenTabsItem>
	</Tabs>
</RadzenTabs>
@code {
	public int aktifSayisi;
	public int tamamlananSayisi;
	public int silinenSayisi;

	List<ItemGorev> yaklasanGorevler = new();
	List<ItemGorev> gecmisGorevler = new();
	List<ItemGorev> tumGorevler = new();

	public class GorevIstatistik
	{
		public string Durum { get; set; } = "";
		public int Sayi { get; set; }
	}

	private List<GorevIstatistik> istatistikler = new();

	protected override async Task OnInitializedAsync()
	{
		await YukleIstatistiklerAsync();
	}

	private async Task YukleIstatistiklerAsync()
	{
		var gorevler = await GorevRepo.GetAllAsync();

		var now = DateTime.Now.Date;
		tumGorevler = gorevler.ToList();

		var istatistik = await GorevRepo.GetIstatistikAsync();
		aktifSayisi = istatistik.aktif;
		tamamlananSayisi = istatistik.tamamlanan;
		silinenSayisi = istatistik.silinen;

		istatistikler = new List<GorevIstatistik>
		{
			new GorevIstatistik{Durum="Aktif",Sayi=aktifSayisi},
			new GorevIstatistik{Durum="Tamamlanan", Sayi=tamamlananSayisi},
			new GorevIstatistik{Durum="Silinen", Sayi=silinenSayisi}
		};

		gecmisGorevler = gorevler.Where(g => g.BitisTarihi.HasValue && g.BitisTarihi.Value.Date < now && g.DelDate == null).ToList();
		yaklasanGorevler = gorevler.Where(g => g.BitisTarihi.HasValue && g.BitisTarihi.Value.Date >= now && g.DelDate == null).ToList();

		StateHasChanged();
	}

	private async Task Ekle()
	{
		var result = await DialogService.OpenAsync<GorevEkleDuzenle>("Görev Ekle", new Dictionary<string, object> { { "Gorev", new ItemGorev() } }, new DialogOptions { Width = "700px", Height = "500px" });

		if (result is bool b && b)
		{
			tumGorevler = await GorevRepo.GetAllAsync();

			await YukleIstatistiklerAsync();

			StateHasChanged();
		}
	}

	private async Task Duzenle(ItemGorev gorev)
	{
		var result = await DialogService.OpenAsync<GorevEkleDuzenle>("Görev Düzenle", new Dictionary<string, object> { { "Gorev", gorev } }, new DialogOptions { Width = "700px", Height = "500px" });

		if (result is bool b && b)
		{
			tumGorevler = await GorevRepo.GetAllAsync();

			await YukleIstatistiklerAsync();
			StateHasChanged();
		}
	}

	private async Task Sil(int id)
	{
		var onay = await DialogService.Confirm("Bu görevi silmek istediğinize emin misiniz?", "Onay", new ConfirmOptions() { OkButtonText = "Evet", CancelButtonText = "Hayır" });

		if (onay==true)
		{
			await GorevRepo.DeleteAsync(id, 1);

			tumGorevler = await GorevRepo.GetAllAsync();
			await YukleIstatistiklerAsync();
			StateHasChanged();
		}
		await GorevRepo.DeleteAsync(id, 1);
		tumGorevler = await GorevRepo.GetAllAsync();
	}
}
