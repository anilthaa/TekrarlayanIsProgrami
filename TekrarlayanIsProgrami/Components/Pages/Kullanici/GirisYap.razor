@page "/GirisYap"
@page "/"
@layout EmptyLayout
<RadzenDialog></RadzenDialog>

<div class="login-container @(isRegisterActive ? "slide-active" : "")">
	<!-- Giriş Formu -->
	<div class="form login-form">
		<EditForm Model="@loginModel" OnValidSubmit="() => OnLogin(loginModel)">
			<h3>🔐Giriş Yap</h3>
			<p style="color:rebeccapurple;">Lütfen bilgilerinizi girin</p>

			<RadzenTextBox @bind-Value="loginModel.E_Posta" Style="width:100%;" Placeholder="✉E-posta" />
			<RadzenPassword @bind-Value="loginModel.Sifre" Style="width:100%; margin-top:9px;" Placeholder="🔑Şifre" Icon="@eyeIcon" />
			@*<a href="/sifremi-unuttum" @onclick="OpenSifreSifirlaDialog" class="sifreBaglanti">🔁Şifrenimi Unuttun?</a>*@
			<RadzenButton Text="🔁 Şifrenizi Unuttunuz mu?" Click="@OpenSifremiUnuttumDialog" class="sifreBaglanti"></RadzenButton>

			<RadzenButton ButtonType="ButtonType.Submit" Style="width:100%; margin-top:20px;" Text="Giriş Yap" class=" radzen-button" Icon="login"></RadzenButton>
		</EditForm>
	</div>
	<!-- Kayıt Formu -->

	<div class="form register-form">
		<EditForm Model="@newUser" OnValidSubmit="@OnSubmit">
			<DataAnnotationsValidator />
			<div class="row">
				<h3>Hesap Oluştur</h3>
				<p style="color:rebeccapurple; margin-left:5px; margin-bottom:5px;">Lütfen bilgilerinizi girin</p>
				<div class="col-sm-12">
					<RadzenFormField Text="Ad" Style="width:85%; margin-left:45px;">
						<RadzenTextBox @bind-Value="newUser.Adi"  />
					</RadzenFormField>
					<ValidationMessage For="@(() => newUser.Adi)" />
				</div>
				<div class="col-sm-12">
					<RadzenFormField Text="Soyad" Style="width:85%; margin-left:45px; margin-top:4px;">
						<RadzenTextBox @bind-Value="newUser.Soyadi" />
					</RadzenFormField>
					<ValidationMessage For="@(() => newUser.Soyadi)" />
				</div>
				<div class="col-lg-12">
					<RadzenFormField Text="E-posta" Style="width:85%; margin-left:45px; margin-top:4px;">
						<RadzenTextBox @bind-Value="newUser.EPosta" />
					</RadzenFormField>
					<ValidationMessage For="@(() => newUser.EPosta)" />
				</div>
				<div class="col-sm-12">
					<RadzenFormField Text="Şifre" Style="width:85%; margin-left:45px; margin-top:4px;">
							<RadzenPassword @bind-Value="newUser.Sifre" />
					</RadzenFormField>
					<ValidationMessage For="@(() => newUser.Sifre)" />
				</div>
				<div class="col-sm-12">
					<RadzenFormField Text="Şifre Tekrar" Style="width:85%; margin-left:45px; margin-top:4px;">
						<RadzenPassword @bind-Value="newUser.SifreTekrar"Type="password"></RadzenPassword>
					</RadzenFormField>
					<ValidationMessage For="@(() => newUser.SifreTekrar)" />
				</div>
				<RadzenButton Style="width:100%; margin-top:20px;" class="radzen-button" Text="Kayıt Ol" ButtonStyle="ButtonStyle.Info" ButtonType="ButtonType.Submit"></RadzenButton>
			</div>
		</EditForm>
	</div>
	<!-- Slider Panel -->
	<div class="slider-panel">
		<RadzenCard class="slider-content">
			@if (!isRegisterActive)
			{
				<h2>Merhabalar!</h2>
				<p>Tüm site özelliklerini kullanmak için kişisel bilgilerinizle kayıt olun.</p>
				<RadzenButton Click="@(() => isRegisterActive = true)" Text="KAYIT OL" Style="background-color: white;color: #2196f3; margin-top:10px;" />
			}
			else
			{
				<h2>Tekrar Hoş Geldiniz!</h2>
				<p>Zaten hesabınız var mı? Giriş yapın.</p>
				<RadzenButton Click="@(() => isRegisterActive = false)" Text="GİRİŞ YAP" Style="background-color: white; color: #2196f3; margin-top:10px;" />
			}
		</RadzenCard>
	</div>
</div>
@code {
	bool isRegisterActive = false;
	private LoginModel loginModel = new LoginModel();

	async Task OnLogin(LoginModel model)
	{
		var result = await girisSaglayici.GirisYapAsync(model.E_Posta, model.Sifre);

		if (result.Basarili) 
		{
			// Sağlayıcı zaten token'ı ve kullanıcıyı set ediyor; eksikse tamamlayalım
			if (result.User != null)
			{
				await girisSaglayici.MarkUserAsAuthenticated(result.User);
			}
			var storedToken = await Js.InvokeAsync<string>("localStorage.getItem", "jwtToken");
			if (string.IsNullOrEmpty(storedToken) && !string.IsNullOrEmpty(result.Token))
			{
				await Js.InvokeVoidAsync("localStorage.setItem", "jwtToken", result.Token);
			}
            notificationService.Notify(NotificationSeverity.Success, "Hoşgeldiniz", result.Mesaj);
            var uri = new Uri(NavigationManager.Uri);
            var query = QueryHelpers.ParseQuery(uri.Query);
            if (query.TryGetValue("returnUrl", out var returnUrls) && returnUrls.Count > 0)
            {
                var decoded = Uri.UnescapeDataString(returnUrls[0]);
                // güvenli: sadece uygulama içi göreli yollara izin ver
                if (!string.IsNullOrWhiteSpace(decoded) && decoded.StartsWith("/"))
                {
                    NavigationManager.NavigateTo(decoded, forceLoad: false, replace: true);
                    return;
                }
                else
                {
                    NavigationManager.NavigateTo("/dashboard", forceLoad: false, replace: true);
                    return;
                }
            }
            else
            {
                NavigationManager.NavigateTo("/dashboard", forceLoad: false, replace: true);
                return;
            }
		}
		else
		{
			notificationService.Notify(NotificationSeverity.Error, "Giriş Hatası", result.Mesaj);
		}
	}

	public class LoginModel
	{
		public string E_Posta { get; set; }
		public string Sifre { get; set; }
	}

	private User newUser = new User
	{
		CreUser = 1,
		CreDate = DateTime.Now,
		Aktif = true
	};

	private async Task OnSubmit()
	{
		if (!EpostaGecerliMi(newUser.EPosta))
		{
			notificationService.Notify(NotificationSeverity.Error,"Hata", "E-posta Yalnızca gmail.com veya hotmail.com Olmalıdır.");
			return;
		}

		if (newUser.Sifre != newUser.SifreTekrar)
		{
		    notificationService.Notify(NotificationSeverity.Error, "Hata", "Şifre ile Tekrar Şifre Aynı Olmak Zorunda!");
			return;   
		}

		var result = await girisSaglayici.KayitOlAsync(newUser);
	    if (result.Basarili)
		{
			notificationService.Notify(NotificationSeverity.Success, "Başarılı" ,result.Mesaj);
			NavigationManager.NavigateTo("/GirisYap");
		}
		else
		{
			notificationService.Notify(NotificationSeverity.Error, "Hata",result.Mesaj);
		}
	}
	private bool EpostaGecerliMi(string eposta)
	{
		if (string.IsNullOrWhiteSpace(eposta))
			return false;

		var desen = @"^[\w\.-]+@(gmail\.com|hotmail\.com)$";
		return Regex.IsMatch(eposta, desen, RegexOptions.IgnoreCase);
	}

	//Popup
	private async Task OpenSifremiUnuttumDialog()
	{
		await DialogService.OpenAsync<SifremiUnuttum>("Şifre",new Dictionary<string, object>());
	}

	private string InputType { get; set; } = "password";
	private string Icon { get; set; } = "visibility"; // göz açık

	void TogglePassword()
	{
		if (InputType == "password")
		{
			InputType = "text";
			Icon = "visibility_off"; // göz kapalı
		}
		else
		{
			InputType = "password";
			Icon = "visibility";
		}
	}
}