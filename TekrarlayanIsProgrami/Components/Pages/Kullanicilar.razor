@page "/kullanicilar"

@inject UserRepository kullaniciRepo

<h3>Reyonlar</h3>

@if (kullanicilar == null)
{
    <p>Yükleniyor...</p>
}
else if (!kullanicilar.Any())
{
    <p>Hiç reyon yok.</p>
}
else
{
    <ul>
        @foreach (var u in kullanicilar)
        {
            <li>@u.Adi - @u.Soyadi - @u.EPosta - @u.KullaniciTip_ID - @u.Sifre - @u.Aktif</li>
        }
    </ul>
}
@code {
    private List<User>? kullanicilar;

    protected override async Task OnInitializedAsync()
    {
        kullanicilar = await kullaniciRepo.GetAllAsync();
    }
}

