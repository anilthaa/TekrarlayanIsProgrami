			{
				adminGorevleri = new List<ItemGorev>();
			}

			GorevListt = tumGorevler.ToList();
		}
		catch (Exception ex)
		{
			notificationService.Notify(NotificationSeverity.Error, "Hata", "Görev verileri yüklenirken bir hata oluştu." + ex.Message);
		}
	}

