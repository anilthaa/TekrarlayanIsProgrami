					<Columns>
						<RadzenDataGridColumn TItem="ItemGorev" Width="55px">
							<Template Context="g">
								@if (g.BitisTarihi.HasValue &&
														g.BitisTarihi.Value < DateTime.Now &&
														!g.Tamamlandi)
								{
									<RadzenIcon Icon="warning"
												Style="color:#e74c3c;"
												Title="Süresi dolmuş görev" />
								}
							</Template>
						</RadzenDataGridColumn>
						<RadzenDataGridColumn TItem="ItemGorev" Property="ID" Title="No" Width="0px"></RadzenDataGridColumn>
						<RadzenDataGridColumn Title="No" Width="100px">
							<Template Context="g">
								@(adminGorevleri.ToList().IndexOf(g) + 1)
							</Template>
						</RadzenDataGridColumn>
						<RadzenDataGridColumn TItem="ItemGorev" Property="Baslik" Title="Başlık" Width="350px"></RadzenDataGridColumn>
						<RadzenDataGridColumn TItem="ItemGorev" Title="Atayan Kişi" Width="150px">
							<Template Context="g">
								@GetAtayanKullaniciAdi(g.CreUser)
							</Template>

						</RadzenDataGridColumn>
						<RadzenDataGridColumn TItem="ItemGorev" Property="BitisTarihi" Title="Bitiş Tarihi" FormatString="{0:dd.MM.yyyy HH:mm}" Width="150px"></RadzenDataGridColumn>
						<RadzenDataGridColumn TItem="ItemGorev" Property="OnemDerecesi" Title="Önem" Width="100px">
							<Template Context="onem">
								<span style="display:inline-block; width:60px; text-align:center; font-size:12px; padding:3px 8px; border-radius:6px; color:white; background-color:@GetOnemRengi(onem.OnemDerecesi)">
									@(string.IsNullOrWhiteSpace(onem.OnemDerecesi) ? "Yok" : onem.OnemDerecesi)
								</span>
							</Template>
						</RadzenDataGridColumn>
						<RadzenDataGridColumn TItem="ItemGorev" Property="Aktif" Title="Aktif" Width="80px">
							<Template Context="durum">
								<span style="display:inline-block; width:60px; text-align:center; font-size:12px; padding:3px 8px; border-radius:6px; background-color:@(durum.Aktif ? "#4caf50" : "#e53935"); color:white;">
									@(durum.Aktif ? "Aktif" : "Pasif")
								</span>
							</Template>
						</RadzenDataGridColumn>
						<RadzenDataGridColumn TItem="ItemGorev" Property="Tamamlandi" Title="Tamamlandı" Width="100px">
							<Template Context="durum">
								<span style="display:inline-block; width:60px; text-align:center; font-size:12px; padding:3px 8px; border-radius:6px; background-color:@(durum.Tamamlandi ? "#4caf50" : "#e53935"); color:white;">
									@(durum.Tamamlandi ? "Evet" : "Hayır")
								</span>
							</Template>
						</RadzenDataGridColumn>
					</Columns>
				</RadzenDataGrid>
			}
			else
			{
				<div style="padding:20px; text-align:center; color:#888;">
					<p>Size atanan görev bulunmuyor.</p>
					<p style="font-size:12px; margin-top:10px;">
						@if (!currentUserId.HasValue)
