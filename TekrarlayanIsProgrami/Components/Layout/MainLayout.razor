@inherits LayoutComponentBase

<RadzenComponents @rendermode="InteractiveServer" />
<RadzenNotification />

<RadzenLayout>
    @{
        var uri = NavigationManager.Uri.ToLower();
    }

    @if (!uri.Contains("/girisyap"))
    {
        <RadzenSidebar>
            @if (IsLoading)
            {
                <div class="nav-link" style="opacity:0.6;">
                    Menü yükleniyor...
                </div>
            }
           
            else
            {
                <RadzenCard class="dashboard-nav">
                    <a href="/dashboard" style="text-decoration:none; color:white;">
                        <h3>📊 Dashboard</h3>
                    </a>

                    @foreach (var anaMenu in VisibleMenus
                                .Where(x => (x.UstMenu_ID == 0 || x.UstMenu_ID == null) && x.IsMenu)
                                .OrderBy(x => x.Sira))
                       {
                        var altMenuler = VisibleMenus
                        .Where(x => x.UstMenu_ID == anaMenu.ID && x.IsMenu)
                        .OrderBy(x => x.Sira)
                        .ToList();

                        // Ana menüye ve alt menülere yetki kontrolü
                        if (!UserHasAccessToMenu(anaMenu, altMenuler))
                            continue;

                        <div class="nav-link" style="cursor:pointer;"
                             @onclick="@(() =>
                             {
                                 ToggleMenu(anaMenu.ID);
                                 if (!string.IsNullOrWhiteSpace(anaMenu.SayfaURL))
                                     NavigationManager.NavigateTo(GetHref(anaMenu));
                             })">
                              @anaMenu.Adi
                          </div>

                        @if (altMenuler.Any() && AcikMenuler.Contains(anaMenu.ID))
                        {
                            <div class="dropdown-container">
                                @foreach (var alt in altMenuler)
                                {
                                    <div class="nav-link"
                                         @onclick="@(() => NavigationManager.NavigateTo(GetHref(alt)))">
                                        @alt.Adi
                                    </div>
                                }
                            </div>
                        }
                    }

                    <div style="position: absolute;bottom: 20px;left: 0;width: 100%; display: flex; flex-direction: column; align-items: center; gap:10px; padding:0 10px;">
                        <RadzenButton Text="Profil" Click="@ProfilPopupAc" Style="width:100%; max-width:220px; background-color:transparent; color:white;" />
                        <RadzenButton Text="Çıkış Yap" Click="@CikisYap" Style="width:100%; max-width:220px; background-color:transparent; color:white;" />
                    </div>
                </RadzenCard>
            }
        </RadzenSidebar>
    }

    <RadzenBody>
        @Body
    </RadzenBody>
</RadzenLayout>

@code {
    private List<ItemForm> VisibleMenus = new();
    private bool IsLoading = true;
    private HashSet<int> AcikMenuler = new();
    private User? currentUser;
    //metodu, sayfa yüklenirken kullanıcı ve menü görünürlüğünü ayarlıyor.
    protected override async Task OnInitializedAsync()
    {
        IsLoading = true;
        currentUser = await girisSaglayici.GetCurrentUserAsync();

        if (currentUser != null)
        {
            VisibleMenus = (await DataService.GetMenusByUserAsync(currentUser))
                .GroupBy(m => m.ID)
                .Select(g => g.First())
                .OrderBy(m => m.Sira)
                .ToList();
        }
        else
        {
            VisibleMenus = new List<ItemForm>();
        }

        IsLoading = false;
    }

    //bir menünün görünürlüğünü ve erişilebilirliğini kontrol etmek için yazılmıştır.
    private bool UserHasAccessToMenu(ItemForm anaMenu, List<ItemForm> altMenuler)
    {
        if (currentUser == null || !anaMenu.IsMenu)
            return false;

        if (VisibleMenus.Any(m => m.ID == anaMenu.ID))
            return true;

        if (altMenuler.Any(alt => VisibleMenus.Any(v => v.ID == alt.ID)))
            return true;

        return false;
    }

    private string GetHref(ItemForm form) => string.IsNullOrWhiteSpace(form.SayfaURL) ? "#" : (form.SayfaURL.StartsWith("/") ? form.SayfaURL : "/" + form.SayfaURL);

    //kullanıcı bir menü başlığına tıkladığında menünün açılıp kapanmasını yönetiyor.
    private void ToggleMenu(int id)
    {
        if (!AcikMenuler.Add(id))
            AcikMenuler.Remove(id);
    }

    //Çıkış işlemleri için kullanılıyor
    private async void CikisYap()
    {
        try
        {
            var currentUser = await girisSaglayici.GetCurrentUserAsync();
            if (currentUser != null)
            {
                await DataService.SetKullaniciLog(new ItemKullaniciLog
                {
                    Kullanici_ID = currentUser.ID,
                    IslemTipi = "Cikis",
                    IslemTarihi = DateTime.Now,
                    Aciklama = "Kullanıcı çıkış yaptı",
                    CreUser = currentUser.ID
                });
            }
        }
        catch { }

        await ((CustomAuthenticationStateProvider)girisSaglayici).MarkUserAsLoggedOut();
        await PermissionService.RefreshAsync();
        NavigationManager.NavigateTo("/GirisYap", true);
    }

    //Profili açmak için kullanılan bir metot
    async Task ProfilPopupAc()
    {
        await DialogService.OpenAsync<KullaniciProfil>(
            "Profil Bilgileri",
            null,
            new DialogOptions { Width = "550px", Height = "auto", Resizable = false, Draggable = true, CloseDialogOnOverlayClick = true });
    }
}
