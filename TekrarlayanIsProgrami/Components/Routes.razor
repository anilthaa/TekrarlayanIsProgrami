<CascadingAuthenticationState>
    <PermissionGuard />
    <Router AppAssembly="@typeof(Program).Assembly">
        <Found Context="routeData">
            <AuthorizeRouteView RouteData="@routeData" DefaultLayout="@GetLayoutType()">
                <NotAuthorized>
                <RedirectToLogin ></RedirectToLogin>
                </NotAuthorized>
            </AuthorizeRouteView>
        </Found>
        <NotFound>
            <LayoutView Layout="@typeof(MainLayout)">
                <p>Sayfa bulunamadı.</p>
            </LayoutView>
        </NotFound>
    </Router>
</CascadingAuthenticationState>
@code {
    //Layout tipini getittrimek için kullanılır.
    private Type GetLayoutType()
    {
        var uri = NavigationManager.Uri.ToLower();

        if (uri.Contains("/girisyap"))
        {
            return typeof(EmptyLayout);
        }
        else
        {
            return typeof(MainLayout);
        }
    } 
}
