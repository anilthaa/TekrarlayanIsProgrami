@page "/KayitOl"

<!-- Arka plan ve sayfa ortalama -->
<RadzenCard class="form-wrapper">
        <RadzenCard class="form-card">
        <!-- Başlık -->
        <h2>Kayıt Ol</h2>
        <!-- Form -->
        <EditForm Model="@newUser" OnValidSubmit="OnSubmit">
            <RadzenFieldset>
            <DataAnnotationsValidator />
            <ValidationSummary />
                <RadzenLabel style="display:block; margin-bottom:5px; font-weight:bold;" Text="Adınız"></RadzenLabel>
                <RadzenTextBox @bind-Value="newUser.Adi" placeholder="Adınız" style="width:100%;"/>
                <RadzenLabel style="display:block; margin-bottom:5px; font-weight:bold;" Text="Soyadınız"></RadzenLabel>
                <RadzenTextBox @bind-Value="newUser.Soyadi" placeholder="Soyadınız" style="width:100%;" />
                <RadzenLabel style="display:block; margin-bottom:5px; font-weight:bold;" Text="E_posta"></RadzenLabel>
                <RadzenTextBox @bind-Value="newUser.EPosta" placeholder="E-posta" style="width:100%;" />
                <RadzenLabel style="display:block; margin-bottom:5px; font-weight:bold;" Text="Şifre"></RadzenLabel>
                <RadzenTextBox @bind-Value="newUser.Sifre" type="password" placeholder="Şifre" style="width:100%; " />
            <RadzenCard class="button-group">
            <RadzenButton type="submit" class="radzen-button" style="width:30%;" Text="Kayıt Ol">
            </RadzenButton>
            </RadzenCard>
            </RadzenFieldset>
        </EditForm>
            <RadzenLink href="/GirisYap" style="color:#5563DE; text-decoration:none;">Zaten hesabınız var mı? Giriş Yap</RadzenLink>
    </RadzenCard>
</RadzenCard>
@code {
    private User newUser = new User
    {
        CreUser = 1,
        CreDate = DateTime.Now,
        Aktif = true
    };

    private async Task OnSubmit()
    {
        var result = await girisSaglayici.KayitOlAsync(newUser);
        if (result.Basarili )
        {
            notificationService.Notify(NotificationSeverity.Success, "Başarılı", result.Mesaj);
            NavigationManager.NavigateTo("/GirisYap");
        }
        else
        {
            notificationService.Notify(NotificationSeverity.Error, "Hata", result.Mesaj);
        }
    }
}
