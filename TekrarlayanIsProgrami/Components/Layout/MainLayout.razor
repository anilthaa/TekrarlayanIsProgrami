@inherits LayoutComponentBase
<RadzenComponents @rendermode="InteractiveServer"></RadzenComponents>

 <HeadContent>
  <link href="css/site.css" rel="stylesheet" />
</HeadContent>
<RadzenDialog></RadzenDialog>
<RadzenNotification></RadzenNotification>
<RadzenLayout>
    @if (!NavigationManager.Uri.Contains("/GirisYap"))
    {
        <RadzenSidebar>
            @if (NavigationManager.Uri.Contains("/dashboard") || NavigationManager.Uri.Contains("/kategori") || NavigationManager.Uri.Contains("/kullanicilar") || NavigationManager.Uri.Contains("/Gorevler"))
            {
                <RadzenCard class="dashboard-nav">
                    <h3>📊 Dashboard</h3>
                    <NavLink href="/kullanicilar" class="nav-link">Kullanıcılar</NavLink>
                    <NavLink href="/kategori" class="nav-link">Kategoriler</NavLink>
                    <NavLink href="/Gorevler" class="nav-link">Görev Listesi</NavLink>
                    <RadzenButton Text="Çıkış" Click="@CikisYap" style="width:100%" class="radzen-button" />
                </RadzenCard>
            }
        </RadzenSidebar>
    }

    <RadzenBody>
        @Body
    </RadzenBody>
</RadzenLayout>
@code{
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await ((CustomAuthenticationStateProvider)girisSaglayici).LoadUserFromLocalStorageAsync();
        }
    }
    private async void CikisYap()
    {
        await ((CustomAuthenticationStateProvider)girisSaglayici).MarkUserAsLoggedOut();
       // await girisSaglayici.CikisYapAsync();
        NavigationManager.NavigateTo("/GirisYap", true);
    }
}