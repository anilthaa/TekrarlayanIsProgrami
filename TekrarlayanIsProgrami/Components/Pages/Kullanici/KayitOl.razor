@layout MainLayout
<!-- Arka plan ve sayfa ortalama -->

<RadzenCard class="max-width:600px; margin:auto; padding:20px;">

	<h3 class="card-title text-center mb-4">Kullanıcı Ekle</h3>
	<RadzenTemplateForm Data="@newUser" TItem="User" Submit="@OnSubmit">
		<RadzenFieldset Text="Bilgiler" Style="margin-bottom:15px;">
			<DataAnnotationsValidator />
			<ValidationSummary /> 
			<RadzenLabel class="form-label">Adı</RadzenLabel>
			<RadzenTextBox class="form-control" @bind-Value="newUser.Adi" placeholder="Adı girin" />
			<RadzenLabel class="form-label">Soyadı</RadzenLabel>
			<RadzenTextBox class="form-control" @bind-Value="newUser.Soyadi" placeholder="Soyadı girin" />
			<RadzenLabel class="form-label">E-Posta</RadzenLabel>
			<RadzenTextBox class="form-control" @bind-Value="newUser.EPosta" placeholder="E-Posta girin" />
			<RadzenLabel class="form-label">Şifre</RadzenLabel>
			<RadzenTextBox type="password" class="form-control" @bind-Value="newUser.Sifre" placeholder="Şifreyi girin" />
			<RadzenCard class="btn-group">
				<RadzenButton Text="Kaydet" Icon="save" Style="width:30%; margin:auto;" class="radzen-button"></RadzenButton>
				<RadzenButton Text="İptal"  Icon="cancel" Click="@Iptal" Style="width:30%; margin:auto;" class="radzen-button"></RadzenButton>
			</RadzenCard>
		</RadzenFieldset>
	</RadzenTemplateForm>

</RadzenCard>




@code {
	private User newUser = new User
	{
		CreUser = 1,
		CreDate = DateTime.Now,
		Aktif = true
	};

	private async Task OnSubmit()
	{
		var result = await girisSaglayici.KayitOlAsync(newUser);
		if (result.Basarili)
		{
			notificationService.Notify(NotificationSeverity.Success, "Başarılı", result.Mesaj);
			NavigationManager.NavigateTo("/GirisYap");
		}
		else
		{
			notificationService.Notify(NotificationSeverity.Error, "Hata", result.Mesaj);
		}
	}
	private void Iptal()
	{
		NavigationManager.NavigateTo(geriUrl);
	}
	private string geriUrl = "/kullanicilar";
}
