@page "/KayitOl"
@using TekrarlayanIsProgrami.Services
@using TekrarlayanIsProgrami.Models
@using Radzen
@using Radzen.Blazor

@inject CustomAuthenticationStateProvider AuthProvider
@inject NavigationManager Navigation
@inject NotificationService notificationService


<RadzenCard Style="max-width:600px; margin:auto; margin-top:40px">
    <RadzenTemplateForm TItem="Kullanici" Data="@newKullanici" Submit="@OnSubmit">
        <ChildContent>
            <RadzenTextBox @bind-Value="newKullanici.Adi" Placeholder="Adınız" Style="width:100%" Name="Adi" />
            <RadzenTextBox @bind-Value="newKullanici.Soyadi" Placeholder="Soyadınız" Style="width:100%; margin-top:10px" Name="Soyadi" />
            <RadzenTextBox @bind-Value="newKullanici.EPosta" Placeholder="E-posta" Style="width:100%; margin-top:10px" Name="EPosta" />
            <RadzenPassword @bind-Value="newKullanici.Sifre" Placeholder="Şifre" Style="width:100%; margin-top:10px;" Name="Sifre" />
            <RadzenButton Text="Kayıt Ol" ButtonType="ButtonType.Submit" Style="width:100%; margin-top:15px;" />
        </ChildContent>
    </RadzenTemplateForm>
</RadzenCard>


@code {
    private ItemKullanici newKullanici = new ItemKullanici
    {
        CreUser = 1,
        CreDate = DateTime.Now,
        Aktif = true
    };

    private async Task OnSubmit()
    {
        var result = await AuthProvider.KayitOlAsync(newKullanici);
        if (result.Basarili)
        {
            notificationService.Notify(NotificationSeverity.Success, "Başarılı", result.Mesaj);
            Navigation.NavigateTo("/GirisYap");
        }
        else
        {
            notificationService.Notify(NotificationSeverity.Error, "Hata", result.Mesaj);
        }
    }
}
