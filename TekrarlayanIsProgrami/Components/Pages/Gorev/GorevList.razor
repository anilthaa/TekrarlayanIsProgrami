@page "/gorevler"
@layout MainLayout
@attribute [Authorize]



<RadzenCard Style="margin:0; margin-left:0; padding:20px; width:100%; max-width:none; box-sizing:border-box;">
    <h3 style="text-align:center; font-family:Calibri;font-weight:bold;">Görev Listesi</h3>

    @if (_yetki != YetkiTipi.Gizli)
    {
        <RadzenButton Text="Yeni Görev" Icon="add"
                      Style="background:#ba76d3; color:white;border-radius:10px;"
                      Click="@YeniGorev"
                      Disabled="@(_yetki == YetkiTipi.Okuma)">
        </RadzenButton>
    }

    @if ((GorevListt == null || !GorevListt.Any()) && (AktifListe == null || !AktifListe.Any()))
    {
        <p style="text-align:center;">Veri yükleniyor... veya görev bulunamadı.</p>
    }
    else
    {
        <div class="my-tabs" style="margin-top:15px;">
            <div class="my-tab @(SelectedTabIndex == 0 ? "active" : "")" @onclick="() => SelectedTabIndex = 0">Tüm Aktif Görevler</div>
            <div class="my-tab @(SelectedTabIndex == 1 ? "active" : "")" @onclick="() => SelectedTabIndex = 1">Yaklaşan Görevler</div>
            <div class="my-tab @(SelectedTabIndex == 2 ? "active" : "")" @onclick="() => SelectedTabIndex = 2">Tamamlanmış Görevler</div>
            <div class="my-tab @(SelectedTabIndex == 3 ? "active" : "")" @onclick="() => SelectedTabIndex = 3">Süresi Dolanlar</div>
            <div class="my-tab @(SelectedTabIndex == 4 ? "active" : "")" @onclick="() => SelectedTabIndex = 4">Pasif Görevler</div>
            <div class="my-tab @(SelectedTabIndex == 6 ? "active" : "")" @onclick="() => SelectedTabIndex = 6">Bana Özel Görevler</div>
            <div class="my-tab @(SelectedTabIndex == 5 ? "active" : "")" @onclick="() => SelectedTabIndex = 5">Tüm Görevler</div>
        </div>

        @if (!AktifListe.Any())
        {
            <div style="text-align:center; padding:50px;">
                <p style="color:#7f8c8d; font-style:italic;">Kayıt bulunamadı.</p>
            </div>
        }
        else
        {
            <RadzenDataGrid TItem="ItemGorev" Data="@AktifListe" @ref="GrdGorev"
                            AllowPaging="true" AllowSorting="true" AllowFiltering="true"
                            RowDoubleClick="@((_yetki == YetkiTipi.Yazma) ? OnRowDoubleClick : null)"
                            Style="width:100%; overflow-x:auto;" ColumnWidth="120px"
                            RowSelect="OnRowSelect" SelectionMode="DataGridSelectionMode.Single"
                            SelectedItems="@SeciliGorevler" RowStyle="@GorevRowStyle"
                            class="mobile-card-grid">

                <Columns>
                    <RadzenDataGridColumn TItem="ItemGorev" Property="ID" Title="ID" Width="0px"></RadzenDataGridColumn>

                    <RadzenDataGridColumn Title="No" Width="100px">
                        <Template Context="g">@((AktifListe.ToList().IndexOf(g) + 1))</Template>
                    </RadzenDataGridColumn>

					<RadzenDataGridColumn TItem="ItemGorev" Property="Baslik" Title="Başlık" Frozen="true" Width="200px">
						<Template Context="g">
							<div style="@($"padding:5px; background-color:{(g.ID == gorevId ? "#d1e7dd" : "transparent")};")">
								@g.Baslik
								@if (g.BaslangicTarihi.HasValue
														&& g.BaslangicTarihi.Value <= DateTime.Now
														&& (DateTime.Now - g.BaslangicTarihi.Value).TotalHours < 24)
								{
									<span style="color:#ff9800; font-size:11px;">⭐</span>
								}
							</div>
						</Template>
					</RadzenDataGridColumn>

					<RadzenDataGridColumn TItem="ItemGorev" Width="250px"
										  Title="@(_yetki == YetkiTipi.Yazma ? "Atanan Kişi" : "Atayan Kişi")">
						<Template Context="g">
							@if (_yetki == YetkiTipi.Yazma)
							{
								@if (!g.Kilitli)
								{
									<span>—</span>
								}
								else if (GetAtananKullaniciSayisi(g) > 1)
								{
									var tamamlanmaBilgisi = GetTamamlanmaBilgisi(g);
									<div style="display: flex; align-items: center; gap: 8px; flex-wrap: wrap;">
										<span style="color: #666; font-size: 12px;">Bu görev birden fazla kişiye atandı</span>
										<span style="padding: 2px 8px; border-radius: 4px; background-color: @(tamamlanmaBilgisi.Tamamlanan == tamamlanmaBilgisi.Toplam ? "#4caf50" : tamamlanmaBilgisi.Tamamlanan > 0 ? "#ff9800" : "#e0e0e0"); color: @(tamamlanmaBilgisi.Tamamlanan == tamamlanmaBilgisi.Toplam ? "white" : tamamlanmaBilgisi.Tamamlanan > 0 ? "white" : "#666"); font-size: 11px; font-weight: 600;">
											@tamamlanmaBilgisi.Tamamlanan / @tamamlanmaBilgisi.Toplam
										</span>
										<RadzenButton Text="Detaylar" Size="ButtonSize.Small" ButtonStyle="ButtonStyle.Info" Click="@(() => ShowAtananKisilerDialog(g))" />
									</div>
								}
								else
								{
									@GetAtananKullaniciAdi(g.Kullanici_ID, g.Kilitli)
								}
							}
							else if (_yetki == YetkiTipi.Okuma)
							{
								@GetAtayanKullaniciAdi(g.CreUser)
							}
						</Template>
					</RadzenDataGridColumn>

                    <RadzenDataGridColumn TItem="ItemGorev" Property="Kategori_ID" Title="Kategori ID" Width="10px"></RadzenDataGridColumn>
                    <RadzenDataGridColumn TItem="ItemGorev" Property="KategoriAdi" Title="Kategori Adı" Width="200px">
                        <Template Context="g">@(string.IsNullOrWhiteSpace(g.KategoriAdi) ? "—" : g.KategoriAdi)</Template>
                    </RadzenDataGridColumn>
                    <RadzenDataGridColumn TItem="ItemGorev" Property="OnemDerecesi" Title="Önem" Width="150px">
                        <Template Context="g">
                            <span style="display:inline-block;font-size:12px;padding:3px 8px;width:65px; height:24px;line-height:18px;border-radius:6px;color:white;text-align:center;background-color:@GetOnemRengi(g.OnemDerecesi ?? string.Empty)">
                                @(string.IsNullOrWhiteSpace(g.OnemDerecesi) ? "Yok" : g.OnemDerecesi)
                            </span>
                        </Template>
                    </RadzenDataGridColumn>
                    <RadzenDataGridColumn TItem="ItemGorev" Property="TekrarlamaTipi" Title="Tekrarlama" Width="200px">
                        <Template Context="g">@(!string.IsNullOrWhiteSpace(g.TekrarlamaTipi) ? g.TekrarlamaTipi : "Yok")</Template>
                    </RadzenDataGridColumn>
					<RadzenDataGridColumn TItem="ItemGorev" Title="Tekrar" Width="200px">
						<Template Context="g">
							@if (g.TekrarAraligi.HasValue)
							{
								@($"{g.TekrarAraligi} {(g.TekrarlamaTipi == "Günlük" ? "günde bir" : g.TekrarlamaTipi == "Aylık" ? "ayda bir" : "")}")
							}
							else if (!string.IsNullOrEmpty(g.HaftaninGunu))
							{
								@($" {g.HaftaninGunu}")
							}
							else
							{
								@("Yok")
							}
						</Template>
					</RadzenDataGridColumn>
					<RadzenDataGridColumn TItem="ItemGorev" Property="BaslangicTarihi" Title="Başlangıç" FormatString="{0:dd.MM.yyyy HH:mm}" Width="150px"></RadzenDataGridColumn>
                    <RadzenDataGridColumn TItem="ItemGorev" Property="BitisTarihi" Title="Bitiş" FormatString="{0:dd.MM.yyyy HH:mm}" Width="150px"></RadzenDataGridColumn>
                    <RadzenDataGridColumn TItem="ItemGorev" Property="Tamamlandi" Title="Tamamlandı" Width="170px" Filterable="false" Sortable="true" TextAlign="TextAlign.Center">
                        <Template Context="gorev">
							<RadzenCheckBox @bind-Value="gorev.Tamamlandi" TValue="bool"
											Change="@(async (args) => await ToggleTamamlandi(gorev))"
											Disabled="@(gorev.Aktif == false
											 || (gorev.BaslangicTarihi.HasValue && gorev.BaslangicTarihi.Value > DateTime.Now)
											 || (gorev.Kilitli && gorev.Kullanici_ID != currentUserId))">
					</RadzenCheckBox>
                        </Template>
                    </RadzenDataGridColumn>
                    <RadzenDataGridColumn TItem="ItemGorev" Title="Durum" Width="150px">
                        <Template Context="gorev">
                            @if (_yetki != YetkiTipi.Gizli)
                            {
                                <span style="cursor:@(_yetki == YetkiTipi.Yazma ? "pointer" : "not-allowed");"
                                      @onclick="async () => { if (_yetki == YetkiTipi.Yazma) await ToggleDurum(gorev); }">
                                    <RadzenBadge Text="@(gorev.Aktif ? "Aktif" : "Pasif")"
                                                 Style="@(gorev.Aktif
                                                         ? "background-color:#3498db;color:white;padding:5px 10px;border-radius:10px;"
                                                         : "background-color:red;color:white;padding:5px 10px;border-radius:10px;")" />
                                </span>
                            }
                        </Template>
                    </RadzenDataGridColumn>

                    @if (_yetki != YetkiTipi.Gizli)
                    {
                        <RadzenDataGridColumn TItem="ItemGorev" Title="İşlemler" Width="150px">
                            <Template Context="gorev">
                                <RadzenButton Icon="edit" Size="ButtonSize.Small"
                                              ButtonStyle="ButtonStyle.Success"
                                              Click="@(() => Duzenle(gorev))"
                                              Disabled="@(_yetki == YetkiTipi.Okuma)"
                                              Style="margin-right:5px;">
                                </RadzenButton>
                                <RadzenButton Icon="delete" Size="ButtonSize.Small"
                                              ButtonStyle="ButtonStyle.Danger"
                                              Click="@(() => Sil(gorev))"
                                              Disabled="@(_yetki == YetkiTipi.Okuma)">
                                </RadzenButton>
                            </Template>
                        </RadzenDataGridColumn>
                    }
                </Columns>
            </RadzenDataGrid>
        }
    }
</RadzenCard>
@code {
	private string[] TabNames = new string[]
			{
		"Tüm Aktif Görevler",
		"Yaklaşan Görevler",
		"Tamamlanmış Görevler",
		"Süresi Dolanlar",
		"Pasif Görevler"
			};
	private ItemKullaniciTip kullaniciTip = new ItemKullaniciTip();
	private bool IsLoading = true;
	private List<ItemGorev> GorevListt = new();
	private RadzenDataGrid<ItemGorev>? GrdGorev;
	private int SelectedTabIndex { get; set; } = 0;
	private ItemGorev gorevler = new ItemGorev();
	private ItemGorevLoglari Gorev = new ItemGorevLoglari();
	private List<User> TumKullanicilar = new();
	private int? currentUserId = null;
	[SupplyParameterFromQuery(Name = "tab")]
	public int QueryTabIndex { get; set; } = 0;
	int? gorevId;
	int? hedefTab = null;
	List<ItemGorev> SeciliGorevler = new();
	bool gorevSecildi = false;
	private YetkiTipi _yetki;


	private IEnumerable<ItemGorev> aktifGorevler => GorevListt.Where(g => g.Aktif && !g.Tamamlandi && (!g.BitisTarihi.HasValue || g.BitisTarihi.Value >= DateTime.Today) && (_yetki == YetkiTipi.Yazma || g.Kullanici_ID == currentUserId || !g.Kilitli));
	private IEnumerable<ItemGorev> yaklasanGorevler => aktifGorevler.Where(g => g.BitisTarihi.HasValue && (g.BitisTarihi.Value - DateTime.Now).TotalDays > 0 && (g.BitisTarihi.Value - DateTime.Now).TotalDays <= 7);
	private IEnumerable<ItemGorev> tamamlananGorevler => GorevListt.Where(g => g.Tamamlandi && (_yetki == YetkiTipi.Yazma || g.Kullanici_ID == currentUserId || !g.Kilitli));
	private IEnumerable<ItemGorev> gecmisGorevler => GorevListt.Where(g => g.BitisTarihi.HasValue && g.BitisTarihi.Value < DateTime.Now && !g.Tamamlandi && (_yetki == YetkiTipi.Yazma || g.Kullanici_ID == currentUserId || !g.Kilitli));
	private IEnumerable<ItemGorev> pasifGorevler => GorevListt.Where(g => !g.Aktif && !g.Tamamlandi && (_yetki == YetkiTipi.Yazma || g.Kullanici_ID == currentUserId || !g.Kilitli));
	private IEnumerable<ItemGorev> BanaOzelGorevler => GorevListt.Where(g => g.Kullanici_ID == currentUserId && g.Kilitli && !g.Tamamlandi && g.DelUser == 0 && (!g.BitisTarihi.HasValue || g.BitisTarihi.Value >= DateTime.Today));
	private IEnumerable<ItemGorev> TumGorevler => GorevListt
		.Where(g => g.DelUser == 0 && (_yetki == YetkiTipi.Yazma || !g.Kilitli));   
	//URL’den gelen tab parametresine göre ekrandaki sekmelerin doğru seçili kalmasını sağlar.
	protected override void OnParametersSet()
	{
		if (SelectedTabIndex != QueryTabIndex)
		{
			SelectedTabIndex = QueryTabIndex;
		}
	}

	//sayfa ilk render edildikten sonra sekme seçimini ve görev otomatik seçimini yapmak için kullanılır.
	protected override async Task OnAfterRenderAsync(bool firstRender)
	{
		if (!firstRender) return;

		if (hedefTab.HasValue)
		{
			SelectedTabIndex = hedefTab.Value;
		}

		if (gorevId.HasValue && !gorevSecildi && AktifListe.Any())
		{
			var gorev = GorevListt.FirstOrDefault(g => g.ID == gorevId.Value);
			if (gorev != null)
			{
				SeciliGorevler.Clear();
				SeciliGorevler.Add(gorev);
				gorevSecildi = true;
				StateHasChanged();
			}
		}
	}

	//Admin tipinde olan kullanıcıya ait görev listesi.
	private IEnumerable<ItemGorev> AktifListe
	{
		get
		{
			IEnumerable<ItemGorev> liste = SelectedTabIndex switch
			{
				0 => aktifGorevler,
				1 => yaklasanGorevler,
				2 => tamamlananGorevler,
				3 => gecmisGorevler,
				4 => pasifGorevler,
				5 => TumGorevler,
				6 => BanaOzelGorevler,
				_ => aktifGorevler,
			};

			if (_yetki == YetkiTipi.Okuma)
			{
				liste = liste.Where(g => g.Kullanici_ID == currentUserId || !g.Kilitli);
			}

			return liste.GroupBy(g => new { g.BaslangicTarihi, g.Baslik })
						.Select(x => x.First());
		}
	}

	//görevler sayfası ilk açıldığında URL parametrelerini okuyup gerekli verileri yükleyen başlangıç sürecidir.
	protected override async Task OnInitializedAsync()
	{
		_yetki = await PermissionService.GetCurrentUserYetkiAsync("/gorevler");
		if (_yetki == YetkiTipi.Gizli)
		{
			NavigationManager.NavigateTo("/dashboard");
			notificationService.Notify(NotificationSeverity.Warning, "Uyarı", "Bu Sayfaya Erişme Yetkiniz Yok");
			return;
		}
		var uri = NavigationManager.ToAbsoluteUri(NavigationManager.Uri);
		var query = QueryHelpers.ParseQuery(uri.Query);

		if (query.TryGetValue("tab", out var tabValue) &&
			int.TryParse(tabValue, out var tab))
		{
			hedefTab = tab;
			SelectedTabIndex = tab;
		}

		if (query.TryGetValue("gorevId", out var gorevValue) &&
	int.TryParse(gorevValue, out var id))
		{
			gorevId = id;
		}

		var user = await girisSaglayici.GetCurrentUserAsync();
		currentUserId = user?.ID;

		await YukleGorevler();

		kullaniciTip = await _kullaniciTipRepository
			.GetKullaniciTipByKullaniciIDAsync(currentUserId.Value);

		await YukleKullanicilar();
	}

	//oturumda bulunan kullanıcının ID sini sisteme yüklemek için kullanılır.
	private async Task YukleKullaniciId()
	{
		try
		{
			var currentUser = await girisSaglayici.GetCurrentUserAsync();
			if (currentUser != null)
			{
				currentUserId = currentUser.ID;
			}
		}
		catch (Exception ex)
		{
			notificationService.Notify(NotificationSeverity.Warning, "Uyarı", "Kullanıcı bilgisi yüklenirken bir hata oluştu: " + ex.Message);
		}
	}

	//sistemde kayıtlı tüm kullanıcıları veritabanından yüklemek için kullanılır.
	private async Task YukleKullanicilar()
	{
		TumKullanicilar = await _kullaniciRepo.GetAllAsync();
	}

	//tüm görevleri veritabanından alıp belleğe yükler.
	private async Task YukleGorevler()
	{
		try
		{
			GorevListt = (await DataService.GetGorevler()).ToList();
		}
		catch (Exception ex)
		{
			notificationService.Notify(NotificationSeverity.Error, "Hata", ex.Message);
			return;
		}
	}

	//yeni görev oluşturma akışını başlatır.
	private async Task YeniGorev()
	{
		if (currentUserId == null)
		{
			notificationService.Notify(NotificationSeverity.Error, "Hata", "Kullanıcı bilgisi alınamadı.");
			return;
		}

		var yeniGorev = new ItemGorev
		{
			CreUser = currentUserId ?? 0, 
			Kullanici_ID = currentUserId ?? 0,
			Aktif = true
		};

		var result = await DialogService.OpenAsync<GorevTnm>(
			" ",
			new Dictionary<string, object> { { "Gorev", yeniGorev } },
			new DialogOptions { Width = "600px", Height = "auto", ShowClose = false }
		);

		if (result is ItemGorev g && g.ID > 0)
		{
			await YukleGorevler();
			var existing = GorevListt.FirstOrDefault(x => x.ID == g.ID);
			if (existing != null)
			{
				var index = GorevListt.IndexOf(existing);
				GorevListt[index] = g;
			}
			else
			{
				GorevListt.Insert(0, g);
			}
			StateHasChanged();
			if (GrdGorev != null)
			{
				await GrdGorev.Reload();
			}
		}
	}

	//görevin kime atandığını ekranda göstermek için kullanılır.
	private MarkupString GetAtananKullaniciAdi(int kullaniciId, bool kilitli)
	{
		if (!kilitli)
		{
			return (MarkupString)"—";
		}

		var kullanici = TumKullanicilar.FirstOrDefault(x => x.ID == kullaniciId);
		if (kullanici == null)
		{
			return (MarkupString)"—";
		}

		var adSoyad = $"{kullanici.Adi} {kullanici.Soyadi}".Trim();
		return (MarkupString)adSoyad;
	}

	//aynı görevin kaç kullanıcıya atanmış olduğunu hesaplar.
	private int GetAtananKullaniciSayisi(ItemGorev gorev)
	{
		if (!gorev.Kilitli)
			return 0;

		var ayniBaslikliGorevler = GorevListt.Where(g =>
			g.Kilitli &&
			g.Baslik == gorev.Baslik &&
			g.Kategori_ID == gorev.Kategori_ID &&
			g.BaslangicTarihi == gorev.BaslangicTarihi &&
			g.BitisTarihi == gorev.BitisTarihi &&
			g.DelUser == 0
		).ToList();

		return ayniBaslikliGorevler.Count;
	}

	//aynı görevin kaç kişide tamamlandığını ve toplam kaç kişiye atandığını döner.
	private (int Tamamlanan, int Toplam) GetTamamlanmaBilgisi(ItemGorev gorev)
	{
		if (!gorev.Kilitli)
			return (0, 0);

		var ayniBaslikliGorevler = GorevListt.Where(g =>
			g.Kilitli &&
			g.Baslik == gorev.Baslik &&
			g.Kategori_ID == gorev.Kategori_ID &&
			g.DelUser == 0
		).ToList();

		var toplam = ayniBaslikliGorevler.Count;
		var tamamlanan = ayniBaslikliGorevler.Count(g => g.Tamamlandi);

		return (tamamlanan, toplam);
	}
	//bir görevin kimlere atandığını ve kimin tamamladığını modal pencerede gösterir.
	private async Task ShowAtananKisilerDialog(ItemGorev gorev)
	{
		var ayniBaslikliGorevler = GorevListt.Where(g =>
			g.Kilitli &&
			g.Baslik == gorev.Baslik &&
			g.Kategori_ID == gorev.Kategori_ID &&
			g.BaslangicTarihi == gorev.BaslangicTarihi &&
			g.BitisTarihi == gorev.BitisTarihi &&
			g.DelUser == 0
		).ToList();

		var kullaniciGorevBilgileri = new List<(User Kullanici, ItemGorev Gorev, bool Tamamlandi)>();

		foreach (var gorevKaydi in ayniBaslikliGorevler)
		{
			if (gorevKaydi.Kullanici_ID > 0)
			{
				var kullanici = TumKullanicilar.FirstOrDefault(k => k.ID == gorevKaydi.Kullanici_ID);
				if (kullanici != null)
				{
					kullaniciGorevBilgileri.Add((kullanici, gorevKaydi, gorevKaydi.Tamamlandi));
				}
			}
		}

		var tamamlananSayisi = kullaniciGorevBilgileri.Count(k => k.Tamamlandi);
		var toplamSayisi = kullaniciGorevBilgileri.Count;

		await DialogService.OpenAsync("Atanan Kişiler", ds =>
			@<div style="padding: 20px;">
			<h4 style="margin-bottom: 15px;">@gorev.Baslik</h4>
			<p style="margin-bottom: 15px; color: #666;">
				Bu görev <strong>@toplamSayisi</strong> kişiye atanmıştır.
				<span style="margin-left: 10px; padding: 4px 8px; border-radius: 4px; background-color: @(tamamlananSayisi == toplamSayisi ? "#4caf50" : tamamlananSayisi > 0 ? "#ff9800" : "#f5f5f5"); color: @(tamamlananSayisi == toplamSayisi ? "white" : tamamlananSayisi > 0 ? "white" : "#666"); font-weight: bold;">
					@tamamlananSayisi / @toplamSayisi Tamamlandı
				</span>
			</p>
			<ul style="list-style: none; padding: 0;">
				@foreach (var (kullanici, gorevKaydi, tamamlandi) in kullaniciGorevBilgileri.OrderBy(k => k.Kullanici.Adi))
				{
					<li style="padding: 12px; margin-bottom: 8px; background: #f9f9f9; border-radius: 6px; border-left: 4px solid @(tamamlandi ? "#4caf50" : "#e0e0e0");">
						<div style="display: flex; justify-content: space-between; align-items: center;">
							<div>
								<span style="font-weight: 600; font-size: 14px;">@kullanici.Adi @kullanici.Soyadi</span>
							</div>
							<div>
								@if (tamamlandi)
								{
									<span style="padding: 4px 12px; border-radius: 4px; background-color: #4caf50; color: white; font-size: 12px; font-weight: 600;">
										✓ Tamamlandı
									</span>
								}
								else
								{
									<span style="padding: 4px 12px; border-radius: 4px; background-color: #e0e0e0; color: #666; font-size: 12px; font-weight: 600;">
										○ Beklemede
									</span>
								}
							</div>
						</div>
					</li>
				}
			</ul>
			<div style="margin-top: 20px; text-align: right;">
				<RadzenButton Text="Kapat" ButtonStyle="ButtonStyle.Secondary" Click="@(() => ds.Close())" />
			</div>
		</div>
	,
		new DialogOptions { Width = "600px", Height = "auto", ShowClose = false });
	}

	//seçilen görevi düzenlemek için dialog açar ve sonucu uygular.
	private async Task Duzenle(ItemGorev gorev)
	{
		if (currentUserId.HasValue)
		{
			gorev.UpdUser = currentUserId.Value;
		}
		var result = await DialogService.OpenAsync<GorevTnm>(" ",
			new Dictionary<string, object> { { "Gorev", gorev } },
			new DialogOptions { Width = "600px", Height = "auto", ShowClose = false });

		if (result is ItemGorev guncellendi)
		{
			if (guncellendi.ID == 0)
			{

			}
			else
			{
				await YukleGorevler();
				var existing = GorevListt.FirstOrDefault(x => x.ID == guncellendi.ID);
				if (existing != null)
				{
					var index = GorevListt.IndexOf(existing);
					GorevListt[index] = guncellendi;
				}
				StateHasChanged();
				if (GrdGorev != null)
				{
					await GrdGorev.Reload();
				}
				notificationService.Notify(NotificationSeverity.Success, "Başarılı", "Görev güncellendi!");
			}
		}
	}

	//, bir görev silme sürecini yönetir. İşleyişi şöyle:
	private async Task Sil(ItemGorev gorev)
	{
		bool? onay = await DialogService.Confirm("Görevi silmek istiyor musunuz?", "Onay",
			new ConfirmOptions { OkButtonText = "Evet", CancelButtonText = "Hayır" });

		if (onay == true)
		{
			if (currentUserId.HasValue)
			{
				gorev.DelUser = currentUserId.Value;
			}
			var wsCvp = await DataService.SetGorev(gorev);

			if (wsCvp.SonucKodu == 0)
			{
				if (currentUserId.HasValue)
				{
					await DataService.SetGorevLog(new ItemGorevLoglari
					{
						Gorev_ID = gorev.ID,
						IslemTipi = "Silindi",
						AlanAdi = "Tümü",
						EskiDeger = $"Görev: {gorev.Baslik}",
						YeniDeger = "",
						IslemKullanici_ID = currentUserId.Value,
						IslemTarih = DateTime.Now
					});
				}
				GorevListt.Remove(gorev);
				await GrdGorev!.Reload();
				notificationService.Notify(NotificationSeverity.Success, "Silindi", "Görev silindi!");
			}
			else
			{
				notificationService.Notify(NotificationSeverity.Error, "Hata", "Silme başarısız.");
			}
		}
	}

	//Satırlara çift tıklayınca olcak olan şeyleri yapar.
	private async Task OnRowDoubleClick(DataGridRowMouseEventArgs<ItemGorev> args)
	{
		await Duzenle(args.Data);
	}

	//bir görevin aktif/pasif durumunu değiştirme işlevini yönetir. Adım adım açıklayalım:
	private async Task ToggleDurum(ItemGorev item)
	{
		try
		{
			if (item.Tamamlandi)
			{
				notificationService.Notify(NotificationSeverity.Warning, "Uyarı", "Görev zaten tamamlandı. Aktiflik durumunu değiştirmek için önce Tamamlandı işaretini kaldırın.");
				return;
			}
			item.Aktif = !item.Aktif;
			if (currentUserId.HasValue)
			{
				item.UpdUser = currentUserId.Value;
			}

			var sonuc = await DataService.SetGorev(item);

			if (sonuc.SonucKodu == 0)
			{
				if (currentUserId.HasValue)
				{
					await DataService.SetGorevLog(new ItemGorevLoglari
					{
						Gorev_ID = item.ID,
						IslemTipi = "Güncellendi",
						AlanAdi = "Aktif",
						EskiDeger = (!item.Aktif).ToString(),
						YeniDeger = item.Aktif.ToString(),
						IslemKullanici_ID = currentUserId.Value,
						IslemTarih = DateTime.Now
					});
				}
				notificationService.Notify(NotificationSeverity.Success, "Durum Güncellendi", item.Aktif ? "Görev aktif hale getirildi." : "Görev pasif hale getirildi.");

				GorevListt = (await DataService.GetGorevler()).ToList();
				StateHasChanged();
				if (GrdGorev != null)
				{
					await GrdGorev.Reload();
				}
			}
			else
			{
				notificationService.Notify(NotificationSeverity.Error, "Hata", sonuc.SonucAciklama);
				item.Aktif = !item.Aktif;
			}
		}
		catch (Exception ex)
		{
			notificationService.Notify(NotificationSeverity.Error, "Hata", ex.Message);
		}
	}

	//bir görevin tamamlandı/tamamlanmadı durumunu değiştirme işlemini yönetir. İ
	private async Task ToggleTamamlandi(ItemGorev item)
	{
		try
		{
			if (!item.Tamamlandi && item.BaslangicTarihi.HasValue && item.BaslangicTarihi.Value > DateTime.Now)
			{
				notificationService.Notify(NotificationSeverity.Warning, "Uyarı", "Görev zamanı gelmediği için tamamlandı olarak işaretlenemez.");
				return;
			}

			if (!item.Tamamlandi)
			{
				item.Aktif = true;
			}

			if (currentUserId.HasValue)
			{
				item.UpdUser = currentUserId.Value;
			}

			var sonuc = await DataService.SetGorev(item);

			if (sonuc.SonucKodu == 0)
			{
				if (item.Tamamlandi && !string.IsNullOrEmpty(item.TekrarlamaTipi) && item.TekrarlamaTipi != "Yok")
				{
					await OlusturTekrarlayanGorev(item);
				}

				notificationService.Notify(NotificationSeverity.Success, "Durum Güncellendi", item.Tamamlandi ? "Görev tamamlandı olarak işaretlendi." : "Görev tamamlanmadı olarak işaretlendi.");

				GorevListt = (await DataService.GetGorevler()).ToList();

				if (item.Tamamlandi)
				{
					SelectedTabIndex = 2;
				}
				else
				{
					SelectedTabIndex = 0;
				}

				StateHasChanged();
				if (GrdGorev != null)
				{
					await GrdGorev.Reload();
				}
			}
			else
			{
				notificationService.Notify(NotificationSeverity.Error, "Hata", sonuc.SonucAciklama);

				item.Tamamlandi = !item.Tamamlandi;
				item.Aktif = !item.Aktif;
			}
		}
		catch (Exception ex)
		{
			notificationService.Notify(NotificationSeverity.Error, "Hata", ex.Message);
			item.Tamamlandi = !item.Tamamlandi;
			item.Aktif = !item.Aktif;
		}
	}

	// Tekrarlayan görev oluşturma metodu
	private async Task OlusturTekrarlayanGorev(ItemGorev eskiGorev)
	{
		try
		{
			var yeniGorev = new ItemGorev
			{
				Kullanici_ID = eskiGorev.Kullanici_ID,
				Baslik = eskiGorev.Baslik,
				Kategori_ID = eskiGorev.Kategori_ID,
				OnemDerecesi = eskiGorev.OnemDerecesi,
				TekrarlamaTipi = eskiGorev.TekrarlamaTipi,
				TekrarAraligi = eskiGorev.TekrarAraligi,
				HaftaninGunu = eskiGorev.HaftaninGunu,
				AyinGunu = eskiGorev.AyinGunu,
				Kilitli = eskiGorev.Kilitli,
				Aktif = true,
				Tamamlandi = false,
				CreUser = eskiGorev.CreUser,

				BaslangicTarihi = eskiGorev.SonrakiCalismaTarihi ?? DateTime.Now
			};

			if (eskiGorev.BaslangicTarihi.HasValue && eskiGorev.BitisTarihi.HasValue)
			{
				var sureFarki = eskiGorev.BitisTarihi.Value - eskiGorev.BaslangicTarihi.Value;
				yeniGorev.BitisTarihi = yeniGorev.BaslangicTarihi.Value.Add(sureFarki);
			}

			HesaplaSonrakiCalismaTarihi(yeniGorev);

			var sonuc = await DataService.SetGorev(yeniGorev);

			if (sonuc.SonucKodu == 0)
			{
				notificationService.Notify(NotificationSeverity.Info, "Tekrarlayan Görev",
					$"Yeni görev oluşturuldu: {yeniGorev.BaslangicTarihi:dd.MM.yyyy}");
			}
		}
		catch (Exception ex)
		{
			notificationService.Notify(NotificationSeverity.Warning, "Uyarı",
				$"Tekrarlayan görev oluşturulamadı: {ex.Message}");
		}
	}

	// SonrakiCalismaTarihi hesaplama
	private void HesaplaSonrakiCalismaTarihi(ItemGorev gorev)
	{
		if (gorev.BaslangicTarihi == null) return;

		var baslangic = gorev.BaslangicTarihi.Value;
		var aralik = gorev.TekrarAraligi ?? 1;

		switch (gorev.TekrarlamaTipi)
		{
			case "Günlük":
				gorev.SonrakiCalismaTarihi = baslangic.AddDays(aralik);
				break;

			case "Haftalık":
				if (!string.IsNullOrEmpty(gorev.HaftaninGunu))
				{
					// Virgülle ayrılmış günleri parse et ve sırala
					var seciliGunler = gorev.HaftaninGunu.Split(',', StringSplitOptions.RemoveEmptyEntries)
						.Select(g => g.Trim())
						.Select(g => MapHaftaninGunu(g))
						.OrderBy(g => g)
						.ToList();

					if (seciliGunler.Any())
					{
						// Bitiş tarihi varsa, bir sonraki haftanın ilk seçili gününü bul
						if (gorev.BitisTarihi.HasValue)
						{
							var bitisTarihi = gorev.BitisTarihi.Value.Date;
							var ilkGun = seciliGunler.First();

							// Bitiş tarihinden bir sonraki haftanın ilk seçili gününü bul
							var sonrakiHaftaBaslangic = bitisTarihi.AddDays(1); // Bitiş tarihinden sonraki gün

							// Sonraki haftanın ilk seçili gününe ulaş
							while (sonrakiHaftaBaslangic.DayOfWeek != ilkGun)
							{
								sonrakiHaftaBaslangic = sonrakiHaftaBaslangic.AddDays(1);
							}

							// Saat bilgisini başlangıç tarihinden al
							gorev.SonrakiCalismaTarihi = sonrakiHaftaBaslangic.Add(baslangic.TimeOfDay);
						}
						else
						{
							// Bitiş tarihi yoksa, başlangıç tarihinden sonraki en yakın seçilen günü bul
							var ilkGun = seciliGunler.First();
							var tarih = baslangic;
							while (tarih.DayOfWeek != ilkGun)
							{
								tarih = tarih.AddDays(1);
							}
							gorev.SonrakiCalismaTarihi = tarih.AddDays(7 * (aralik - 1));
						}
					}
					else
					{
						gorev.SonrakiCalismaTarihi = baslangic.AddDays(7 * aralik);
					}
				}
				else
				{
					gorev.SonrakiCalismaTarihi = baslangic.AddDays(7 * aralik);
				}
				break;

			case "Aylık":

				if (!gorev.BaslangicTarihi.HasValue)
					break;

				int aralikAy = gorev.TekrarAraligi ?? 1;
				if (aralikAy < 1) aralikAy = 1;

				// İlk tekrar ayı = başlangıç + aralık
				DateTime hedefAy = baslangic.AddMonths(aralikAy);

				if (gorev.AyinGunu.HasValue)
				{
					int hedefGun = gorev.AyinGunu.Value;
					int maxGun = DateTime.DaysInMonth(hedefAy.Year, hedefAy.Month);

					gorev.SonrakiCalismaTarihi = new DateTime(
						hedefAy.Year,
						hedefAy.Month,
						Math.Min(hedefGun, maxGun),
						baslangic.Hour,
						baslangic.Minute,
						baslangic.Second
					);
				}
				else
				{
					gorev.SonrakiCalismaTarihi = hedefAy;
				}

				break;
		}
	}

	//bir Türkçe gün adını alıp karşılık gelen DayOfWeek enum değerine çevirir.
	private DayOfWeek MapHaftaninGunu(string gun)
	{
		return gun?.ToLower() switch
		{
			"pazartesi" => DayOfWeek.Monday,
			"salı" => DayOfWeek.Tuesday,
			"çarşamba" => DayOfWeek.Wednesday,
			"perşembe" => DayOfWeek.Thursday,
			"cuma" => DayOfWeek.Friday,
			"cumartesi" => DayOfWeek.Saturday,
			"pazar" => DayOfWeek.Sunday,
			_ => DayOfWeek.Monday
		};
	}

	//bir görevin önem derecesini alıp ona karşılık gelen renk kodunu döndürür.
	private string GetOnemRengi(string onem)
	{
		return onem?.ToLower() switch
		{
			"yüksek" => "#e74c3c",
			"orta" => "#f1c40f",
			"düşük" => "#2ecc71",
			_ => "#95a5a6" 
		};
	}	

	//bir görevi oluşturan kullanıcının adını alır ve döndürür.
	private MarkupString GetAtayanKullaniciAdi(int? creUserId)
	{
		if (!creUserId.HasValue || creUserId.Value == 0)
			return (MarkupString)"—";

		var kullanici = TumKullanicilar.FirstOrDefault(x => x.ID == creUserId.Value);
		return kullanici != null
			? (MarkupString)($"{kullanici.Adi} {kullanici.Soyadi}")
			: (MarkupString)"-";

	}

	//bir görev satırı seçildiğinde çalışır ve seçili görev listesini düzenlemeye geçer.
	private void OnRowSelect(ItemGorev gorev)
	{
		SeciliGorevler.Clear();
		SeciliGorevler.Add(gorev);
	}

	//bir görev satırının stilini (renklendirmesini) belirler.
	private string GorevRowStyle(ItemGorev g, int rowIndex)
	{
		if (SeciliGorevler.Any() && g.ID == SeciliGorevler.First().ID)
			return "background-color:#d1e7dd; !important";
		return string.Empty;
	}

