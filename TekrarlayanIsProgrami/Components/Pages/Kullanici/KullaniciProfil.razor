@page "/Profil"

<html>
    <head>
    <link href="css/site.css" rel="stylesheet" />
    </head>
<body>

    @if (kullanici != null)
    {
     <div class="profile-card">
     <h2>Profil</h2>
    <h3>@kullanici.Adi @kullanici.Soyadi</h3>
    <p>@kullanici.EPosta</p>
    <RadzenButton @onclick="CikisYap" class="radzenprofile-but" Text="Çıkış Yap"></RadzenButton>
    </div>
    }
    else
    {
        <p>Kullanıcı bilgileri yükleniyor veya bulunamadı...</p>
    }
</body>
</html>
@code {
    private User? kullanici;

    protected override async Task OnInitializedAsync()
    {
         var girisDurumu = await girisSaglayici.GetAuthenticationStateAsync();
         var kullaniciBilgi = girisDurumu.User;

        if (kullaniciBilgi.Identity != null && kullaniciBilgi.Identity.IsAuthenticated)
         {
            var eposta = kullaniciBilgi.FindFirst("eposta")?.Value;

             if (!string.IsNullOrEmpty(eposta))
             {
                 kullanici = await _kullaniciRepo.GetByEmailAsync(eposta);
             }
            
         }
    }
    private void CikisYap()
    {
        NavigationManager.NavigateTo("/GirisYap", true);
    }
}
