    //aylık tekrar eden görevlerin bir sonraki tarihini hesaplamak için kullanılıyor.
    public static DateTime HesaplaAylikTarih(DateTime baslangic,int ayinGunu,int tekrarAraligi,DateTime? oncekiCalismaTarihi = null)
    {
        if (tekrarAraligi < 1)
            tekrarAraligi = 1;

        // Eğer daha önce çalıştıysa zincir devam eder
        DateTime referans = oncekiCalismaTarihi ?? baslangic;

        // Eğer ilk oluşturuluyorsa
        if (oncekiCalismaTarihi == null)
        {
            int maxGun = DateTime.DaysInMonth(referans.Year, referans.Month);

            DateTime aday = new DateTime(
                referans.Year,
                referans.Month,
                Math.Min(ayinGunu, maxGun),
                referans.Hour,
                referans.Minute,
                referans.Second
            );

            if (aday > baslangic)
                return aday;

            referans = referans.AddMonths(tekrarAraligi);
        }
        else
        {
            referans = referans.AddMonths(tekrarAraligi);
        }

        int maxGunYeniAy = DateTime.DaysInMonth(referans.Year, referans.Month);

        return new DateTime(
            referans.Year,
            referans.Month,
            Math.Min(ayinGunu, maxGunYeniAy),
            referans.Hour,
            referans.Minute,
            referans.Second
        );
    }

    //Sadece ilk aylık görev tarihini hesaplamak için yazılmış bir basitleştirilmiş versiyondur.
    private DateTime HesaplaAylikTarihIlkGorev(DateTime bugun, int ayinGunu)
    {
        var yil = bugun.Year;
        var ay = bugun.Month;

        // sadece geçmiş günse sonraki aya geç
        if (ayinGunu < bugun.Day)
        {
            ay += 1;
            if (ay > 12)
            {
                ay = 1;
                yil += 1;
            }
        }

        int gun = Math.Min(ayinGunu, DateTime.DaysInMonth(yil, ay));

        return new DateTime(
            yil,
            ay,
            gun,
            bugun.Hour,
            bugun.Minute,
            bugun.Second
        );
    }
}
