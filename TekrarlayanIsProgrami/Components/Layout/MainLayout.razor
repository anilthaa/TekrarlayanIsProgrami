@inherits LayoutComponentBase

<RadzenComponents @rendermode="InteractiveServer" />
<RadzenNotification />

<RadzenLayout>
    @{
        var uri = NavigationManager.Uri.ToLower();
    }

    @if (!uri.Contains("/girisyap"))
    {
        <RadzenSidebar>
            @if (IsLoading)
            {
                <div class="nav-link" style="opacity:0.6;">
                    Menü yükleniyor...
                </div>
            }
            else if (!VisibleMenus.Any())
            {
                <div class="nav-link" style="opacity:0.6;">
                    Menü bulunamadı
                </div>
            }
            else
            {
                <RadzenCard class="dashboard-nav">

                    <a href="/dashboard" style="text-decoration:none; color:white;">
                        <h3>📊 Dashboard</h3>
                    </a>

                    @foreach (var anaMenu in VisibleMenus.Where(x => (x.UstMenu_ID == 0 || x.UstMenu_ID == null) && x.IsMenu).OrderBy(x => x.Sira))
                    {
                        var altMenuler = VisibleMenus
                        .Where(x => x.UstMenu_ID == anaMenu.ID && x.IsMenu)
                        .OrderBy(x => x.Sira)
                        .ToList();

                        <div class="nav-link"
                             style="cursor:pointer;"
                             @onclick="@(() =>
                             {
                                 ToggleMenu(anaMenu.ID);

                                 if (!string.IsNullOrWhiteSpace(anaMenu.SayfaURL))
                                 {
                                     NavigationManager.NavigateTo(GetHref(anaMenu));
                                 }
                             })">

                            @if (!string.IsNullOrWhiteSpace(anaMenu.Icon))
                            {
                                <span class="@anaMenu.Icon" style="margin-right:6px;"></span>
                            }

                            @anaMenu.Adi
                        </div>

                        @if (altMenuler.Any() && AcikMenuler.Contains(anaMenu.ID))
                        {
                            <div class="dropdown-container">
                                @foreach (var alt in altMenuler)
                                {
                                    <div class="nav-link"
                                         @onclick="@(() => NavigationManager.NavigateTo(GetHref(alt)))">
                                        @alt.Adi
                                    </div>
                                }
                            </div>
                        }
                    }

                    <div style="position: absolute;bottom: 20px;left: 0;width: 100%; display: flex; flex-direction: column; align-items: center;gap: 10px;padding: 0 10px;box-sizing: border-box; ">
                        <RadzenButton Text="Profil"
                                      Click="@ProfilPopupAc"
                                      Style="width:100%; max-width:220px; background-color:transparent; color:white;" />

                        <RadzenButton Text="Çıkış Yap"
                                      Click="@CikisYap"
                                      Style="width:100%; max-width:220px; background-color:transparent; color:white;" />
                    </div>

                </RadzenCard>
            }
        </RadzenSidebar>
    }

    <RadzenBody>
        @Body
    </RadzenBody>
</RadzenLayout>

@code {

    private List<ItemForm> VisibleMenus = new();

    private bool IsLoading = true;
    private HashSet<int> AcikMenuler = new();

    private int currentUserTipId = 0;
    private User? currentUser;

    protected override async Task OnInitializedAsync()
    {
        currentUser = await girisSaglayici.GetCurrentUserAsync();
        await LoadMenusAsync();
    }

    private async Task LoadMenusAsync()
    {
        IsLoading = true;

        if (currentUser == null)
        {
            VisibleMenus = new List<ItemForm>();
            IsLoading = false;
            return;
        }
        VisibleMenus = (await DataService.GetMenusByRoleAsync(currentUser));
        foreach (var m in VisibleMenus)
        {
            
        }


        IsLoading = false;
    }

    private string GetHref(ItemForm form)
    {
        if (string.IsNullOrWhiteSpace(form.SayfaURL))
            return "#";

        return form.SayfaURL.StartsWith("/")
            ? form.SayfaURL
            : "/" + form.SayfaURL;
    }

    private void ToggleMenu(int id)
    {
        if (!AcikMenuler.Add(id))
            AcikMenuler.Remove(id);
    }

    private async void CikisYap()
    {
        try
        {
            var currentUser = await girisSaglayici.GetCurrentUserAsync();
            if (currentUser != null)
            {
                await DataService.SetKullaniciLog(new ItemKullaniciLog
                {
                    Kullanici_ID = currentUser.ID,
                    IslemTipi = "Cikis",
                    IslemTarihi = DateTime.Now,
                    Aciklama = "Kullanıcı çıkış yaptı",
                    CreUser = currentUser.ID
                });
            }
        }
        catch { }

        await ((CustomAuthenticationStateProvider)girisSaglayici).MarkUserAsLoggedOut();
        await PermissionService.RefreshAsync();
        NavigationManager.NavigateTo("/GirisYap", true);
    }

    async Task ProfilPopupAc()
    {
        await DialogService.OpenAsync<KullaniciProfil>(
            "Profil Bilgileri",
            null,
            new DialogOptions
            {
                Width = "550px",
                Height = "auto",
                Resizable = false,
                Draggable = true,
                CloseDialogOnOverlayClick = true
            });
    }
}