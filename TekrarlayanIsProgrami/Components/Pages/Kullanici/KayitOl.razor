@layout MainLayout

<RadzenCard class="max-width:600px; margin:auto; padding:20px;">

	<h3 class="card-title text-center mb-4">Kullanıcı Ekle</h3>
	<RadzenTemplateForm Data="@newUser" TItem="User" Submit="@OnSubmit">
		<RadzenFieldset Text="Bilgiler" Style="margin-bottom:15px;">
			<DataAnnotationsValidator />
			<RadzenFormField Text="Ad" Style="width:85%; margin-left:41px; margin-top:4px;">
			<RadzenTextBox class="form-control" @bind-Value="newUser.Adi" />
			</RadzenFormField>
			<ValidationMessage For="@(() => newUser.Adi)"></ValidationMessage>

			<RadzenFormField Text="Soyad" Style="width:85%; margin-left:41px; margin-top:4px;">
			<RadzenTextBox class="form-control" @bind-Value="newUser.Soyadi"/>
			</RadzenFormField>
			<ValidationMessage For="@(()=> newUser.Soyadi)"></ValidationMessage>

			<RadzenFormField Text="E-posta" Style="width:85%; margin-left:41px; margin-top:4px;">
			<RadzenTextBox class="form-control" @bind-Value="newUser.EPosta" />
			</RadzenFormField>
			<ValidationMessage For="@(() => newUser.EPosta)"></ValidationMessage>

			<RadzenFormField Text="Şifre" Style="width:85%; margin-left:41px; margin-top:4px;">
			<RadzenPassword class="form-control" @bind-Value="newUser.Sifre" />
			</RadzenFormField>
			<ValidationMessage For="@(() => newUser.Sifre)"></ValidationMessage>

			<RadzenFormField Text="Şifre Tekrar" Style="width:85%; margin-left:41px; margin-top:4px;">
			<RadzenPassword type="password" @bind-Value="newUser.SifreTekrar"/>
			</RadzenFormField>
			<ValidationMessage For="@(() => newUser.SifreTekrar)"></ValidationMessage>
			<RadzenCard class="btn-group">
				<RadzenButton Text="Kaydet" Icon="save" Style="width:30%; margin:auto;" class="radzen-button"></RadzenButton>
				<RadzenButton Text="İptal"  Icon="cancel" Click="@Iptal" Style="width:30%; margin:auto;" class="radzen-button"></RadzenButton>
			</RadzenCard>
		</RadzenFieldset>
	</RadzenTemplateForm>

</RadzenCard>

@code {
	private User newUser = new User
	{
		CreUser = 1,
		CreDate = DateTime.Now,
		Aktif = true
	};

	private async Task OnSubmit()
	{
		if (!EpostaGecerliMi(newUser.EPosta))
		{
			notificationService.Notify(NotificationSeverity.Error, "Hata", "E-posta Yalnızca gmail.com veya hotmail.com Olmalıdır.");
			return;
		}

		if(newUser.Sifre!= newUser.SifreTekrar)
		{
			notificationService.Notify(NotificationSeverity.Error, "Hata", "Şifre ile Tekrar Şifre Aynı Olmak Zorunda.");
			return;
		}

		var result = await girisSaglayici.KayitOlAsync(newUser);
		if (result.Basarili)
		{
			notificationService.Notify(NotificationSeverity.Success, "Başarılı", "Kayıt Başarıyla Tamamlandı.");
			NavigationManager.NavigateTo("/kullanicilar");
			StateHasChanged();
		}
		else
		{
			notificationService.Notify(NotificationSeverity.Error,"Hata","Kayıt Sırasında Bir Hta Oluştu.");
		}
		DialogService.Close(true);
	}
	private bool EpostaGecerliMi(string eposta)
	{
		if (string.IsNullOrWhiteSpace(eposta))
			return false;

		var desen = @"^[\w\.-]+@(gmail\.com|hotmail\.com)$";
		return Regex.IsMatch(eposta, desen, RegexOptions.IgnoreCase);
	}


	private void Iptal()
	{
		NavigationManager.NavigateTo(geriUrl);
		notificationService.Notify(NotificationSeverity.Warning, "UYARI", "Kayıt İşleminiz İptal Edildi.");
	}
	private string geriUrl = "/kullanicilar";
}
