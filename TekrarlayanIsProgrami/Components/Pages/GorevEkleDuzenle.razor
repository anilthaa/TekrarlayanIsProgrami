@page "/GorevEkle"

<RadzenCard Style="max-width:600px; margin:auto; padding:20px;">
	<h3 style="text-align:center; margin-bottom:20px;">Görev Ekle / Düzenle</h3>
	<RadzenTemplateForm Data="@Gorev" TItem="ItemGorev" Submit="@OnSubmit">
	<ChildContent>
		<div class="row">
			<div class="col-md-6">	
				<RadzenLabel Text="Önem Derecesi" Component="Onem"></RadzenLabel>
				<RadzenDropDown @bind-Value="Gorev.OnemDerecesi" Data="@onemDereceleri" Style="width:100%"></RadzenDropDown>
			</div>
			<div class="col-md-6">
				<RadzenLabel Text="Tekrarlama Tipi" Component="Tekrar"></RadzenLabel>
				<RadzenDropDown @bind-Value="Gorev.TekrarlamaTipi" Data="@tekrarTipleri" Style="width:100%"></RadzenDropDown>
			</div>
		</div>

		@if (Gorev.TekrarlamaTipi=="Günlük")
		{
				<div class="row" style="margin-top:15px;">
					<div class="col-md-12">
						<RadzenLabel Text="Tekrar Aralığı (Gün)"></RadzenLabel>
						<RadzenNumeric @bind-Value="Gorev.TekrarAraligi" TValue="int?" Style="width:100%"></RadzenNumeric>
					</div>
				</div>
		}

		@if (Gorev.TekrarlamaTipi=="Haftalık")
		{
			<div class="row" style="margin-top:15px;">
				<div class="col-md-12">
					<RadzenLabel Text="Haftanın Günü"></RadzenLabel>
					<RadzenDropDown @bind-Value="Gorev.HaftaninGunu" Data="@haftaninGunleri" Style="width:100%"></RadzenDropDown>
				</div>
			</div>	
		}

		@if (Gorev.TekrarlamaTipi=="Aylık")
		{
			<div class="row" style="margin-top:15px;">
				<div class="col-md-12">
					<RadzenLabel Text="Ayın Günü"></RadzenLabel>
					<RadzenNumeric @bind-Value="Gorev.AyinGunu" TValue="int?" Style="width:100%"></RadzenNumeric>
				</div>
			</div>	
		}


		<div class="row" style="margin-top:15px;">
			<div class="col-md-6">
				<RadzenLabel Text="Başlangıç Tarihi" Component="Baslangic"></RadzenLabel>
				<RadzenDatePicker @bind-Value="Gorev.BaslangicTarihi" Style="width:100%"></RadzenDatePicker>
			</div>
			<div class="col-md-6">
				<RadzenLabel Text="Bitiş Tarihi" Component="Bitis"></RadzenLabel>
				<RadzenDatePicker @bind-Value="Gorev.BitisTarihi" Style="width:100%"></RadzenDatePicker>
			</div>
		</div>

		<div class="row" style="margin-top:15px;">
			<div class="col-md-12">
				<RadzenLabel Text="Başlık" Component="Baslik"></RadzenLabel>
				<RadzenTextBox @bind-Value="Gorev.Baslik" Style="width:100%" Name="Baslik"></RadzenTextBox>
			</div>
		</div>
		<div class="row" style="margin-top:15px;">
			<div class="col-md-6">
				<RadzenLabel Text="Kategori" Component="Kategori"></RadzenLabel>
				<RadzenDropDown @bind-Value="Gorev.Kategori_ID" Data="@kategoriler" TextProperty="Adi" ValueProperty="ID" Style="width:100%" Placeholder="Kategori Seçin"></RadzenDropDown>
			</div>
			<div class="col-md-6">
				<RadzenCheckBox @bind-Value="Gorev.Kilitli" TValue="bool"></RadzenCheckBox>
				<RadzenLabel Text="Kilitli Görev" Style="margin-left:5px;"></RadzenLabel>
			</div>
		</div>
		@if (Gorev.Kilitli)
		{
			<div class="row" style="margin-top:15px;">
				<div class="col-md-12">
					<RadzenLabel Text="Görev Sahibi" Component="Kullanici"></RadzenLabel>
					<RadzenDropDown @bind-Value="Gorev.Kullanici_ID" Data="@kullanicilar" TextProperty="Adi" ValueProperty="ID" Style="width:100%" Placeholder="Kullanıcı Seçin"></RadzenDropDown>
				</div>
			</div>	
		}

		<div style="margin-top:20px; text-align:center;">
				<RadzenButton Text="Kaydet" ButtonType="ButtonType.Submit" Style="background:#3498db; color:white; border:none; border-radius:6px; padding:10px 20px;"></RadzenButton>
		</div>
	</ChildContent>
</RadzenTemplateForm> 
</RadzenCard>



@code {
	[Parameter] public ItemGorev Gorev { get; set; } = new();

	private List<string> onemDereceleri = new() { "Düşük", "Orta", "Yüksek" };
	private List<string> tekrarTipleri = new() { "Yok", "Günlük", "Haftalık", "Aylık" };
	private List<string> haftaninGunleri = new() { "Pazartesi", "Salı", "Çarşamba", "Perşembe", "Cuma", "Cumartesi", "Pazar" };
	private List<ItemKategori> kategoriler = new();
	private List<User> kullanicilar = new();

	protected override async Task OnInitializedAsync()
	{
		kategoriler = await KategoriRepo.GetAllAsync();
		kullanicilar = await _kullaniciRepo.GetAllAsync();

		if (Gorev.ID==0)
		{
			Gorev.Aktif = true;
			Gorev.Kilitli = false;
			Gorev.BaslangicTarihi = DateTime.Today;
			Gorev.BitisTarihi = DateTime.Today.AddDays(1);
		}
	}

	private DayOfWeek MapHaftaninGunu(string gun)
	{
		return gun switch
		{
			"Pazartesi" => DayOfWeek.Monday,
			"Salı" => DayOfWeek.Tuesday,
			"Çarşamba" => DayOfWeek.Wednesday,
			"Perşembe" => DayOfWeek.Thursday,
			"Cuma" => DayOfWeek.Friday,
			"Cumartesi" => DayOfWeek.Saturday,
			"Pazar" => DayOfWeek.Sunday,
			_ => DayOfWeek.Monday
		};
	}

	private void HesaplaSonrakiCalismaTarihi(ItemGorev gorev)
	{
		if (gorev.BaslangicTarihi==null) return;


		var baslangic = gorev.BaslangicTarihi.Value;
		var aralik = gorev.TekrarAraligi ?? 1;

		switch (gorev.TekrarlamaTipi)
		{
			case "Günlük":
				gorev.SonrakiCalismaTarihi = baslangic.AddDays(aralik);
				break;

			case "Haftalık":
				if (!string.IsNullOrEmpty(gorev.HaftaninGunu))
				{
					var hedefGun = MapHaftaninGunu(gorev.HaftaninGunu);
					var tarih = baslangic;
					while(tarih.DayOfWeek!=hedefGun)
					{
						tarih = tarih.AddDays(1);
					}
					gorev.SonrakiCalismaTarihi = tarih.AddDays(7 * (aralik - 1));
				}
				else
				{
					gorev.SonrakiCalismaTarihi = baslangic.AddDays(7 * aralik);
				}
				break;

			case "Aylık":
				if (gorev.AyinGunu.HasValue)
				{
					var maxGun = DateTime.DaysInMonth(baslangic.Year, baslangic.Month);
					var ayinGunu = Math.Min(gorev.AyinGunu.Value, maxGun);

					var tarih = new DateTime(baslangic.Year, baslangic.Month, ayinGunu);
					if (tarih <= baslangic)
						tarih = tarih.AddMonths(aralik);

					gorev.SonrakiCalismaTarihi = tarih;
				}
				else
				{
					gorev.SonrakiCalismaTarihi = baslangic.AddMonths(aralik);
				}
				break;

			case "Yok":
			default:
				gorev.SonrakiCalismaTarihi=gorev.BitisTarihi;
				break;
		}
	}

	public static void GuncelleSonrakiCalismaTarihi(ItemGorev gorev)
	{
		if (gorev.SonrakiCalismaTarihi==null)
		{
			gorev.SonrakiCalismaTarihi = gorev.BaslangicTarihi;
			return;
		}

		var aralik = gorev.TekrarAraligi ?? 1;
		var simdiki = gorev.SonrakiCalismaTarihi.Value;

		switch(gorev.TekrarlamaTipi)
		{
			case "Günlük":
				gorev.SonrakiCalismaTarihi = simdiki.AddDays(aralik);
				break;

			case "Haftalık":
				gorev.SonrakiCalismaTarihi = simdiki.AddDays(7 * aralik);
				break;

			case "Aylık":
				gorev.SonrakiCalismaTarihi = simdiki.AddMonths(aralik);
				break;

			case "Yok":
			default:
				gorev.SonrakiCalismaTarihi = null;
				break;
		}
	}

	private async Task OnSubmit()
	{
		if (Gorev.BitisTarihi < Gorev.BaslangicTarihi)
		{
			bildirimServisi.Notify(NotificationSeverity.Error, "Hata", "Bitiş tarihi başlangıç tarihinden küçük olamaz!");
			return;
		}

		if (Gorev.Kilitli && Gorev.Kullanici_ID==0)
		{
			bildirimServisi.Notify(NotificationSeverity.Error, "Hata", "Kilitli görev için kullanıcı seçmeniz gerekiyor!");
			return;
		}


		if (Gorev.TekrarlamaTipi=="Günlük"&& !Gorev.TekrarAraligi.HasValue)
		{
			bildirimServisi.Notify(NotificationSeverity.Error, "Hata", "Günlük tekrar için aralık girmeniz gerekiyor!");
			return;
		}

		if (Gorev.TekrarlamaTipi=="Haftalık" && string.IsNullOrEmpty(Gorev.HaftaninGunu))
		{
			bildirimServisi.Notify(NotificationSeverity.Error, "Hata", "Haftalık tekrar için gün seçmeniz gerekiyor!");
			return;
		}

		if (Gorev.TekrarlamaTipi=="Aylık"&& !Gorev.AyinGunu.HasValue)
		{
			bildirimServisi.Notify(NotificationSeverity.Error, "Hata", "Aylık tekrar için gün girmeniz gerekiyor!");
			return;
		}

		HesaplaSonrakiCalismaTarihi(Gorev);
		
		if (Gorev.ID==0)
		{
			Gorev.CreUser = 1;
			await GorevRepo.InsertAsync(Gorev);
			bildirimServisi.Notify(NotificationSeverity.Success, "Başarılı", "Görev Eklendi!");
		}
		else
		{
			Gorev.UpdUser = 1;
			await GorevRepo.UpdateAsync(Gorev);
			bildirimServisi.Notify(NotificationSeverity.Success, "Başarılı", "Görev Güncellendi!");
		}
		DialogService.Close(true);
	}
}
	