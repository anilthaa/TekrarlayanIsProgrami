@attribute [Authorize]
<RadzenCard Style="max-width:600px; margin:auto; padding:20px;">
	<RadzenHeading Size="H3" Text="Görev Ekle / Düzenle" Style="text-align:center; margin-bottom:20px;"></RadzenHeading>


	<RadzenTemplateForm Data="@Gorev" TItem="ItemGorev" Submit="@OnSubmit">

		<fieldset class="border rounded p-3 mb-4">
			<legend class="float-none w-auto px-2">Görev Bilgileri</legend>

			<div class="row g-3">
				<div class="col-md-6">
					<RadzenFormField Text="Önem Derecesi" style="width:100%;">
						<RadzenDropDown @bind-Value="Gorev.OnemDerecesi" Data="@onemDereceleri" class="w-100" />
					</RadzenFormField>
				</div>
				<div class="col-md-6">
					<RadzenFormField Text="Tekrarlama Tipi" style="width:100%;">
						<RadzenDropDown @bind-Value="Gorev.TekrarlamaTipi" Data="@tekrarTipleri" class="w-100" />
					</RadzenFormField>
				</div>
			</div>

			@if (Gorev.TekrarlamaTipi == "Günlük")
			{
				<RadzenFormField Text="Kaç günde bir tekrarlansın?" Style="width:49%; margin-top:10px;" >
					<RadzenNumeric @bind-Value="Gorev.TekrarAraligi" TValue="int?" class="w-100" Min="1" Placeholder="Örn: 2 = 2 günde bir" />
				</RadzenFormField>
			}
			@if (Gorev.TekrarlamaTipi == "Haftalık")
			{
				<RadzenFormField Text="Haftanın Günü">
					<RadzenDropDown @bind-Value="Gorev.HaftaninGunu" Data="@haftaninGunleri" class="w-100" />
				</RadzenFormField>
			}
			@if (Gorev.TekrarlamaTipi == "Aylık")
			{
				<RadzenFormField Text="Ayın Günü">
					<RadzenNumeric @bind-Value="Gorev.AyinGunu" TValue="int?" class="w-100" />
				</RadzenFormField>
			}

			<div class="row g-3">
				<div class="col-md-6">
					<RadzenFormField Text="Başlangıç Tarihi" style="width:100%; margin-top:10px;">
						<RadzenDatePicker @bind-Value="Gorev.BaslangicTarihi" DateFormat="dd.MM.yyyy HH:mm" ShowTime="true" class="w-100" />
					</RadzenFormField>
				</div>
				<div class="col-md-6">
					<RadzenFormField Text="Bitiş Tarihi" style="width:100%; margin-top:10px;">
						<RadzenDatePicker @bind-Value="Gorev.BitisTarihi" DateFormat="dd.MM.yyyy HH:mm" ShowTime="true" class="w-100" />
					</RadzenFormField>
				</div>
			</div>

			<RadzenFormField Text="Başlık" style="width:47%; margin-top:10px;">
				<RadzenTextBox Name="TxtBaslik" @bind-Value="Gorev.Baslik" class="w-100" />
			</RadzenFormField>
			<RadzenRequiredValidator Component="TxtBaslik" Text="Başlık Zorunludur." />

			<div class="row g-3">
				<div class="col-md-6">
					<RadzenFormField Text="Kategori" style="width:100%; margin-top:10px;">
						<RadzenDropDown @bind-Value="Gorev.Kategori_ID" Data="@DataKategoriList" TextProperty="Adi" ValueProperty="ID" class="w-100" Placeholder="Kategori seçin" />
					</RadzenFormField>
				</div>
				<div class="col-md-6 d-flex align-items-center mt-4">
					<RadzenCheckBox @bind-Value="Gorev.Kilitli" TValue="bool" />
					<span class="ms-2">Kilitli Görev</span>
				</div>
			</div>

			@if (Gorev.Kilitli)
			{
				<RadzenFormField Text="Görev Sahibi" style="width:100%; margin-top:10px;">
					<RadzenDropDown @bind-Value="Gorev.Kullanici_ID" Data="@kullanicilar" TextProperty="Adi" ValueProperty="ID" class="w-100" Placeholder="Kullanıcı Seçin" />
				</RadzenFormField>
			}
		</fieldset>

		<div class="text-center mt-4">
			@if(!isSaving)
			{
				<RadzenButton Text="Kaydet" ButtonType="ButtonType.Submit" Icon="save" Style="width:30%; margin-left:18px;" class="radzen-button" />
				<RadzenButton Text="İptal" Click="@İptal" ButtonType="ButtonType.Button" Icon="cancel" Style="width:30%; margin-left:35px;" class="radzen-button"></RadzenButton>
			}
			else
			{
				<div style="width:30%; margin-left:18px; display:inline-block; text-align:center;">
					<div class="spinner-border" role="status" style="width:1.6rem; height:1.6rem">
						<span class="visually-hidden">Yükleniyor...</span>
					</div>
				</div>
			}
			
		</div>

	</RadzenTemplateForm>
</RadzenCard>
@code {
	[Inject] private UrlSigningService urlSigningService { get; set; } = null!;

	[Parameter] public ItemGorev Gorev { get; set; } = new();

	private List<string> onemDereceleri = new() { "Düşük", "Orta", "Yüksek" };
	private List<string> tekrarTipleri = new() { "Yok", "Günlük", "Haftalık", "Aylık" };
	private List<string> haftaninGunleri = new() { "Pazartesi", "Salı", "Çarşamba", "Perşembe", "Cuma", "Cumartesi", "Pazar" };
	private List<ItemKategori> DataKategoriList = new();
	private List<User> kullanicilar = new();
	private ItemGorev originalGorev = new(); // Orijinal görev bilgilerini saklamak için
	private bool isSaving = false;

	protected override async Task OnInitializedAsync()
	{
		await YukleData();

		// YukleData'dan sonra orijinal değerleri sakla (varsayılan değerler set edildikten sonra)
		if (Gorev.ID == 0)
		{
			// Yeni görev modunda - varsayılan değerleri sakla
			originalGorev = new ItemGorev
			{
				ID = 0,
				Baslik = Gorev.Baslik ?? string.Empty,
				Kategori_ID = Gorev.Kategori_ID,
				OnemDerecesi = Gorev.OnemDerecesi,
				BaslangicTarihi = Gorev.BaslangicTarihi,
				BitisTarihi = Gorev.BitisTarihi,
				TekrarlamaTipi = Gorev.TekrarlamaTipi,
				TekrarAraligi = Gorev.TekrarAraligi,
				HaftaninGunu = Gorev.HaftaninGunu,
				AyinGunu = Gorev.AyinGunu,
				Kilitli = Gorev.Kilitli,
				Kullanici_ID = Gorev.Kullanici_ID,
				Aktif = Gorev.Aktif
			};
		}
		else
		{
			// Düzenleme modunda orijinal görev bilgilerini sakla
			originalGorev = new ItemGorev
			{
				ID = Gorev.ID,
				Baslik = Gorev.Baslik ?? string.Empty,
				Kategori_ID = Gorev.Kategori_ID,
				OnemDerecesi = Gorev.OnemDerecesi,
				BaslangicTarihi = Gorev.BaslangicTarihi,
				BitisTarihi = Gorev.BitisTarihi,
				TekrarlamaTipi = Gorev.TekrarlamaTipi,
				TekrarAraligi = Gorev.TekrarAraligi,
				HaftaninGunu = Gorev.HaftaninGunu,
				AyinGunu = Gorev.AyinGunu,
				Kilitli = Gorev.Kilitli,
				Kullanici_ID = Gorev.Kullanici_ID,
				Aktif = Gorev.Aktif
			};
		}
	}

	private async Task YukleData()
	{
		DataKategoriList = (await DataService.GetKategori()).ToList();
		kullanicilar = await _kullaniciRepo.GetAllAsync();

		if (Gorev.ID==0)
		{
			// Yeni görev modunda varsayılan değerleri set et
			Gorev.Aktif = true;
			Gorev.Kilitli = false;
			Gorev.BaslangicTarihi = DateTime.Now;
			Gorev.BitisTarihi = DateTime.Now.AddDays(1);
		}
		StateHasChanged();
	}

	private DayOfWeek MapHaftaninGunu(string gun)
	{
		return gun switch
		{
			"Pazartesi" => DayOfWeek.Monday,
			"Salı" => DayOfWeek.Tuesday,
			"Çarşamba" => DayOfWeek.Wednesday,
			"Perşembe" => DayOfWeek.Thursday,
			"Cuma" => DayOfWeek.Friday,
			"Cumartesi" => DayOfWeek.Saturday,
			"Pazar" => DayOfWeek.Sunday,
			_ => DayOfWeek.Monday
		};
	}

	private async Task OnSubmit()
	{
		if (isSaving) return;
		isSaving = true;
		StateHasChanged();
		try
		{
			bool yeniKayıt = Gorev.ID == 0;


			if (Gorev.BitisTarihi < Gorev.BaslangicTarihi)
			{
				notificationService.Notify(NotificationSeverity.Error, "Hata", "Bitiş tarihi başlangıç tarihinden küçük olamaz!");
				return;
			}

			if (Gorev.Kilitli && Gorev.Kullanici_ID == 0)
			{
				notificationService.Notify(NotificationSeverity.Error, "Hata", "Kilitli görev için kullanıcı seçmeniz gerekiyor!");
				return;
			}


			if (Gorev.TekrarlamaTipi == "Günlük" && !Gorev.TekrarAraligi.HasValue)
			{
				notificationService.Notify(NotificationSeverity.Error, "Hata", "Günlük tekrar için aralık girmeniz gerekiyor!");
				return;
			}

			if (Gorev.TekrarlamaTipi == "Haftalık" && string.IsNullOrEmpty(Gorev.HaftaninGunu))
			{
				notificationService.Notify(NotificationSeverity.Error, "Hata", "Haftalık tekrar için gün seçmeniz gerekiyor!");
				return;
			}

			if (Gorev.TekrarlamaTipi == "Aylık" && !Gorev.AyinGunu.HasValue)
			{
				notificationService.Notify(NotificationSeverity.Error, "Hata", "Aylık tekrar için gün girmeniz gerekiyor!");
				return;
			}

			HesaplaSonrakiCalismaTarihi(Gorev);

			if (yeniKayıt)
			{
				Gorev.Aktif = true;
				// Gorev.CreUser = 1;
			}
			else
			{
				// Gorev.UpdUser = 1;
			}

			var sonuc = await DataService.SetGorev(Gorev);
			if (sonuc.SonucKodu == 0)
			{
				if (yeniKayıt && sonuc.Data > 0)
				{
					Gorev.ID = sonuc.Data;

					// Yeni görev eklendiğinde e-posta bildirimi gönder

				}

				await GonderYeniGorevEpostalari();
				notificationService.Notify(NotificationSeverity.Success, "Başarılı", yeniKayıt ? "Görev eklendi!" : "Görev güncellendi!");
				DialogService.Close(Gorev);
				return;
			}
			else
			{
				notificationService.Notify(NotificationSeverity.Error, "Hata", sonuc.SonucAciklama);
			}
		}
		finally
		{
			isSaving = false;
			StateHasChanged();
		}
		
	}

	private void HesaplaSonrakiCalismaTarihi(ItemGorev gorev)
	{
		if (gorev.BaslangicTarihi == null) return;


		var baslangic = gorev.BaslangicTarihi.Value;
		var aralik = gorev.TekrarAraligi ?? 1;

		switch (gorev.TekrarlamaTipi)
		{
			case "Günlük":
				gorev.SonrakiCalismaTarihi = baslangic.AddDays(aralik);
				break;

			case "Haftalık":
				if (!string.IsNullOrEmpty(gorev.HaftaninGunu))
				{
					var hedefGun = MapHaftaninGunu(gorev.HaftaninGunu);
					var tarih = baslangic;
					while (tarih.DayOfWeek != hedefGun)
					{
						tarih = tarih.AddDays(1);
					}
					gorev.SonrakiCalismaTarihi = tarih.AddDays(7 * (aralik - 1));
				}
				else
				{
					gorev.SonrakiCalismaTarihi = baslangic.AddDays(7 * aralik);
				}
				break;

			case "Aylık":
				if (gorev.AyinGunu.HasValue)
				{
					var maxGun = DateTime.DaysInMonth(baslangic.Year, baslangic.Month);
					var ayinGunu = Math.Min(gorev.AyinGunu.Value, maxGun);

					var tarih = new DateTime(baslangic.Year, baslangic.Month, ayinGunu);
					if (tarih <= baslangic)
						tarih = tarih.AddMonths(aralik);

					gorev.SonrakiCalismaTarihi = tarih;
				}
				else
				{
					gorev.SonrakiCalismaTarihi = baslangic.AddMonths(aralik);
				}
				break;

			case "Yok":
			default:
				gorev.SonrakiCalismaTarihi = gorev.BitisTarihi;
				break;
		}
	}
	private async Task İptal()
	{
		bool yeniKayıt = Gorev.ID == 0;
		
		// Hem yeni kayıt hem düzenleme modunda değişiklik kontrolü yap
		// Tarih karşılaştırmalarında sadece tarih kısmını karşılaştır (saat farklarını göz ardı et)
		bool degisiklikVar = 
			!string.Equals(Gorev.Baslik?.Trim() ?? string.Empty, originalGorev.Baslik?.Trim() ?? string.Empty, StringComparison.Ordinal) ||
			Gorev.Kategori_ID != originalGorev.Kategori_ID ||
			!string.Equals(Gorev.OnemDerecesi ?? string.Empty, originalGorev.OnemDerecesi ?? string.Empty, StringComparison.Ordinal) ||
			(Gorev.BaslangicTarihi.HasValue && originalGorev.BaslangicTarihi.HasValue && 
			 Math.Abs((Gorev.BaslangicTarihi.Value - originalGorev.BaslangicTarihi.Value).TotalSeconds) > 1) ||
			(Gorev.BitisTarihi.HasValue && originalGorev.BitisTarihi.HasValue && 
			 Math.Abs((Gorev.BitisTarihi.Value - originalGorev.BitisTarihi.Value).TotalSeconds) > 1) ||
			(Gorev.BaslangicTarihi.HasValue != originalGorev.BaslangicTarihi.HasValue) ||
			(Gorev.BitisTarihi.HasValue != originalGorev.BitisTarihi.HasValue) ||
			!string.Equals(Gorev.TekrarlamaTipi ?? string.Empty, originalGorev.TekrarlamaTipi ?? string.Empty, StringComparison.Ordinal) ||
			Gorev.TekrarAraligi != originalGorev.TekrarAraligi ||
			!string.Equals(Gorev.HaftaninGunu ?? string.Empty, originalGorev.HaftaninGunu ?? string.Empty, StringComparison.Ordinal) ||
			Gorev.AyinGunu != originalGorev.AyinGunu ||
			Gorev.Kilitli != originalGorev.Kilitli ||
			Gorev.Kullanici_ID != originalGorev.Kullanici_ID ||
			Gorev.Aktif != originalGorev.Aktif;
		
		if (degisiklikVar)
		{
			// Değişiklik varsa onay iste
			bool? onay = await DialogService.Confirm(
				"Yaptığınız değişiklikler kaybolacaktır. İptal etmek istediğinize emin misiniz?",
				"Değişiklikleri Kaydetmeden Çık",
				new ConfirmOptions 
				{ 
					OkButtonText = "Evet, İptal Et", 
					CancelButtonText = "Hayır, Geri Dön",
					Icon = "warning"
				});
			
			if (onay != true)
			{
				return; // Kullanıcı iptal etmekten vazgeçti
			}
			
			// Onay verildiyse, değişiklikleri geri al (originalGorev ile geri yükle)
			Gorev.Baslik = originalGorev.Baslik ?? string.Empty;
			Gorev.Kategori_ID = originalGorev.Kategori_ID;
			Gorev.OnemDerecesi = originalGorev.OnemDerecesi;
			Gorev.BaslangicTarihi = originalGorev.BaslangicTarihi;
			Gorev.BitisTarihi = originalGorev.BitisTarihi;
			Gorev.TekrarlamaTipi = originalGorev.TekrarlamaTipi;
			Gorev.TekrarAraligi = originalGorev.TekrarAraligi;
			Gorev.HaftaninGunu = originalGorev.HaftaninGunu;
			Gorev.AyinGunu = originalGorev.AyinGunu;
			Gorev.Kilitli = originalGorev.Kilitli;
			Gorev.Kullanici_ID = originalGorev.Kullanici_ID;
			Gorev.Aktif = originalGorev.Aktif;
			
			// İptal mesajı göster
			string mesaj = yeniKayıt ? "Görev ekleme işleminiz iptal edildi." : "Görev düzenleme işleminiz iptal edildi.";
			notificationService.Notify(NotificationSeverity.Info, "Bilgi", mesaj);
		}
		else
		{
			// Değişiklik yoksa direkt iptal mesajı göster
			string mesaj = yeniKayıt ? "Görev ekleme işleminiz iptal edildi." : "Görev düzenleme işleminiz iptal edildi.";
			notificationService.Notify(NotificationSeverity.Info, "Bilgi", mesaj);
		}
		
		// Dialog'u kapat (null döndürerek iptal edildiğini belirt)
		DialogService.Close();
	}

	private async Task GonderYeniGorevEpostalari()
	{
		try
		{
			if (Gorev.Kilitli && Gorev.Kullanici_ID > 0)
			{
				// Kilitli görev - sadece atanan kullanıcıya gönder
				var kullanici = await _kullaniciRepo.GetByIDAsync(Gorev.Kullanici_ID);
				if (kullanici != null && !string.IsNullOrEmpty(kullanici.EPosta))
				{
					// Dashboard URL'ini oluştur ve imzala (görev ID ve kullanıcı ID ile)
					var urlParams = new Dictionary<string, string>
					{
						{ "gorevId", Gorev.ID.ToString() },
						{ "userId", Gorev.Kullanici_ID.ToString() }
					};
					var dashboardUrl = urlSigningService.SignUrl("https://localhost:7014/dashboard", urlParams);
					
					await EpostaService.SendYeniGorevBildirimiAsync(
						kullanici.EPosta,
						kullanici.Adi,
						Gorev.Baslik ?? "Yeni Görev",
						dashboardUrl
					);
					Console.WriteLine($"E-posta gönderildi: {kullanici.EPosta}");
				}
			}
			else
			{
				// Herkese açık görev - tüm aktif kullanıcılara gönder
				var tumKullanicilar = await _kullaniciRepo.GetAllAsync();
				var aktifKullanicilar = tumKullanicilar.Where(k => k.Aktif && !string.IsNullOrEmpty(k.EPosta)).ToList();

				foreach (var kullanici in aktifKullanicilar)
				{
					try
					{
						// Dashboard URL'ini oluştur ve imzala (görev ID ve kullanıcı ID ile)
						var urlParams = new Dictionary<string, string>
						{
							{ "gorevId", Gorev.ID.ToString() },
							{ "userId", kullanici.ID.ToString() }
						};
						var dashboardUrl = urlSigningService.SignUrl("https://localhost:7014/dashboard", urlParams);
						
						await EpostaService.SendYeniGorevBildirimiAsync(
							kullanici.EPosta,
							kullanici.Adi,
							Gorev.Baslik ?? "Yeni Görev",
							dashboardUrl
						);
						Console.WriteLine($"E-posta gönderildi: {kullanici.EPosta}");
					}
					catch (Exception ex)
					{
						Console.WriteLine($"E-posta gönderme hatası ({kullanici.EPosta}): {ex.Message}");
						// Bir kullanıcıya gönderilemese bile diğerlerine göndermeye devam et
					}
				}
			}
		}
		catch (Exception ex)
		{
			Console.WriteLine($"E-posta bildirimi hatası: {ex.Message}");
			// E-posta gönderimi kritik değil, hata olsa bile devam et
		}
	}
}
	