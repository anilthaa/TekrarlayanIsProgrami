
<div style="padding:20px; width:100%;">
	
	<p style="margin-bottom:15px; color:#666;">Bu tarihte <strong>@Gorevler.Count</strong> görev bulunuyor:</p>
	<div style="overflow:visible; max-height:none;">
		<RadzenDataGrid Data="@Gorevler" TItem="ItemGorev" AllowPaging="false" class="gorev-list-dialog">
		<Columns>
			<RadzenDataGridColumn TItem="ItemGorev" Property="Baslik" Title="Görev Başlığı" Width="500px"></RadzenDataGridColumn>
			<RadzenDataGridColumn TItem="ItemGorev" Property="BitisTarihi" Title="Bitiş Tarihi" FormatString="{0:dd.MM.yyyy HH:mm}" Width="200px"></RadzenDataGridColumn>
			<RadzenDataGridColumn TItem="ItemGorev" Title="Önem" Width="150px">
				<Template Context="onem">
						<span style="display:inline-block; width:60px; text-align:center; font-size:10px; padding:3px 8px; border-radius:4px; color:white; background-color:@GetOnemRengi(onem.OnemDerecesi)">
							@(string.IsNullOrWhiteSpace(onem.OnemDerecesi) ? "Yok" : onem.OnemDerecesi)
						</span>
					</Template>
			</RadzenDataGridColumn>
			<RadzenDataGridColumn TItem="ItemGorev" Property="Tamamlandi" Title="Durum" Width="150px">
				<Template Context="g">
						<span style="@($"font-size:11px; padding:3px 8px; border-radius:10px;  background-color:{(g.Tamamlandi ? "#4caf50" : "#e74c3c")};color:white; display:inline-block; width:100px; text-align:center;")">
						@(g.Tamamlandi ? "Tamamlandı" : "Devam Ediyor")
					</span>
				</Template>
			</RadzenDataGridColumn>
		</Columns>
		</RadzenDataGrid>
	</div>
	<div style="margin-top:20px; text-align:right;">
		<RadzenButton Text="Kapat" ButtonStyle="ButtonStyle.Secondary" Click="@(() => DialogService.Close())" />
	</div>
</div>

@code {
	[Parameter] public string DateStr { get; set; } = string.Empty;
	[Parameter] public List<ItemGorev> Gorevler { get; set; } = new();

	private string GetOnemRengi(string onem)
	{
		return onem?.ToLower() switch
		{
			"yüksek" => "#e74c3c",
			"orta" => "#f1c40f",
			"düşük" => "#2ecc71"

		};
	}
}

