	//istemdeki görevleri veritabanından çekip belleğe yüklemek için kullanılır.
	private async Task YukleGorevler()
	{
		try
		{
			var tumGorevler = (await DataService.GetGorevler()).OrderBy(x=>x.ID).ToList();

			if (currentUserId.HasValue)
			{
				adminGorevleri = tumGorevler
					.Where(g => g.Kullanici_ID == currentUserId && g.Kilitli && !g.Tamamlandi && g.Aktif).ToList();
			}
