@layout MainLayout

<RadzenCard class="max-width:600px; margin:auto; padding:20px;">

	<h3 class="card-title text-center mb-4">Kullanıcı Ekle</h3>
	<RadzenTemplateForm Data="@newUser" TItem="User" Submit="@OnSubmit">
		<RadzenFieldset Text="Bilgiler" Style="margin-bottom:15px;">
			<DataAnnotationsValidator />
			<RadzenFormField Text="Ad" Style="width:85%; margin-left:41px; margin-top:4px;">
			<RadzenTextBox class="form-control" @bind-Value="newUser.Adi" />
			</RadzenFormField>
			<ValidationMessage For="@(() => newUser.Adi)"></ValidationMessage>

			<RadzenFormField Text="Soyad" Style="width:85%; margin-left:41px; margin-top:4px;">
			<RadzenTextBox class="form-control" @bind-Value="newUser.Soyadi"/>
			</RadzenFormField>
			<ValidationMessage For="@(()=> newUser.Soyadi)"></ValidationMessage>

			<RadzenFormField Text="E-posta" Style="width:85%; margin-left:41px; margin-top:4px;">
			<RadzenTextBox class="form-control" @bind-Value="newUser.EPosta" />
			</RadzenFormField>
			<ValidationMessage For="@(() => newUser.EPosta)"></ValidationMessage>

			<RadzenFormField Text="Tip Seçin" Style="width:85%; margin-left:41px; margin-top:4px;">
				<RadzenDropDown @bind-Value="secilenTipId"
				                TValue="int"
								Data="@kullaniciTipleri" 
                                TextProperty="Adi" 
                                ValueProperty="ID" 
                                Style="width:100%;"  />
				<ValidationMessage For="@(() => secilenTipId)" />
			</RadzenFormField>

			<RadzenFormField Text="Şifre" Style="width:85%; margin-left:41px; margin-top:4px;">
			<RadzenTextBox class="form-control" @bind-Value="newUser.Sifre" type="@InputType" />
			<button type="button" @onclick="TogglePassword"
				style="position:absolute; right:18px; top:50%; transform:translateY(-50%); border:none; background:transparent;">
				<RadzenIcon Icon="@Icon" Style="color:gray;"></RadzenIcon>
			</button>
			</RadzenFormField>
			<ValidationMessage For="@(() => newUser.Sifre)"></ValidationMessage>

			<RadzenFormField Text="Şifre Tekrar" Style="width:85%; margin-left:41px; margin-top:4px;">
				<RadzenTextBox @bind-Value="newUser.SifreTekrar" type="@InputType2" />
				<button type="button" @onclick="@TogglePasswordAgain"
					style="position:absolute; right:1px; top:8px; transform:translate(-50%); border:none; background:transparent;">
					<RadzenIcon Icon="@Icon2" Style="color:gray;"></RadzenIcon>
				</button>
			</RadzenFormField>
			<ValidationMessage For="@(() => newUser.SifreTekrar)"></ValidationMessage>
            <RadzenCard class="btn-group">
                <RadzenButton Text="Kaydet" Icon="save" ButtonType="ButtonType.Submit" Style="width:30%; margin:auto;" class="radzen-button"></RadzenButton>
				<RadzenButton Text="İptal"  Icon="cancel" Click="@Iptal" Style="width:30%; margin:auto;" class="radzen-button"></RadzenButton>
			</RadzenCard>
		</RadzenFieldset>
	</RadzenTemplateForm>

</RadzenCard>

@code {
	private int secilenTipId=0; 
	private List<ItemKullaniciTip> kullaniciTipleri = new();
	private User newUser = new User
	{
		CreDate = DateTime.Now,
		Aktif = true
	};

	protected override async Task OnInitializedAsync()
	{
		kullaniciTipleri = (await DataService.GetKullaniciTipleri()).ToList();
	}

	private async Task OnSubmit()
	{
		Console.WriteLine($"Seçilen Tip ID: {secilenTipId}");
		if (!EpostaGecerliMi(newUser.EPosta))
		{
			notificationService.Notify(NotificationSeverity.Error, "Hata", "E-posta Yalnızca gmail.com veya hotmail.com Olmalıdır.");
			return;
		}

		if (newUser.Sifre != newUser.SifreTekrar)
		{
			notificationService.Notify(NotificationSeverity.Error, "Hata", "Şifre ile Tekrar Şifre Aynı Olmak Zorunda.");
			return;
		}

		var currentUser = await girisSaglayici.GetCurrentUserAsync();

		newUser.CreUser = currentUser.ID;     
		newUser.KullaniciTip_ID = secilenTipId;


		var result = await girisSaglayici.KayitOlAsync(newUser,newUser.KullaniciTip_ID);

		if (result.Basarili)
		{
			notificationService.Notify(NotificationSeverity.Success, "Başarılı", "Kayıt Başarıyla Tamamlandı.");
			NavigationManager.NavigateTo("/kullanicilar");
			StateHasChanged();
			Console.WriteLine($"Seçilen Tip ID: {secilenTipId}");
		}
		else
		{
			notificationService.Notify(NotificationSeverity.Error, "Hata", "Kayıt Sırasında Bir Hata Oluştu.");
		}

		DialogService.Close(true);
		Console.WriteLine($"Seçilen Tip ID: {secilenTipId}");
	}
	private bool EpostaGecerliMi(string eposta)
	{
		if (string.IsNullOrWhiteSpace(eposta))
			return false;

		var desen = @"^[\w\.-]+@(gmail\.com|hotmail\.com)$";
		return Regex.IsMatch(eposta, desen, RegexOptions.IgnoreCase);
	}


	private void Iptal()
	{
		NavigationManager.NavigateTo(geriUrl);
		notificationService.Notify(NotificationSeverity.Warning, "Uyarı!", "Kayıt İşleminiz İptal Edildi.");
	}
	private string geriUrl = "/kullanicilar";

	private string InputType { get; set; } = "password";
	private string Icon { get; set; } = "visibility_off"; // göz kapalı

	void TogglePassword()
	{
		if (InputType == "password")
		{
			InputType = "text";
			Icon = "visibility"; // göz açık
		}
		else
		{
			InputType = "password";
			Icon = "visibility_off";
		}
	}
	private string InputType2 { get; set; } = "password";
	private string Icon2 { get; set; } = "visibility_off"; // göz kapalı

	void TogglePasswordAgain()
	{
		if (InputType2 == "password")
		{
			InputType2 = "text";
			Icon2 = "visibility"; // göz açık
		}
		else
		{
			InputType2 = "password";
			Icon2 = "visibility_off";
		}
	}
}
