@page "/dashboard"
@layout MainLayout
@attribute [Authorize] 
@if (loading)
{
    <p>Yükleniyor...</p>
}
else if (currentUser == null)
{
    <p>Kullanıcı bulunamadı. Giriş sayfasına yönlendiriliyorsunuz...</p>
    @* Yönlendirme *@
    NavigationManager.NavigateTo("/GirisYap");
}
else{
    <h2>Hoş geldin, @currentUser?.Adi!</h2>

    <RadzenCard>
        <h4>📊 Kontrol Paneli</h4>
        <p>Burada istatistikler, bildirimler veya kullanıcı bilgileri yer alacak.</p>
    </RadzenCard>
}



   @*

    <footer>
        &copy; 2025 Tekrarlayan İş Programı
    </footer> *@
@code {
    private User? currentUser;
    private bool loading = true;
    protected override async Task OnInitializedAsync()
    {
        await LoadUserFromLocalStorageAsync();
    }
    private async Task LoadUserFromLocalStorageAsync()
    {
        var userJson = await Js.InvokeAsync<string>("localStorage.getItem", "currentUser");
        if (!string.IsNullOrEmpty(userJson))
        {
            currentUser = JsonSerializer.Deserialize<User>(userJson);
        }
    }

  
}