@layout MainLayout
@attribute [Authorize]
<RadzenCard Style="padding:20px;">
	<RadzenTemplateForm TItem="ItemKategori" Data="@ItemData" Submit="@OnSubmit">
		<ChildContent>
			<RadzenLabel Text="Kategori Adı" Component="Adi"></RadzenLabel>
			<RadzenTextBox @bind-Value="ItemData.Adi" Name="Adi" Style="width:100%; margin-bottom:15px;" Change="() => degisiklikYapildiMi = true"></RadzenTextBox>

			@if (!string.IsNullOrEmpty(ErrorMessage))
			{
				<div style="color: red; margin-bottom:10px;">@ErrorMessage</div>
			}
				<RadzenButton Text="Kaydet" Icon="save" Style="width:30%; margin-left:48px;" class="radzen-button" ButtonType="ButtonType.Submit"></RadzenButton>
				<RadzenButton Text="İptal" Icon="cancel" Click="@Iptal" Style="width:30%; margin-left:58px; margin-top:20px;" class="radzen-button" ButtonType="ButtonType.Button"></RadzenButton>
		</ChildContent>
	</RadzenTemplateForm>
</RadzenCard>

@code {
	[Parameter] public ItemKategori ItemData { get; set; } = new();

	private string ErrorMessage = string.Empty;
	private bool IsEdit;
	private bool isProcessing = false;
	private bool degisiklikYapildiMi = false;

	protected override void OnInitialized()
	{
		// IsEdit durumu form ilk açıldığında sabitleniyor (sonradan değişmez)
		IsEdit = ItemData.ID != 0;
	}

	private async Task OnSubmit(ItemKategori item)
	{
		if (isProcessing)
			return; // ikinci tıklamayı engelle

		isProcessing = true;
		ErrorMessage = string.Empty;

		try
		{
			if (string.IsNullOrWhiteSpace(item.Adi))
			{
				ErrorMessage = "Kategori adı boş olamaz!";
				return;
			}

			// Kullanıcı bilgileri (örnek olarak statik)
			item.DelUser = 0;
			item.CreUser = IsEdit ? 0 : 1;
			item.UpdUser = IsEdit ? 1 : 0;

			// Veritabanı işlemi
			var wsCvp = await Task.Run(() => DataService.SetKategori(item));
			Console.WriteLine($"SonucKodu: {wsCvp.SonucKodu}, Data: {wsCvp.Data}");

			if (wsCvp.SonucKodu == 0 && wsCvp.Data > 0)
			{
				if (!IsEdit)
					item.ID = wsCvp.Data; // yeni eklenen kaydın ID'si

				notificationService.Notify(
					NotificationSeverity.Success,
					"Başarılı",
					IsEdit ? "Kategori güncellendi!" : "Kategori eklendi!"
				);

				await Task.Delay(100);
				DialogService.Close(item);
			}
			else
			{
				await DialogService.Alert(
					$"Hata Oluştu. SonucKodu: {wsCvp.SonucKodu}, Data: {wsCvp.Data}"
				);
			}
		}
		catch (Exception ex)
		{
			ErrorMessage = $"Hata Oluştu: {ex.Message}";
			notificationService.Notify(NotificationSeverity.Error, "Hata", ErrorMessage);
		}
		finally
		{
			isProcessing = false; // her durumda form yeniden aktif olur
		}
	}

	private async Task Iptal()
	{
		if (degisiklikYapildiMi)
		{
			bool? onay = await DialogService.Confirm("Yaptığınız değişiklikler kaybolacak. Devam etmek istiyor musunuz?",
			"İptal Etme Onayı",
			new ConfirmOptions
			{
				OkButtonText = "Evet",
				CancelButtonText = "Hayır"
			});

			if (onay != true)
				return;
			notificationService.Notify(NotificationSeverity.Info, "Bilgi", "Silme İşleminiz İptal Edildi.");

		}

		DialogService.Close(null);
	}
}
