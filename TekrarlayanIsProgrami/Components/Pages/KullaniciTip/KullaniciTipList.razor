@page "/Admin/KullaniciTipleri"
@layout MainLayout
@attribute [Authorize]
<RadzenCard Style="margin:20px;">
	<h3 style="text-align:center; font-family:Calibri;font-weight: bold; ">Kullanıcı Tipleri</h3>

	@if (_canWrite)
	{
		<RadzenButton Text="Yeni Tip" Icon="add"
					  Style="margin-bottom:15px; background:#ba76d3; color:white;border-radius:10px;"
					  Click="@YeniTip" />
	}

	@if (isLoading)
	{
		<p>Veriler yükleniyor...</p>
	}
	else if (DataList == null || !DataList.Any())
	{
		<p>Henüz kullanıcı tipi tanımlanmamış.</p>
	}
	else
	{
		<RadzenDataGrid TItem="ItemKullaniciTip" Data="@DataList" @ref="grid"
						AllowPaging="true" PageSize="10"
						AllowSorting="true" AllowFiltering="true"
						RowDoubleClick="@(_canWrite ? OnRowDoubleClick : null)">
			<Columns>
				<RadzenDataGridColumn TItem="ItemKullaniciTip" Property="ID" Title="ID" Width="0px" />
				<RadzenDataGridColumn Title="No" Width="100px">
					<Template Context="g">
						@(DataList.ToList().IndexOf(g) + 1)
					</Template>
				</RadzenDataGridColumn>
				<RadzenDataGridColumn TItem="ItemKullaniciTip" Property="Adi" Title="Adı" Width="100px" />
				<RadzenDataGridColumn TItem="ItemKullaniciTip" Property="Aktif" Title="Aktif" Width="100px">
					<Template Context="item">
						<RadzenCheckBox Value="item.Aktif" TValue="bool" Disabled="true" Style="margin-right:5px;" />
						@(item.Aktif ? "Aktif" : "Pasif")
					</Template>
				</RadzenDataGridColumn>
				@if (_canWrite)
				{
					<RadzenDataGridColumn TItem="ItemKullaniciTip" Title="İşlemler" Width="150px">
						<Template Context="item">
							<RadzenButton Icon="edit" Size="ButtonSize.Small" Style="margin-right:6px"
										  ButtonStyle="ButtonStyle.Success" Click="@(() => Duzenle(item))" />
							<RadzenButton Icon="delete" Size="ButtonSize.Small" ButtonStyle="ButtonStyle.Danger"
										  Click="@(() => Sil(item))" />
						</Template>
					</RadzenDataGridColumn>
				}
			</Columns>
		</RadzenDataGrid>
	}
</RadzenCard>

@code {
	    private List<ItemKullaniciTip> DataList = new();
	    private RadzenDataGrid<ItemKullaniciTip>? grid;
	    private bool isLoading = true;
	    private int? currentUserId;
	    private bool _canWrite = false;

		//sayfa yüklendiğinde başlangıç işlemlerini yapar.
        protected override async Task OnInitializedAsync()
	    {
		   _canWrite = await PermissionService.CanWriteAsync("admin/kullanicitipleri");
		   await YukleKullaniciAsync();
		   await YukleDataAsync();
	    }

		// mevcut kullanıcı bilgilerini yükler.
		private async Task YukleKullaniciAsync()
		{
			try
			{
				var user = await girisSaglayici.GetCurrentUserAsync();
				currentUserId = user?.ID;
			}
			catch (Exception ex)
			{
				notificationService.Notify(NotificationSeverity.Warning, "Uyarı", $"Kullanıcı bilgisi alınamadı: {ex.Message}");
				currentUserId = null;
			}
		}

		//kullanıcı tipleri verilerini yükler.
		private async Task YukleDataAsync()
		{
			try
			{
				isLoading = true;
				StateHasChanged();
				DataList = (await DataService.GetKullaniciTipleri()).ToList();
			}
			catch (Exception ex)
			{
				notificationService.Notify(NotificationSeverity.Error, "Hata", $"Kullanıcı tipleri yüklenemedi: {ex.Message}");
				DataList = new();
			}
			finally
			{
				isLoading = false;
				StateHasChanged();
			}
		}

		//Yeni tip eklemek için kullanılır.
		private async Task YeniTip()
		{
			var yeniItem = new ItemKullaniciTip
			{
				ID = 0,
				Adi = string.Empty,
				Aktif = true,
				CreUser = currentUserId ?? 1,
				UpdUser = 0,
				DelUser = 0
			};

			var result = await DialogService.OpenAsync<KullaniciTipTnm>(" ",
			new Dictionary<string, object> { { "ItemData", yeniItem }, { "CurrentUserId", currentUserId ?? 1 } },
			new DialogOptions { Width = "480px", Height = "auto" });

			if (result is ItemKullaniciTip eklenen && eklenen.ID > 0)
			{
				DataList.Insert(0, eklenen);
				if (grid != null)
				{
					await grid.Reload();
				}
				notificationService.Notify(NotificationSeverity.Success, "Başarılı", "Kullanıcı tipi oluşturuldu.");
				StateHasChanged();
			}
		}

		//Mevcut olan tipinin düzenleme işllemini yapmak için kullanılır.
		private async Task Duzenle(ItemKullaniciTip item)
		{
			var payload = new ItemKullaniciTip
			{
				ID = item.ID,
				Adi = item.Adi,
				Aktif = item.Aktif,
				CreUser = item.CreUser,
				CreDate = item.CreDate,
				UpdUser = currentUserId ?? 1,
				UpdDate = item.UpdDate,
				DelUser = item.DelUser,
				DelDate = item.DelDate
			};

			var result = await DialogService.OpenAsync<KullaniciTipTnm>(" ",
			new Dictionary<string, object> { { "ItemData", payload }, { "CurrentUserId", currentUserId ?? 1 } },
			new DialogOptions { Width = "480px", Height = "auto" });

			if (result is ItemKullaniciTip guncellenen && guncellenen.ID > 0)
			{
				var index = DataList.FindIndex(x => x.ID == guncellenen.ID);
				if (index >= 0)
				{
					DataList[index] = guncellenen;
				}
				if (grid != null)
				{
					await grid.Reload();
				}
				notificationService.Notify(NotificationSeverity.Success, "Başarılı", "Kullanıcı tipi güncellendi.");
				StateHasChanged();
			}
		}

		//Tip silme işlemi için kullanılır.
		private async Task Sil(ItemKullaniciTip item)
		{
		var tumKullanicilar = await _kullaniciRepo.GetAllAsync();

		var tipeAitAktifKullanicilar = tumKullanicilar
			.Where(u => u.KullaniciTip_ID == item.ID
						&& u.Aktif
						&& (u.DelUser == null || u.DelUser == 0))
			.ToList();

		if (tipeAitAktifKullanicilar.Any())
		{
			var kullaniciSayisi = tipeAitAktifKullanicilar.Count;

			var mesaj = kullaniciSayisi == 1
				? "Bu kullanıcı tipine ait 1 aktif kullanıcı bulunmaktadır. Lütfen önce bu kullanıcıyı pasif hale getirin."
				: $"Bu kullanıcı tipine ait {kullaniciSayisi} aktif kullanıcı bulunmaktadır. Lütfen önce bu kullanıcıları pasif hale getirin.";

			notificationService.Notify(
				NotificationSeverity.Warning,
				"Uyarı",
				mesaj
			);

			return;
		}
			bool? onay = await DialogService.Confirm($"'{item.Adi}' tipini silmek istediğinize emin misiniz?", "Onay",
			new ConfirmOptions { OkButtonText = "Evet", CancelButtonText = "Hayır", Icon = "warning" });

			if (onay == true)
			{
				var silinecek = new ItemKullaniciTip
				{
					ID = item.ID,
					Adi = item.Adi,
					Aktif = item.Aktif,
					CreUser = item.CreUser,
					CreDate = item.CreDate,
					UpdUser = item.UpdUser,
					UpdDate = item.UpdDate,
					DelUser = currentUserId ?? 1,
					DelDate = item.DelDate
				};

				var response = await DataService.SetKullaniciTip(silinecek);
				if (response.Data > 0)
				{
					DataList.Remove(item);
					if (grid != null)
					{
						await grid.Reload();
					}
					notificationService.Notify(NotificationSeverity.Success, "Başarılı", "Kullanıcı tipi silindi.");
				}
				else
				{
					notificationService.Notify(NotificationSeverity.Error, "Hata", "Silme işlemi tamamlanamadı.");
				}
			}
		}

		//Satıra iki kere tıklayınca düzenleme işlemini açar.
		private async Task OnRowDoubleClick(DataGridRowMouseEventArgs<ItemKullaniciTip> args)
	{
		await Duzenle(args.Data);
	}
}
