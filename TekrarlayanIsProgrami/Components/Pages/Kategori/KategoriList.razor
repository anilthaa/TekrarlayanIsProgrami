@page "/Kategori"
@layout MainLayout
@attribute [Authorize]
<RadzenCard Style="margin:20px;">
	<h3 style="text-align:center; font-family:Calibri;font-weight: bold;">
		Kategori Listesi
	</h3>

	@if (_yetki != YetkiTipi.Gizli)
	{
		<RadzenButton Text="Yeni Kategori"
					  Icon="add_circle"
					  Style="margin-bottom:15px; background:#ba76d3; color:white;border-radius:10px;"
					  Disabled="@(_yetki == YetkiTipi.Okuma)"
					  Click="@Ekle" />
	}

	@if (DataList == null || !DataList.Any())
	{
		<p>Veri yükleniyor... veya veri bulunamadı.</p>
	}
	else
	{
		<RadzenDataGrid TItem="ItemKategori"
						Data="@DataList"
						@ref="GrdData"
						RowDoubleClick="@OnRowDoubleClick"
						AllowPaging="true"
						PageSize="20"
						AllowSorting="true"
						AllowFiltering="true">

			<Columns>

				<RadzenDataGridColumn TItem="ItemKategori"
									  Property="ID"
									  Title="ID"
									  Width="0px" />

				<RadzenDataGridColumn Title="No" Width="100px">
					<Template Context="g">
						@(DataList.ToList().IndexOf(g) + 1)
					</Template>
				</RadzenDataGridColumn>

				<RadzenDataGridColumn TItem="ItemKategori"
									  Property="Adi"
									  Title="Kategori Adı" />

				@if (_yetki != YetkiTipi.Gizli)
				{
					<RadzenDataGridColumn TItem="ItemKategori"
										  Title="İşlemler"
										  Width="150px">
						<Template Context="data">

							<RadzenButton Icon="edit"
										  Size="ButtonSize.Small"
										  Style="margin-right:5px"
										  Disabled="@(_yetki == YetkiTipi.Okuma)"
										  Click="@(() => Duzenle(data))"
										  ButtonStyle="ButtonStyle.Success" />

							<RadzenButton Icon="delete"
										  Size="ButtonSize.Small"
										  Disabled="@(_yetki == YetkiTipi.Okuma)"
										  ButtonStyle="ButtonStyle.Danger"
										  Click="@(() => Sil(data))" />

						</Template>
					</RadzenDataGridColumn>
				}

			</Columns>
		</RadzenDataGrid>
	}
</RadzenCard>

@code {
	private List<ItemKategori> DataList = new();
	private RadzenDataGrid<ItemKategori>? GrdData;
	private YetkiTipi _yetki;
	//Sayfa açıldığında kullanıcının kategori ekleme/düzenleme yetkisini kontrol eder ve gerekli verileri yükler.
	protected override async Task OnInitializedAsync()
	{
	 _yetki = await PermissionService.GetCurrentUserYetkiAsync(7);
        if (_yetki == YetkiTipi.Gizli)
        {
            NavigationManager.NavigateTo("/yetkisiz");
            notificationService.Notify(NotificationSeverity.Warning,"Uyarı","Bu Sayfaya ERişme Yetkiniz Yok");
            return;
        }
		await YukleDataAsync();
	}

	//kategori verilerini sunucudan alıp sayfaya yükler.
	private async Task YukleDataAsync()
	{
		try
		{
			DataList = (await DataService.GetKategori()).ToList();
			Console.WriteLine($"Veri yüklendi: {DataList.Count} kategori.");

			StateHasChanged();
		}
		catch (Exception ex)
		{
			Console.WriteLine($"Veri yükleme hatası: {ex.Message}");
			notificationService.Notify(NotificationSeverity.Error, "Hata", $"Veri yüklenemedi: {ex.Message}");
			DataList = new();
		}
	}

	//yeni bir kategori ekleme işlemini gerçekleştirir:
	private async Task Ekle()
	{
		try
		{
			if (DialogService==null)
			{
				throw new InvalidOperationException("DialogService inject edilemedi");
			}
			var newItem = new ItemKategori 
			{ 
				ID=0,
				CreUser = 1 ,
				UpdUser=0,
				DelUser=0
			};

			var dialogResult = await DialogService.OpenAsync<KategoriTnm>(" ",
				new Dictionary<string, object> { { "ItemData", newItem } }, new DialogOptions { Width = "500px", Height = "auto" });
			if (dialogResult is ItemKategori result && result != null)
			{
				DataList.Insert(0, result);
				if (GrdData!=null)
				{
					await GrdData.Reload();
				}

				StateHasChanged();
				notificationService.Notify(NotificationSeverity.Success, "Başarılı", "Kategori eklendi!");
			}

		}
		catch (Exception ex)
		{
			Console.WriteLine($"Ekleme hatası: {ex.Message}");
			notificationService.Notify(NotificationSeverity.Error, "Hata", $"Ekleme sırasında hata: {ex.Message}");
		}
	}

	//mevcut bir kategoriyi düzenlemeyi sağlar:
	private async Task Duzenle(ItemKategori item)
	{
		item.UpdUser = 1;
		ItemKategori result = await DialogService.OpenAsync<KategoriTnm>(" ",
			new Dictionary<string, object> { { "ItemData", item } },
			new DialogOptions { Width = "500px", Height = "auto" });
		if (result != null)
		{
			var index = DataList.FindIndex(x => x.ID == result.ID);
			if (index >= 0)
			{
				DataList[index] = result;
			}
			await GrdData.Reload();
			StateHasChanged();

		}
	}

	//bir kategoriyi silme işlemini yönetir:
	private async Task Sil(ItemKategori item)
	{
		var tumGorevler = await DataService.GetGorevler();
		var kategoriyeAitAktifGorevler = tumGorevler
			.Where(g => g.Kategori_ID == item.ID && g.Aktif && (g.DelUser == null || g.DelUser == 0))
			.ToList();

		if (kategoriyeAitAktifGorevler.Any())
		{
			var gorevSayisi = kategoriyeAitAktifGorevler.Count;
			var mesaj = gorevSayisi == 1 
				? "Bu kategoriye ait 1 aktif görev bulunmaktadır. Lütfen önce bu kategoriye ait görevi silin veya pasif hale getirin."
				: $"Bu kategoriye ait {gorevSayisi} aktif görev bulunmaktadır. Lütfen önce bu kategoriye ait görevleri silin veya pasif hale getirin.";
			
			notificationService.Notify(NotificationSeverity.Warning, "Uyarı", mesaj);
			return;
		}

		bool? onay = await DialogService.Confirm("Silmek istediğinize emin misiniz?",
			"Onay", new ConfirmOptions { OkButtonText = "Evet", CancelButtonText = "Hayır" });

		if (onay == true)
		{
			item.DelUser = 1;
			var wsCvp = await DataService.SetKategori(item);
			if (wsCvp.Data > 0)
			{
				DataList.Remove(item);
				await GrdData.Reload();
				StateHasChanged();
				notificationService.Notify(NotificationSeverity.Success, "Başarılı", "Kategori Başarıyla Silindi!");
			}
			else
			{
				notificationService.Notify(NotificationSeverity.Error, "Hata", "Silme İşleminiz Başarısız.");
			}
		}
		else
		{
			notificationService.Notify(NotificationSeverity.Info, "Bilgi", "Silme İşleminiz İptal Edildi.");
		}
	}

	//tablo satırına çift tıklama olayını yönetir:
	private async Task OnRowDoubleClick(DataGridRowMouseEventArgs<ItemKategori> args)
	{
		await Duzenle(args.Data);
	}
}
