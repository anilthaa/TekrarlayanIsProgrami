@page "/sifre-sifirla"
@layout EmptyLayout
@attribute [AllowAnonymous]
@code {
    [Parameter] public string token { get; set; } // token URL’den gelir
}

<RadzenCard Class="mx-auto mt-5" Style="max-width:400px;">
    <h3 style="text-align:center;">Yeni Şifre Belirle</h3>
   <EditForm Model="@model" OnValidSubmit="@OnSubmit">
        <RadzenFormField Text="Yeni Şifre" Style="width:100%">
        <RadzenTextBox @bind-Value="model.YeniSifre" Name="YeniSifre" Type="Password" Style="width:100%;" />
        </RadzenFormField>
        <RadzenFormField Text="Yeni Şifre Tekrar" Style="width:100%">
        <RadzenTextBox @bind-Value="model.YeniSifreTekrar" Name="YeniSifreTekrar" Placeholder="Yeni şifre tekrar" Type="Password" Style="width:100%;" />
        </RadzenFormField>
        <RadzenButton Text="Şifreyi Kaydet" ButtonStyle="ButtonStyle.Primary" Type="Submit" Class="mt-3 w-100" />
    </EditForm>

   @*  @if (!string.IsNullOrEmpty(bilgiMesaji))
    {
        <RadzenAlert Severity="Info" Summary="Bilgi" Detail="@bilgiMesaji" Class="mt-3" />
    } *@
</RadzenCard>

@code {
    private SifreSifirlaModel model = new();
    private string bilgiMesaji;

    private async Task OnSubmit()
    {
        // TODO: token doğrulama yap
        bool basarili = await _kullaniciRepo.SifreGuncelle(token, model.YeniSifre);

        if (basarili)
        {
            notificationService.Notify(NotificationSeverity.Success,"Başarılı","Şifreniz Başarıyla Değiştirildi.");
             await Task.Delay(1000);
             NavigationManager.NavigateTo("/GirisYap");
         }
         else
         {
            notificationService.Notify(NotificationSeverity.Error, "Başarısız", "Token geçersiz veya şifre değiştirilemedi.");
         }
    }

    public class SifreSifirlaModel
    {
        public string YeniSifre { get; set; }
        public string YeniSifreTekrar { get; set; }
    }
}

