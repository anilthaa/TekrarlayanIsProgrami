
@if (isLoading || kullanicilar == null)
{
	<RadzenCard class="text-center mt-5">
		<RadzenProgressBar Value="100" ShowValue="false" Indeterminate="true" Style="width:220px;" />
		<p class="mt-2">Kullanıcı bilgileri yükleniyor...</p>
	</RadzenCard>
}
else
{
	@if (kullanicilar.ID != 0)
	{
		<RadzenCard Style="max-width:600px; margin:auto; padding:20px;">
			<h3 class="text-center mb-4">Kullanıcı Düzenle</h3>
			<RadzenTemplateForm Data="@kullanicilar" TItem="User" Submit="@Kaydet" Style="align-items:center; border:none;">

				<RadzenFormField Text="Ad" Style="width:85%; margin-left:41px; margin-top:4px;">
					<RadzenTextBox class="form-control" @bind-Value="kullanicilar.Adi" />
				</RadzenFormField>

				<RadzenFormField Text="Soyad" Style="width:85%; margin-left:41px; margin-top:4px;">
					<RadzenTextBox class="form-control" @bind-Value="kullanicilar.Soyadi" />
				</RadzenFormField>

				<RadzenFormField Text="E-posta" Style="width:85%; margin-left:41px; margin-top:4px;">
					<RadzenTextBox class="form-control" @bind-Value="kullanicilar.EPosta" />
				</RadzenFormField>

				<RadzenFormField Text="Kullanıcı Tipi" Style="width:85%; margin-left:41px; margin-top:4px;">
					<RadzenDropDown Data="@kullaniciTipleri" TextProperty="Adi" ValueProperty="ID" Style="width:100%;"
					@bind-Value="kullanicilar.KullaniciTip_ID" />
				</RadzenFormField>

				<div class="btn-group">
					<RadzenButton Text="Kaydet" Icon="save" ButtonType="ButtonType.Submit"
								  Style="width:30%; margin:auto;" class="radzen-buttonKaydet" Disabled="@isSaving" />
					<RadzenButton Text="İptal" Icon="cancel" Click="@Iptal"
								  Style="width:30%; margin:auto;" class="radzen-buttonIptal" ButtonType="ButtonType.Button" Disabled="@isSaving" />
				</div>
			</RadzenTemplateForm>
		</RadzenCard>
	}
	else
	{
		<RadzenCard class="max-width:600px; margin:auto; padding:20px;">

			<h3 class="card-title text-center mb-4">Kullanıcı Ekle</h3>
			<RadzenTemplateForm Data="@newUser" TItem="User" Submit="@OnSubmit">
				<RadzenFieldset Text="Bilgiler" Style="margin-bottom:15px;">
					<DataAnnotationsValidator />
					<RadzenFormField Text="Ad" Style="width:85%; margin-left:41px; margin-top:4px;">
						<RadzenTextBox class="form-control" @bind-Value="newUser.Adi" />
					</RadzenFormField>
					<ValidationMessage For="@(() => newUser.Adi)"></ValidationMessage>

					<RadzenFormField Text="Soyad" Style="width:85%; margin-left:41px; margin-top:4px;">
						<RadzenTextBox class="form-control" @bind-Value="newUser.Soyadi" />
					</RadzenFormField>
					<ValidationMessage For="@(() => newUser.Soyadi)"></ValidationMessage>

					<RadzenFormField Text="E-posta" Style="width:85%; margin-left:41px; margin-top:4px;">
						<RadzenTextBox class="form-control" @bind-Value="newUser.EPosta" />
					</RadzenFormField>
					<ValidationMessage For="@(() => newUser.EPosta)"></ValidationMessage>

					<RadzenFormField Text="Tip Seçin" Style="width:85%; margin-left:41px; margin-top:4px;">
						<RadzenDropDown @bind-Value="secilenTipId"
										TValue="int"
										Data="@kullaniciTipleri"
										TextProperty="Adi"
										ValueProperty="ID"
										Style="width:100%;" />
						<ValidationMessage For="@(() => secilenTipId)" />
					</RadzenFormField>

@* 					<RadzenFormField Text="Şifre" Style="width:85%; margin-left:41px; margin-top:4px;">
						<RadzenTextBox class="form-control" @bind-Value="newUser.Sifre" type="@InputType" />
						<button type="button" @onclick="TogglePassword"
								style="position:absolute; right:18px; top:50%; transform:translateY(-50%); border:none; background:transparent;">
							<RadzenIcon Icon="@Icon" Style="color:gray;"></RadzenIcon>
						</button>
					</RadzenFormField>
					<ValidationMessage For="@(() => newUser.Sifre)"></ValidationMessage>

					<RadzenFormField Text="Şifre Tekrar" Style="width:85%; margin-left:41px; margin-top:4px;">
						<RadzenTextBox @bind-Value="newUser.SifreTekrar" type="@InputType2" />
						<button type="button" @onclick="@TogglePasswordAgain"
								style="position:absolute; right:1px; top:8px; transform:translate(-50%); border:none; background:transparent;">
							<RadzenIcon Icon="@Icon2" Style="color:gray;"></RadzenIcon>
						</button>
					</RadzenFormField>
					<ValidationMessage For="@(() => newUser.SifreTekrar)"></ValidationMessage>
 *@
					<div class="btn-group">
						<RadzenButton Text="Kaydet" Icon="save" ButtonType="ButtonType.Submit" Style="width:30%; margin:auto;" class="radzen-buttonKaydet"></RadzenButton>
						<RadzenButton Text="İptal" Icon="cancel" ButtonType="ButtonType.Button" Click="@Iptal" Style="width:30%; margin:auto;" class="radzen-buttonIptal"></RadzenButton>
					</div>
				</RadzenFieldset>
			</RadzenTemplateForm>

		</RadzenCard>


	}
}
@code {
	[Parameter]
	public int id { get; set; }
	private User kullanicilar = new();
	private User originalKullanici;
	private List<User> kullaniciListe = new List<User>();
	[Parameter]
	public int KullaniciId{ get; set; }
	private List<ItemKullaniciTip> kullaniciTipleri = new();
	private bool isLoading = true;
	private bool isSaving;

	protected override async Task OnInitializedAsync()
	{
		try
		{
			kullaniciTipleri = (await DataService.GetKullaniciTipleri()).Where(t => t.Aktif).ToList();

			if (KullaniciId != 0)
			{
				kullanicilar = await _kullaniciRepo.GetByIDAsync(KullaniciId) ?? new User();
			}

			if (kullanicilar.KullaniciTip_ID == 0 && kullaniciTipleri.Any())
			{
				kullanicilar.KullaniciTip_ID = kullaniciTipleri.First().ID;
			}

			var uri = NavigationManager.ToAbsoluteUri(NavigationManager.Uri);
			if (QueryHelpers.ParseQuery(uri.Query).TryGetValue("geri", out var geri))
			{
				geriUrl = geri;
			}

			originalKullanici = kullanicilar.Clone();
		}
		finally
		{
			isLoading = false;
		}
	}

	private async Task Kaydet()
	{
		Console.WriteLine("Kaydet metodu çağrıldı.");
		if (isSaving)
		{
			return;
		}
		if (kullanicilar == null || kullanicilar.ID == 0)
		{
			notificationService.Notify(NotificationSeverity.Error, "Hata", "Geçersiz kullanıcı bilgisi.");
			return;
		}

		isSaving = true;
		var currentUser = await girisSaglayici.GetCurrentUserAsync();
		kullanicilar.UpdUser = currentUser?.ID ?? 0;

		// Şifreyi null yap ki UpdateAsync mevcut şifreyi korusun
		kullanicilar.Sifre = null;

		bool sonuc = await _kullaniciRepo.UpdateAsync(kullanicilar);
		isSaving = false;
		if (sonuc)
		{
			notificationService.Notify(NotificationSeverity.Success, "Başarılı", "Düzenleme işleminiz başarıyla tamamlandı.");
			DialogService.Close(kullanicilar);
		}
		else
		{
			notificationService.Notify(NotificationSeverity.Error, "Hata", "Düzenleme işleminiz başarısız!");
		}
	}

	private async Task Iptal()
	{
		if (kullanicilar.ID == 0)
		{
			notificationService.Notify(NotificationSeverity.Info,"Bilgi","Ekleme İşleminiz İptal Edildi");
			DialogService.Close(null);
			return;
		}
		if (HasChanges(kullanicilar, originalKullanici))
		{
			var confirmed = await DialogService.Confirm("Formda yaptığınız değişiklikler kaybolacak. Çıkmak istediğinize emin misiniz?", "İptal Onayı",
						new ConfirmOptions() { OkButtonText = "Evet", CancelButtonText = "Hayır" });
			if(!confirmed==true)
			{
				return;
			}
			else
			{
				notificationService.Notify(NotificationSeverity.Info, "Bilgi", "Düzenleme İşleminiz İptal Edildi.");
				DialogService.Close(null);
			}
		}
		else
		{
			notificationService.Notify(NotificationSeverity.Info, "Bilgi", "Düzenleme İşleminiz İptal Edildi.");
			DialogService.Close(null);
		}

	}
	private string geriUrl = "/kullanicilar";

	private bool HasChanges(User current, User original)
	{
		return current.Adi != original.Adi
			|| current.Soyadi != original.Soyadi
			|| current.EPosta != original.EPosta
			|| current.KullaniciTip_ID != original.KullaniciTip_ID;
	}
	//Ekleme Alanı Kodları.
	private int secilenTipId = 0;
	private User newUser = new User
	{
		CreDate = DateTime.Now,
		Aktif = true
	};


	private async Task OnSubmit()
	{
		if (!EpostaGecerliMi(newUser.EPosta))
		{
			notificationService.Notify(NotificationSeverity.Error, "Hata", "E-posta Yalnızca gmail.com veya hotmail.com Olmalıdır.");
			return;
		}

		var currentUser = await girisSaglayici.GetCurrentUserAsync();

		newUser.CreUser = currentUser.ID;
		if (newUser.CreUser == 0)
		{
			newUser.CreUser = 0;
		}
		newUser.KullaniciTip_ID = secilenTipId;

		newUser.Sifre = "00000000";
		newUser.SifreTekrar = "00000000";


		var result = await girisSaglayici.KayitOlAsync(newUser, newUser.KullaniciTip_ID);

		if (result.Basarili)
		{
			notificationService.Notify(NotificationSeverity.Success, "Başarılı", "Kayıt Başarıyla Tamamlandı.");
			await ListeyiYenileAsync(); 
			StateHasChanged();
		}
		else
		{
			notificationService.Notify(NotificationSeverity.Error, "Hata", "Kayıt Sırasında Bir Hata Oluştu.");
		}

		DialogService.Close(true);
	}
	private bool EpostaGecerliMi(string eposta)
	{
		if (string.IsNullOrWhiteSpace(eposta))
			return false;

		var desen = @"^[\w\.-]+@(gmail\.com|hotmail\.com)$";
		return Regex.IsMatch(eposta, desen, RegexOptions.IgnoreCase);
	}
	private async Task ListeyiYenileAsync()
	{
		kullaniciListe = await _kullaniciRepo.GetAllAsync();
	}
}