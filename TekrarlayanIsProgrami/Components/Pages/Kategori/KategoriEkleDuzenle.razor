<RadzenCard Style="padding:20px;">
	<RadzenTemplateForm TItem="ItemKategori" Data="@Kategori" Submit="@OnSubmit">
		<ChildContent>
			<RadzenLabel Text="Kategori Adı" Component="Adi"></RadzenLabel>
			<RadzenTextBox @bind-Value="Kategori.Adi" Name="Adi" Style="width:100%; margin-bottom:15px;"></RadzenTextBox>

			<div style="text-align:right;">
				<RadzenButton Text="Kaydet" ButtonType="ButtonType.Submit" Style="margin-right:10px; background:#27ae60; color:white"></RadzenButton>
				<RadzenButton Text="İptal" Click="Iptal" Style="background:#e74c3c; color:white"></RadzenButton>
			</div>
		</ChildContent>
	</RadzenTemplateForm>
</RadzenCard>

@code {
	[Parameter] public ItemKategori Kategori { get; set; }

	private async Task OnSubmit()
	{
		if (Kategori.ID==0)
		{
			await KategoriRepo.AddAsync(Kategori);
			notificationService.Notify(NotificationSeverity.Success, "Başarılı", "Kategori Eklendi!");
		}
		else
		{
			await KategoriRepo.UpdateAsync(Kategori);
			notificationService.Notify(NotificationSeverity.Success, "Başarılı", "Kategori Güncellendi");
		}

		 DialogService.Close(true);
	}

	private async Task Iptal()
	{
		DialogService.Close(false);
	}
}
