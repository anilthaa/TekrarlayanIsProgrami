@page "/kullanicilar/edit/{id:int}"

<html>
<head>
    <link href="css/site.css" rel="stylesheet" />
</head>
<body>
@if (kullanici == null)
{
    <div class="text-center mt-5">
        <div class="spinner-border text-primary" role="status">
            <span class="visually-hidden">Yükleniyor...</span>
        </div>
        <p class="mt-2">Kullanıcı bilgileri yükleniyor...</p>
    </div>
}
else
{
    <div class="container mt-5">
        <div class="row justify-content-center">
            <div class="col-md-6">
                <div class="card shadow" style="background-color: #f0f0f0; border: 1px solid #ccc;">
                    <div class="card-body">
                        <h3 class="card-title text-center mb-4">Kullanıcı Düzenle</h3>

                        <EditForm Model="@kullanici" OnValidSubmit="@Kaydet">
                            <DataAnnotationsValidator />
                            <ValidationSummary />
                            <div class="mb-3">
                                <RadzenLabel class="form-label">Adı</RadzenLabel>
                                    <RadzenTextBox class="form-control" @bind-Value="kullanici.Adi" placeholder="Adı girin" />
                            </div>
                            <div class="mb-3">
                                <RadzenLabel  class="form-label">Soyadı</RadzenLabel>
                                <RadzenTextBox class="form-control" @bind-Value="kullanici.Soyadi" placeholder="Soyadı girin" />
                            </div>

                            <div class="mb-3">
                                <RadzenLabel class="form-label">E-Posta</RadzenLabel>
                                <RadzenTextBox class="form-control" @bind-Value="kullanici.EPosta" placeholder="E-Posta girin" />
                            </div>

                            <div class="mb-3">
                                <RadzenLabel class="form-label">Şifre</RadzenLabel>
                                <RadzenTextBox type="password" class="form-control" @bind-Value="kullanici.Sifre" placeholder="Şifreyi girin" />
                            </div>

                            <div class="d-flex justify-content-between mt-4">
                                    <RadzenButton Text="Kaydet"  ButtonStyle="ButtonStyle.Success" Click="@Kaydet"></RadzenButton>
                                    <RadzenButton Text="İptal"  ButtonStyle="ButtonStyle.Danger" Click="@Iptal"></RadzenButton>
                            </div>
                        </EditForm>
                    </div>
                </div>
            </div>
        </div>
    </div>
}
</body></html>
@code {
    [Parameter] 
    public int id { get; set; }

    // 1️⃣ Her zaman null olmayan bir nesne oluştur
    private User kullanici = new User();

    protected override async Task OnInitializedAsync()
    {
        // kullanici = await _repo.GetByIDAsync(id);
        var uri = NavigationManager.ToAbsoluteUri(NavigationManager.Uri);
        if (QueryHelpers.ParseQuery(uri.Query).TryGetValue("geri", out var geri))
        {
            geriUrl = geri;
        }
    }
    private LoginModel loginModel = new LoginModel();

    async Task OnLogin(LoginModel model)
    {

         var result = await girisSaglayici.UpdateAsync(model.E_Posta, model.Sifre);

         if (result.Basarili) //Eğer sonuç başarılı ise.
         {
            bildirimServisi.Notify(NotificationSeverity.Success, "Hoşgeldiniz", result.Mesaj);
             NavigationManager.NavigateTo("/kullanicilar");
         }
         else
         {
             bildirimServisi.Notify(NotificationSeverity.Error, "Giriş Hatası", result.Mesaj);
         }
    }

    private async Task Kaydet()
    {
        kullanici.UpdUser = kullanici.ID;
        kullanici.UpdDate = DateTime.Now;
        await _kullaniciRepo.UpdateAsync(kullanici);
        //  Kayıt tamamlandıktan sonra kullanıcılar sayfasına dön
        NavigationManager.NavigateTo(geriUrl);
    }

    private void Iptal()
    {
        NavigationManager.NavigateTo(geriUrl);
    }
    private string geriUrl = "/kullanicilar";

    
}