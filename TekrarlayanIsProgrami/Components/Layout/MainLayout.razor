@inherits LayoutComponentBase
<RadzenComponents @rendermode="InteractiveServer"></RadzenComponents>

 <HeadContent>
  <link href="css/site.css" rel="stylesheet" />
  <link rel="stylesheet" href="/js/site.js"/>
</HeadContent>
<RadzenDialog></RadzenDialog>
<RadzenNotification></RadzenNotification>
<RadzenLayout>
    @{
        var uri = NavigationManager.Uri.ToLower();
    }
    @if (!uri.Contains("/girisyap"))
    {
        <RadzenSidebar>
            @if (uri.Contains("/dashboard") || uri.Contains("/kategori") || uri.Contains("/kullanicilar") || uri.Contains("/gorevler") || uri.Contains("/admin/kullanicitipleri") || uri.Contains("/Admin/AdminDashboard"))
            {
                <RadzenCard class="dashboard-nav">
                    <h3>📊 Dashboard</h3>
                    <NavLink href="/kullanicilar" class="nav-link">Kullanıcılar</NavLink>
                    <NavLink href="/kategori" class="nav-link">Kategoriler</NavLink>
                    <NavLink href="/Gorevler" class="nav-link">Görev Listesi</NavLink>
                    <NavLink href="/Admin/AdminDashboard" class="nav-link">Admin Dashboard</NavLink>
                    <RadzenButton Text="Çıkış" Click="@CikisYap" style="width:100%" class="radzen-button" />
                </RadzenCard>
            }
        </RadzenSidebar>
    }

    <RadzenBody>
        @Body
    </RadzenBody>
</RadzenLayout>
@code {
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            // await ((CustomAuthenticationStateProvider)girisSaglayici).LoadUserFromLocalStorageAsync();
            var userJson = await Js.InvokeAsync<string>("localStorage.getItem", "_currentUser");
            var token = await Js.InvokeAsync<string>("localStorage.getItem", "jwtToken");

            if (!string.IsNullOrEmpty(userJson) && !string.IsNullOrEmpty(token))
            {
                await ((CustomAuthenticationStateProvider)girisSaglayici).LoadUserFromLocalStorageAsync();
            }
            else
            {
                await Js.InvokeVoidAsync("localStorage.removeItem", "_currentUser");
                await Js.InvokeVoidAsync("localStorage.removeItem", "jwtToken");
            }
        }
    }
    private async void CikisYap()
    {
        var relative = NavigationManager.ToBaseRelativePath(NavigationManager.Uri);
        var target = string.IsNullOrEmpty(relative) ? "/" : "/" + relative;
        var encoded = Uri.EscapeDataString(target);
        await ((CustomAuthenticationStateProvider)girisSaglayici).MarkUserAsLoggedOut();
        NavigationManager.NavigateTo($"/GirisYap?returnUrl={encoded}", true);
    }
}