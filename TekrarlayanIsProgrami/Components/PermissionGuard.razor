@implements IDisposable
@code {
    private bool _initialized;
    private bool _isRedirecting;

    //uygulamadaki herkese açýk rotalarý tanýmlar.
    private readonly HashSet<string> _publicRoutes = new(StringComparer.OrdinalIgnoreCase)
    {
        "",
        "/",
        "girisyap",
        "kayitol",
        "sifremiunuttum",
        "sifresifirla",
        "dashboard",
        "gorevler" 
    };

    //sayfa baþlatýldýðýnda URL deðiþikliklerini dinlemeye baþlar.
    protected override void OnInitialized()
    {
        NavigationManager.LocationChanged += HandleLocationChanged;
    }

    //sayfa ilk kez render edildikten sonra çalýþýr.
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            _initialized = true;
            await ValidateAsync(NavigationManager.Uri);
        }
    }

    //sayfa URL si deðiþtiðinde tetiklenen event handlerdýr.
    private async void HandleLocationChanged(object? sender, LocationChangedEventArgs args)
    {
        if (!_initialized)
        {
            return;
        }

        await ValidateAsync(args.Location);
    }

    //URL yi doðrulayýp yetki kontrolü yapar.
    private async Task ValidateAsync(string absoluteUri)
    {
        var relativeRoute = NormalizeRoute(absoluteUri);

        if (IsPublicRoute(relativeRoute))
        {
            return;
        }

        var authState = await girisSaglayici.GetAuthenticationStateAsync();

        if (authState.User?.Identity?.IsAuthenticated != true)
        {
            return;
        }

        var normalizedRoute = relativeRoute.Trim().TrimStart('/').ToLowerInvariant();
        if (normalizedRoute == "gorevler")
        {
            return; 
        }

        var routeForPermissionCheck = RemoveRouteParameters(relativeRoute);
        var hasAccess = await PermissionService.CanReadAsync(routeForPermissionCheck);
    }

    //mutlak URL yi normalize edilmiþ bir göreli route a dönüþtürür.
    private string NormalizeRoute(string absoluteUri)
    {
        var relative = NavigationManager.ToBaseRelativePath(absoluteUri);

        if (string.IsNullOrWhiteSpace(relative))
        {
            return "/";
        }

        var queryIndex = relative.IndexOf('?');
        if (queryIndex >= 0)
        {
            relative = relative[..queryIndex];
        }

        if (!relative.StartsWith("/"))
        {
            relative = "/" + relative;
        }

        return relative;
    }

    //bir rotanýn herkese açýk olup olmadýðýný kontrol eder.
    private bool IsPublicRoute(string route)
    {
        if (string.IsNullOrWhiteSpace(route) || route == "/")
        {
            return true;
        }

        var normalized = route.Trim().TrimStart('/').ToLowerInvariant();
        return _publicRoutes.Contains(normalized);
    }

    //bir rotadan son segmentteki sayýsal parametreyi kaldýrýr.
    private string RemoveRouteParameters(string route)
    {
        if (string.IsNullOrWhiteSpace(route))
        {
            return route;
        }

        var parts = route.Split('/', StringSplitOptions.RemoveEmptyEntries);
        if (parts.Length == 0)
        {
            return route;
        }

        if (parts.Length > 1 && int.TryParse(parts[^1], out _))
        {
            var routeWithoutParam = "/" + string.Join("/", parts.Take(parts.Length - 1));
            return routeWithoutParam;
        }

        return route;
    }

    //temizlik (cleanup) iþlemi yapar.
    public void Dispose()
    {
        NavigationManager.LocationChanged -= HandleLocationChanged;
    }
}

