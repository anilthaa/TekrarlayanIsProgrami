@page "/GirisYap"
@page "/"   
@layout MainLayout
@inject CustomAuthenticationStateProvider AuthProvider
@inject NavigationManager Navigation
@inject NotificationService NotificationService


<html>
<head>
    <link href="css/site.css" rel="stylesheet" />
</head>
<body>
	@* class="bodyAnasayfa" *@
	<div class="login-container @(isRegisterActive ? "slide-active" : "")">

    <!-- Giriş Formu -->
    <RadzenCard class="form login-form">
       <EditForm Model="@loginModel" OnValidSubmit="()=>OnLogin(loginModel)">
				<h3>🔐Giriş Yap</h3>
            <p>Lütfen bilgilerinizi girin</p>

				<RadzenTextBox @bind-Value="loginModel.E_Posta" Style="width:100%;" Placeholder="E-posta                                                                                                         ✉" />
				<RadzenPassword @bind-Value="loginModel.Sifre" Style="width:100%; margin-top:9px;" Placeholder="Şifre                                                                                                             🔑" />
			<RadzenLink Text="🔁 Şifrenizi unuttunuz mu?" Path="/sifremi-unuttum" Style="text-decoration:none; color:rebeccapurple; cursor:pointer; "></RadzenLink>

            <RadzenButton Click="()=>OnLogin(loginModel)" Style="width:100%; margin-top:20px;" Text="Giriş Yap" class=" radzen-button" Icon="login"></RadzenButton>
        </EditForm></RadzenCard>
		<!-- Kayıt Formu -->
    <RadzenCard class="form register-form">
        <EditForm Model="@newUser" OnValidSubmit="OnSubmit">
            <h3>Hesap Oluştur</h3>
            <p>Lütfen bilgilerinizi girin</p>
			<RadzenLabel Text="Ad" class="radzen-labell"></RadzenLabel>
				<RadzenTextBox @bind-Value="newUser.Adi" style="width:100%" Placeholder="Adınız" /><br />
				<RadzenLabel Text="Soyad" class="radzen-labell"></RadzenLabel><br />
				<RadzenTextBox @bind-Value="newUser.Soyadi" style="width:100%" Placeholder="Soyadınız" /><br />
				<RadzenLabel Text="E-posta" class="radzen-labell"></RadzenLabel>
				<RadzenTextBox @bind-Value="newUser.EPosta" style="width:100%" Placeholder="E-posta"   /><br />
				<RadzenLabel Text="Sifre" class="radzen-labell"></RadzenLabel>
				<RadzenTextBox @bind-Value="newUser.Sifre" style="width:100%" Placeholder="Şifre" Type="password"></RadzenTextBox><br />
				<RadzenLabel Text="Tekrar Şifre" class="radzen-labell"></RadzenLabel>
				<RadzenTextBox style="width:100%" Placeholder="Tekrar Şifre" Type="password"></RadzenTextBox><br />
				<RadzenButton Click="@OnSubmit" Style="width:100%; margin-top:20px;" class="radzen-button" Text="Kayıt Ol" ButtonStyle="ButtonStyle.Info"></RadzenButton>
               </EditForm>
            </RadzenCard>
			<!-- Slider Panel -->
			<div class="slider-panel">
				<div class="slider-content">
					@if (!isRegisterActive)
					{
						<h2>Merhabalar!</h2>
						<p>Tüm site özelliklerini kullanmak için kişisel bilgilerinizle kayıt olun.</p>
						<RadzenButton Click="@(() => isRegisterActive = true)" Text="KAYIT OL" Style="background-color: white; color: #2196f3; margin-top:10px;" />
					}
					else
					{
						<h2>Tekrar Hoş Geldiniz!</h2>
						<p>Zaten hesabınız var mı? Giriş yapın.</p>
						<RadzenButton Click="@(() => isRegisterActive = false)" Text="GİRİŞ YAP" Style="background-color: white; color: #2196f3; margin-top:10px;" />
					}

				</div>
			</div>
</div>
</body> 
</html>
@code {
	bool isRegisterActive = false;
	private LoginModel loginModel = new LoginModel();

	async Task OnLogin(LoginModel model)
	{
		var result = await AuthProvider.GirisYapAsync(model.E_Posta, model.Sifre);

		if (result.Basarili) //Eğer sonuç başarılı ise.
		{
			NotificationService.Notify(NotificationSeverity.Success, "Hoşgeldiniz", result.Mesaj);
			Navigation.NavigateTo("/Dashboard");
		}
		else
		{
			NotificationService.Notify(NotificationSeverity.Error, "Giriş Hatası", result.Mesaj);
		}
	}

	public class LoginModel
	{
		public string E_Posta { get; set; }
		public string Sifre { get; set; }
	}

	private User newUser = new User
	{
		CreUser = 1,
		CreDate = DateTime.Now,
		Aktif = true
	};

	private async Task OnSubmit()
	{
		//Şifre Tekrar ile Şifre farklıysa.
		if (newUser.Sifre != newUser.SifreTekrar)
		{
			NotificationService.Notify(NotificationSeverity.Error, "Hata", "Şifre ile Tekrar Şifre Aynı Değil..");
			/* return;  */ // işlemi durdurur
		}
		var result = await AuthProvider.KayitOlAsync(newUser);
		// 4️⃣ Bildirim ve yönlendirme
		if (result.Basarili)
		{
			NotificationService.Notify(NotificationSeverity.Success, "Başarılı", result.Mesaj);
			Navigation.NavigateTo("/GirisYap");
		}
		else
		{
			NotificationService.Notify(NotificationSeverity.Error, "Hata", result.Mesaj);
		}
	}
}
