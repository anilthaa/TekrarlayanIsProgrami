@page "/sifremi-unuttum"

<h3>Şifremi Unuttum</h3>

<RadzenTextBox @bind-Value="E_posta" Placeholder="E-posta adresiniz" Style="width:300px;" />
<RadzenButton Text="Sıfırlama Bağlantısı Gönder" Click="@SendResetLink" Style="margin-top:10px;" />

@code {
    string E_posta = "";

    async Task SendResetLink()
    {
        if (string.IsNullOrWhiteSpace(E_posta))
        {
            await Js.InvokeVoidAsync("alert", "Lütfen e-posta adresinizi girin.");
            return;
        }

        var kullanici = await _kullaniciRepo.GetByEmailAsync(E_posta);
        if (kullanici == null)
        {
            await Js.InvokeVoidAsync("alert", "Bu e-posta adresiyle kayıtlı kullanıcı bulunamadı.");
            return;
        }

        // 1. Token üret
        var token = Guid.NewGuid().ToString();

        // 2. Token’ı veritabanına kaydet (örneğin Kullanici tablosuna veya ayrı bir tabloya)
        await _kullaniciRepo.SaveResetTokenAsync(kullanici.ID, token);

        // 3. Sıfırlama bağlantısını oluştur
        var resetUrl = $"{NavigationManager.BaseUri}sifre-sifirla/{token}";

        // 4. E-posta gönderimi (burada test amaçlı sadece konsola yazıyoruz)
        Console.WriteLine($"Sıfırlama bağlantısı: {resetUrl}");

        await Js.InvokeVoidAsync("alert", "E-posta adresinize sıfırlama bağlantısı gönderildi.");
    }
}
    }
}
